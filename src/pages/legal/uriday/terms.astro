---
import Layout from '../../../layouts/Layout.astro';
import UridayInfoPage from '../../../components/UridayInfoPage.astro';

const sections = [
  { title: '서비스와 이용 자격', body: '우리데이는 연결된 두 사람이 일정과 일기를 함께 관리하는 서비스입니다. 만 14세 이상만 가입할 수 있으며, 가입할 때 본인이 약관과 개인정보 처리방침을 확인해야 합니다. 미성년자가 유료 구독을 구매할 때에는 법정대리인의 동의를 받아야 하며 App Store 또는 Google Play의 가족 결제 승인 절차가 적용될 수 있습니다. 계정 정보는 사실대로 입력해야 합니다.' },
  { title: '커플 연결과 권한', body: '숫자 6자리 연결 코드는 10분 동안 한 번만 사용할 수 있습니다. 연결된 두 사람은 공유 일정의 작성·수정·삭제 권한을 함께 가집니다. 일기는 작성자가 명시적으로 공유한 뒤에만 상대에게 보이고, 삭제는 작성자만 요청할 수 있습니다. 연결을 해제하면 두 사람 모두 공유 공간을 볼 수 없고 7일 안에 두 사람 모두 동의한 경우에만 복구됩니다.' },
  { title: '콘텐츠에 대한 책임', body: '사용자는 본인에게 권리가 있는 글·사진·음성·그림만 올려야 하며, 타인의 개인정보·저작권·초상권을 침해하거나 불법·위협·성적 착취 콘텐츠를 올려서는 안 됩니다. 동방의 소음은 신고, 법적 의무, 보안 사고 대응에 필요한 범위에서 콘텐츠 접근을 제한하거나 삭제할 수 있습니다.' },
  { title: '구독과 결제', body: '우리데이 Plus는 월간 또는 연간 자동 갱신 구독이며 연간 요금제를 강조해 안내합니다. 체험 대상 사용자에게는 3일 무료 체험을 제공합니다. 무료 체험이 끝나기 전에 취소하지 않으면 선택한 주기로 자동 결제됩니다. 판매 플랫폼에 따라 가격 구간이 다를 수 있으며, 실제 청구 금액, 세금, 결제 주기, 체험 자격, 갱신일은 구매 직전 App Store 또는 Google Play 확인 화면이 기준입니다. 한 명의 유효한 구독은 연결된 두 사람에게 이용 권한을 제공합니다. 구매 복원과 구독 관리는 결제한 스토어 계정에서 진행하며, 계정 삭제나 연결 해제만으로 자동 갱신이 취소되지는 않습니다.' },
  { title: '오프라인 변경과 충돌', body: '네트워크가 없을 때 초안과 일부 변경은 기기에 대기 상태로 저장됩니다. 앱은 pending·synced·failed를 구분해 표시합니다. 같은 일정을 두 사람이 동시에 바꿨다면 먼저 서버에 확정된 최신 버전을 보여주고 덮어쓰지 않을 수 있습니다. 통신 재시도나 외부 서비스 지연 때문에 반영이 늦어질 수 있습니다.' },
  { title: '계정 삭제', body: '계정 삭제를 요청하면 7일의 취소 기간이 시작됩니다. 그동안 새 일정과 일기를 공유할 수 없으며, 기간 안에는 앱에서 요청을 취소할 수 있습니다. 유예가 끝나 삭제가 시작되면 로그인 계정, 프로필, 기기 토큰, 개인 데이터와 본인이 작성한 공유 일기·첨부파일을 삭제합니다. 상대가 작성한 자료는 상대 계정에 남을 수 있습니다. 계정 삭제는 스토어 구독 해지가 아니므로 구독 관리에서 자동 갱신도 확인해야 합니다.' },
  { title: '서비스 변경과 책임 범위', body: '동방의 소음은 안정적인 서비스를 위해 노력하지만 기기, 네트워크, 운영체제, App Store·Google Play·Firebase·로그인 제공자 등 통제하기 어려운 사유로 일부 기능이 지연되거나 제한될 수 있습니다. 중요한 서비스 중단이나 이용 조건 변경은 가능한 범위에서 미리 안내하고 복구 경로를 제공합니다.' },
  { title: '약관 변경과 문의', body: '이용자 권리나 의무에 중요한 변경은 적용 전에 앱 또는 웹에서 알립니다. 본 약관은 2026년 9월 28일부터 시행합니다. 운영자는 동방의 소음, 대표자는 조수근이며 문의는 josoogen26@gmail.com으로 접수합니다.' },
];
---

<Layout locale="ko" chrome="none" title="우리데이 이용약관 — 동방의 소음" description="우리데이 커플 연결, 콘텐츠, 구독과 계정 삭제 이용 조건입니다." path="/legal/uriday/terms" themeColor="#fbfaf7">
  <UridayInfoPage page="terms" title="함께 쓰는 공간의 약속." lead="연결, 공유, 결제와 삭제가 실제로 어떻게 동작하는지 결과를 예측할 수 있게 설명합니다." sections={sections} />
</Layout>
