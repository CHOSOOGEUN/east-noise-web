---
import Layout from '../../../layouts/Layout.astro';
import UridayInfoPage from '../../../components/UridayInfoPage.astro';

const sections = [
  { title: '왜 보호자 동의가 필요한가요', body: '우리데이는 만 14세 미만 이용자의 이름, 기념일, 일정과 일기 같은 개인정보를 처리합니다. 개인정보 보호법에 따라 이 정보를 처리하기 전에 법정대리인의 동의를 받고 실제 동의 여부를 확인합니다. 확인 전에는 프로필 저장, 커플 연결, 일정·일기 업로드를 막습니다.' },
  { title: '앱에서 동의 요청을 시작해요', body: '이용자가 프로필에서 “만 14세 미만”을 선택한 뒤 “보호자 동의 요청 이메일 작성”을 누릅니다. 메일에는 계정을 찾기 위한 우리데이 계정 확인 ID가 자동으로 들어갑니다. 보호자는 성명, 이용자와의 관계, 회신받을 이메일만 적어 보내 주세요. 비밀번호, 로그인 인증 코드, 카드번호, 주민등록번호, 가족관계증명서, 일기 내용이나 첨부파일은 보내지 마세요.' },
  { title: '보호자가 확인하고 회신해요', body: '동방의 소음은 개인정보 처리방침, 필수 처리 항목·목적·보유 기간, 커플 공유 범위, 국외 처리, 동의 철회와 계정 삭제 방법을 보호자 이메일로 보냅니다. 보호자는 내용을 확인한 뒤 “동의합니다”라는 의사표시와 본인이 법정대리인이라는 확인을 같은 이메일 대화로 회신합니다. 추가 확인이 필요할 때에도 최소 정보만 요청합니다.' },
  { title: '확인 뒤 앱을 다시 열어요', body: '운영자가 회신을 확인하면 계정에 보호자 동의 상태를 적용하고 결과를 이메일로 알립니다. 이용자는 우리데이에서 로그아웃한 뒤 같은 로그인 수단으로 다시 로그인해야 새 동의 상태가 반영됩니다. 그 뒤 프로필 저장과 커플 연결을 계속할 수 있습니다.' },
  { title: '무엇을 얼마나 보관하나요', body: '보호자 성명, 이용자와의 관계, 이메일, 동의 여부·시각과 비식별 증빙 번호를 동의 확인과 분쟁 대응에 사용합니다. 확인되지 않은 요청 정보는 7일 안에 삭제합니다. 확인된 동의 증빙은 계정이 유지되는 동안 접근 제한된 운영 계정과 서버에 보관하며, 동의 철회 또는 계정 삭제가 완료되면 삭제합니다.' },
  { title: '철회·열람·삭제를 요청할 수 있어요', body: '법정대리인은 언제든 동의를 철회하거나 아동과 보호자 정보의 열람·정정·삭제를 요청할 수 있습니다. josoogen26@gmail.com으로 제목을 “우리데이 보호자 동의 철회”라고 적어 보내 주세요. 철회가 확인되면 공유 기능을 중단하고 계정 삭제 또는 처리정지 절차를 안내합니다.' },
];
---

<Layout locale="ko" chrome="none" title="우리데이 법정대리인 동의 안내 — 동방의 소음" description="만 14세 미만 우리데이 이용자의 법정대리인 동의 요청과 철회 절차입니다." path="/legal/uriday/guardian-consent" themeColor="#fbfaf7">
  <UridayInfoPage page="guardian" title="보호자가 확인하고 동의해 주세요." lead="앱에서 요청 이메일을 열고, 안내를 받은 보호자가 직접 회신하면 확인 전까지 아동의 공유 기록을 만들지 않습니다." sections={sections} />
</Layout>
