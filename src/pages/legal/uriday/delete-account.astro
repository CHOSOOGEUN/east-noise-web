---
import Layout from '../../../layouts/Layout.astro';
import UridayInfoPage from '../../../components/UridayInfoPage.astro';

const sections = [
  { title: '앱에서 요청하기', body: '우리데이에서 [커플 > 설정 > 연결·계정 관리 > 계정 삭제 요청하기]를 선택하세요. 최근 로그인 확인 후 요청이 접수되며 즉시 7일의 취소 기간이 시작됩니다. 이 기간에는 새 일정과 일기를 공유할 수 없습니다.' },
  { title: '7일 안에는 취소할 수 있어요', body: '앱의 연결·계정 관리 화면에서 “계정 삭제 취소하기”를 선택하면 같은 계정으로 계속 이용할 수 있습니다. 예정 시각이 지나 서버가 삭제를 시작한 뒤에는 취소하거나 복구할 수 없습니다.' },
  { title: '삭제되는 정보', body: '로그인 계정, 이름·기념일과 개인 프로필, 기기 토큰과 알림·개인정보 설정, 개인 초안 백업, 업로드 대기·보관 파일, 연결 코드, 본인이 작성한 공유 일기와 사진·음성·그림 첨부파일, 구독 서비스의 우리데이 사용자 식별 정보가 삭제 대상입니다. 상대가 작성한 일기와 상대 계정은 삭제하지 않습니다.' },
  { title: '일정과 커플 공간', body: '삭제 요청자의 접근은 차단됩니다. 두 사람이 함께 수정하던 일정과 커플 공간은 남은 사용자의 복구 가능성과 권리를 해치지 않는 범위에서 연결을 해제하거나 정리합니다. 출시 전 최종 데이터 보존 기준과 화면 고지를 서버 동작과 다시 대조합니다.' },
  { title: '앱에 들어갈 수 없다면', body: '계정에 연결된 이메일 주소에서 josoogen26@gmail.com으로 제목을 “우리데이 계정 삭제 요청”이라고 적어 보내 주세요. 본인 확인에 필요한 최소 정보만 요청합니다. 비밀번호, Apple·Google·Kakao 인증 코드, 카드번호, 사적인 일기 원문이나 첨부파일은 보내지 마세요.' },
  { title: '구독은 별도로 해지해요', body: '계정 삭제는 App Store 또는 Google Play의 자동 갱신 구독을 취소하지 않습니다. 삭제 전에 결제한 스토어의 구독 관리에서 우리데이 자동 갱신을 별도로 해지하세요. 법령과 스토어 정책에 따라 결제 거래 기록은 Apple·Google·RevenueCat에 별도 보관될 수 있습니다.' },
];
---

<Layout locale="ko" chrome="none" title="우리데이 계정 및 데이터 삭제 — 동방의 소음" description="우리데이 계정 삭제 요청, 7일 취소 기간과 삭제 범위 안내입니다." path="/legal/uriday/delete-account" themeColor="#fbfaf7">
  <UridayInfoPage page="delete" title="7일 동안 다시 생각할 수 있어요." lead="삭제 요청부터 취소 기한, 실제로 지워지는 기록과 별도 구독 해지까지 순서대로 안내합니다." sections={sections} />
</Layout>
