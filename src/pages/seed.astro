  <script is:inline>
    (() => {
      if (typeof window === 'undefined') return;

      // 1. Reveal on scroll
      const targets = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-in'));
      }

      // 3. Count-up numbers (when visible)
      const counters = document.querySelectorAll('.count-up');
      if ('IntersectionObserver' in window) {
        const cio = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target;
            const target = parseInt(el.getAttribute('data-target') || '0', 10);
            const duration = 1100;
            const start = performance.now();
            const tick = (now) => {
              const p = Math.min((now - start) / duration, 1);
              const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = String(Math.round(target * eased));
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
            cio.unobserve(el);
          });
        }, { threshold: 0.5 });
        counters.forEach((el) => cio.observe(el));
      }

      // 4. Stage strip sequential highlight
      const stageStrip = document.getElementById('stage-strip');
      if (stageStrip && 'IntersectionObserver' in window) {
        const dots = stageStrip.querySelectorAll('.stage-dot');
        const sio = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            dots.forEach((dot, i) => {
              setTimeout(() => {
                dot.setAttribute('data-active', 'true');
                dot.style.backgroundColor = '#22A06B';
                dot.style.color = '#ffffff';
              }, i * 220);
            });
            sio.disconnect();
          });
        }, { threshold: 0.4 });
        sio.observe(stageStrip);
      }

      // 5. Sticky scroll storytelling — stage progression based on scroll
      const story = document.getElementById('story');
      if (story) {
        const stages = story.querySelectorAll('.story-stage');
        const dots = story.querySelectorAll('.story-dot');
        const stageCount = 5;
        const updateStory = () => {
          const rect = story.getBoundingClientRect();
          const totalScroll = story.offsetHeight - window.innerHeight;
          const scrolled = Math.min(Math.max(-rect.top, 0), totalScroll);
          const progress = totalScroll > 0 ? scrolled / totalScroll : 0;
          const activeIdx = Math.min(Math.floor(progress * stageCount), stageCount - 1);
          stages.forEach((el) => {
            const idx = parseInt(el.getAttribute('data-stage') || '0', 10);
            if (idx === activeIdx) {
              el.classList.add('story-active');
              el.classList.remove('story-hidden');
            } else {
              el.classList.remove('story-active');
              el.classList.add('story-hidden');
            }
          });
          dots.forEach((dot, i) => {
            if (i <= activeIdx) {
              dot.style.backgroundColor = '#22A06B';
              dot.classList.remove('bg-neutral-300');
            } else {
              dot.style.backgroundColor = '';
              dot.classList.add('bg-neutral-300');
            }
          });
        };
        let raf = 0;
        const onScroll = () => {
          if (raf) return;
          raf = requestAnimationFrame(() => { raf = 0; updateStory(); });
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        updateStory();
      }

      // 6. Mouse 3D tilt on hero plant
      const tiltEl = document.getElementById('hero-tilt');
      if (tiltEl && window.matchMedia('(pointer: fine)').matches) {
        const parent = tiltEl.parentElement;
        parent.addEventListener('mousemove', (e) => {
          const rect = tiltEl.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          const dx = (e.clientX - cx) / rect.width;
          const dy = (e.clientY - cy) / rect.height;
          const ry = dx * 18;
          const rx = -dy * 18;
          tiltEl.style.transform = `perspective(800px) rotateX(${rx}deg) rotateY(${ry}deg)`;
        });
        parent.addEventListener('mouseleave', () => {
          tiltEl.style.transform = '';
        });
      }

      // 7. Magnetic CTA (pull toward cursor)
      document.querySelectorAll('.magnet-cta').forEach((btn) => {
        if (!window.matchMedia('(pointer: fine)').matches) return;
        btn.addEventListener('mousemove', (e) => {
          const rect = btn.getBoundingClientRect();
          const x = e.clientX - (rect.left + rect.width / 2);
          const y = e.clientY - (rect.top + rect.height / 2);
          btn.style.transform = `translate(${x * 0.25}px, ${y * 0.25}px)`;
        });
        btn.addEventListener('mouseleave', () => {
          btn.style.transform = '';
        });
      });
    })();
  </script>
