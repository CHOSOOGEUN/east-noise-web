---
import Layout from '../layouts/Layout.astro';

const accent = '#22A06B';
const heroSubtitle = '오늘 하루도,\n자랐어요.';

const steps = [
  {
    title: '식물 이름 짓기',
    body: '식물 이름이 곧 내 이름. 매일 그 이름으로 자라요. 8종 중 마음에 드는 친구로.',
    image: '/screenshots/seed/01-profile.png',
  },
  {
    title: '씨앗 한 톨로 시작',
    body: '짧은 영상 인증, 식물이 자람, 코인으로 다른 식물, 하루 합본 영상 — 4가지가 한 앱에.',
    image: '/screenshots/seed/02-onboarding.png',
  },
  {
    title: '오늘 인증, 한 컷씩',
    body: '루틴 카드에서 "인증 찍기" 한 번. 2-4초면 끝. 운동 후 땀, 책 펼친 손, 명상 후 눈.',
    image: '/screenshots/seed/03-today.png',
  },
  {
    title: '자란 단계가 보여요',
    body: '연속 인증일이 식물 단계로. 갓생 점수가 매일 자라는 게 보여요. 끊겨도 도달한 단계는 그대로.',
    image: '/screenshots/seed/04-plant.png',
  },
  {
    title: '사진 앨범에 자동 저장',
    body: '다음 날 아침엔 어제 영상이 한 편의 클립으로. 기록 탭에선 인스타 스토리처럼 캘린더로 다시 봐요.',
    image: '/screenshots/seed/05-history.png',
  },
];

const features = [
  {
    title: '한 컷이면 인증 끝',
    body: '거창한 거 안 해도 돼요. 운동 후 땀, 책 펼친 손, 명상 후 눈 — 2-4초면 충분해요.',
  },
  {
    title: '갓생이 식물로 보여요',
    body: '인증할수록 식물 단계 ↑. 매일 자라는 게 화면에 보여요. 한 번 키운 단계는 영원히 보존돼요.',
  },
  {
    title: '인스타엔 자동 합본으로',
    body: '다음 날 아침, 어제 인증이 한 편의 클립으로 합쳐져서 사진 앨범에 자동 저장. 스토리·릴스 그대로 올려요.',
  },
];

const faq = [
  {
    q: '영상 어디 저장돼요?',
    a: '전부 본인 폰에만. 우리 서버엔 안 올라가요. 보여주고 싶으면 직접 스토리로 올리면 돼요.',
  },
  {
    q: '연속 끊기면 식물 죽어요?',
    a: '아니에요. 한 번 키운 단계는 영원히 보존돼요. 갓생도 쉬는 날 있죠. 다시 시작할 때 거기서부터.',
  },
  {
    q: '얼마예요?',
    a: '무료. 식물 8종 중 6종은 코인으로 잠금 해제 — 인증·연속만으로 충분히 모을 수 있어요.',
  },
];

const species = [
  '민들레', '해바라기', '튤립', '장미', '선인장', '몬스테라', '대나무', '벚꽃',
];

const stages = ['씨앗', '새싹', '어린잎', '자란잎', '꽃봉오리', '꽃', '나무'];
---

<Layout locale="ko" title="Seed. — 갓생도, 식물도, 매일 한 컷." description="본인 루틴을 짧은 영상으로 인증하면 식물이 자라요. 다음 날 어제 영상은 자동 합본되어 사진 앨범에. 스토리·릴스 그대로." path="/seed">

  <!-- Hero -->
  <section class="bg-seed-ambient relative overflow-hidden">
    <!-- Falling cherry blossom petals -->
    <div class="pointer-events-none absolute inset-0 -z-0">
      <span class="petal-fall-1 absolute" style="left: 5%; top: 0; animation-delay: 0s;">
        <svg width="14" height="14" viewBox="0 0 20 20"><path d="M10 2 C13 5, 13 8, 10 10 C7 8, 7 5, 10 2 Z" fill="#FFC0CB" opacity="0.9"/></svg>
      </span>
      <span class="petal-fall-2 absolute" style="left: 22%; top: 0; animation-delay: 3s;">
        <svg width="12" height="12" viewBox="0 0 20 20"><path d="M10 2 C13 5, 13 8, 10 10 C7 8, 7 5, 10 2 Z" fill="#FFB6C1" opacity="0.85"/></svg>
      </span>
      <span class="petal-fall-3 absolute" style="left: 38%; top: 0; animation-delay: 1.4s;">
        <svg width="10" height="10" viewBox="0 0 20 20"><path d="M10 2 C13 5, 13 8, 10 10 C7 8, 7 5, 10 2 Z" fill="#FFC8DD" opacity="0.85"/></svg>
      </span>
      <span class="petal-fall-1 absolute" style="left: 55%; top: 0; animation-delay: 7s;">
        <svg width="14" height="14" viewBox="0 0 20 20"><path d="M10 2 C13 5, 13 8, 10 10 C7 8, 7 5, 10 2 Z" fill="#FFC0CB" opacity="0.9"/></svg>
      </span>
      <span class="petal-fall-2 absolute" style="left: 70%; top: 0; animation-delay: 2.2s;">
        <svg width="11" height="11" viewBox="0 0 20 20"><path d="M10 2 C13 5, 13 8, 10 10 C7 8, 7 5, 10 2 Z" fill="#FFC8DD" opacity="0.8"/></svg>
      </span>
      <span class="petal-fall-3 absolute" style="left: 85%; top: 0; animation-delay: 5s;">
        <svg width="13" height="13" viewBox="0 0 20 20"><path d="M10 2 C13 5, 13 8, 10 10 C7 8, 7 5, 10 2 Z" fill="#FFB6C1" opacity="0.9"/></svg>
      </span>
      <span class="petal-fall-1 absolute" style="left: 92%; top: 0; animation-delay: 11s;">
        <svg width="10" height="10" viewBox="0 0 20 20"><path d="M10 2 C13 5, 13 8, 10 10 C7 8, 7 5, 10 2 Z" fill="#FFC8DD" opacity="0.85"/></svg>
      </span>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto w-full px-6 pt-16 md:pt-28 pb-20 grid grid-cols-1 md:grid-cols-[1.2fr_1fr] gap-10 md:gap-16 items-center">
      <div>
        <div class="flex items-center gap-2 mb-6 reveal">
          <span class="inline-block w-2 h-2 rounded-full pulse-dot" style={`background-color: ${accent}`}></span>
          <p class="text-xs uppercase tracking-[0.18em] text-[--color-muted] font-medium">
            Indie App · East Noise
          </p>
        </div>
        <h1 class="text-5xl md:text-7xl font-black tracking-tight leading-[1.05] mb-6 reveal" data-delay="100">
          Seed<span style={`color: ${accent}`}>.</span>
        </h1>
        <p class="text-2xl md:text-4xl font-black tracking-tight leading-[1.15] mb-8 whitespace-pre-line reveal" data-delay="200">
          {heroSubtitle}
        </p>
        <p class="text-base md:text-lg text-[--color-muted] max-w-2xl leading-relaxed mb-10 reveal" data-delay="300">
          운동·독서·명상 — 본인 루틴을 짧은 영상 한 컷으로 인증해요. 매일 식물이 자라고, 다음 날 영상은 자동으로 한 편의 클립으로 합쳐져서 사진 앨범에. 스토리·릴스, 그대로 올려요.
        </p>
        <div class="flex flex-wrap items-center gap-3 reveal" data-delay="400">
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium text-white" style={`background-color: ${accent}`}>
            곧 출시
          </span>
          <a href="mailto:eastnoise26@gmail.com?subject=Seed%20%EC%B6%9C%EC%8B%9C%20%EC%95%8C%EB%A6%BC" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[--color-border] bg-white text-sm font-semibold hover:border-[--color-fg] transition-colors min-h-[44px]">
            출시되면 알려드릴게요 →
          </a>
        </div>
      </div>

      <!-- Big cherry blossom SVG with mouse 3D tilt -->
      <div class="reveal flex justify-center md:justify-end" data-delay="200">
        <div id="hero-tilt" class="tilt-3d relative w-64 h-64 md:w-80 md:h-80 rounded-full flex items-center justify-center" style={`background: radial-gradient(circle, rgba(255,192,203,0.22), transparent 70%)`}>
          <span class="absolute float-1 w-1.5 h-1.5 rounded-full" style={`background-color: #FFC0CB; top: 12%; left: 18%;`}></span>
          <span class="absolute float-2 w-2 h-2 rounded-full" style={`background-color: ${accent}; top: 70%; left: 8%;`}></span>
          <span class="absolute float-3 w-1 h-1 rounded-full" style={`background-color: #FFB6C1; top: 28%; right: 6%;`}></span>
          <span class="absolute float-1 w-1.5 h-1.5 rounded-full" style={`background-color: #FFC8DD; top: 78%; right: 12%; animation-delay: 1.5s;`}></span>
          <svg viewBox="0 0 100 130" class="w-3/4 h-3/4">
            <!-- Pot -->
            <path d="M28 110 L72 110 L68 125 L32 125 Z" fill="#9ca3af" opacity="0.25"/>
            <!-- Branch -->
            <path d="M50 110 L50 55" stroke="#6B4423" stroke-width="3" stroke-linecap="round" opacity="0.7"/>
            <path d="M50 80 L34 65" stroke="#6B4423" stroke-width="2.4" stroke-linecap="round" opacity="0.65"/>
            <path d="M50 72 L66 58" stroke="#6B4423" stroke-width="2.4" stroke-linecap="round" opacity="0.65"/>
            <!-- Small side blossom 1 -->
            <g transform="translate(30, 62)">
              <g class="bloom-breathe">
                <ellipse cx="0" cy="-7" rx="4" ry="5.5" fill="#FFC0CB"/>
                <ellipse cx="0" cy="-7" rx="4" ry="5.5" fill="#FFC0CB" transform="rotate(72)"/>
                <ellipse cx="0" cy="-7" rx="4" ry="5.5" fill="#FFC0CB" transform="rotate(144)"/>
                <ellipse cx="0" cy="-7" rx="4" ry="5.5" fill="#FFC0CB" transform="rotate(216)"/>
                <ellipse cx="0" cy="-7" rx="4" ry="5.5" fill="#FFC0CB" transform="rotate(288)"/>
                <circle cx="0" cy="0" r="2.4" fill="#F4D03F"/>
              </g>
            </g>
            <!-- Small side blossom 2 -->
            <g transform="translate(70, 55)">
              <g class="bloom-breathe" style="animation-delay: 0.8s;">
                <ellipse cx="0" cy="-6" rx="3.5" ry="5" fill="#FFB6C1"/>
                <ellipse cx="0" cy="-6" rx="3.5" ry="5" fill="#FFB6C1" transform="rotate(72)"/>
                <ellipse cx="0" cy="-6" rx="3.5" ry="5" fill="#FFB6C1" transform="rotate(144)"/>
                <ellipse cx="0" cy="-6" rx="3.5" ry="5" fill="#FFB6C1" transform="rotate(216)"/>
                <ellipse cx="0" cy="-6" rx="3.5" ry="5" fill="#FFB6C1" transform="rotate(288)"/>
                <circle cx="0" cy="0" r="2.1" fill="#F4D03F"/>
              </g>
            </g>
            <!-- Center large blossom — 5 petals -->
            <g transform="translate(50, 36)">
              <g class="bloom-breathe">
                <ellipse cx="0" cy="-14" rx="9" ry="12" fill="#FFC0CB"/>
                <ellipse cx="0" cy="-14" rx="9" ry="12" fill="#FFC0CB" transform="rotate(72)"/>
                <ellipse cx="0" cy="-14" rx="9" ry="12" fill="#FFC0CB" transform="rotate(144)"/>
                <ellipse cx="0" cy="-14" rx="9" ry="12" fill="#FFC0CB" transform="rotate(216)"/>
                <ellipse cx="0" cy="-14" rx="9" ry="12" fill="#FFC0CB" transform="rotate(288)"/>
                <!-- Inner light petals -->
                <ellipse cx="0" cy="-12" rx="4.5" ry="7" fill="#FFFFFF" opacity="0.6"/>
                <ellipse cx="0" cy="-12" rx="4.5" ry="7" fill="#FFFFFF" opacity="0.6" transform="rotate(72)"/>
                <ellipse cx="0" cy="-12" rx="4.5" ry="7" fill="#FFFFFF" opacity="0.6" transform="rotate(144)"/>
                <ellipse cx="0" cy="-12" rx="4.5" ry="7" fill="#FFFFFF" opacity="0.6" transform="rotate(216)"/>
                <ellipse cx="0" cy="-12" rx="4.5" ry="7" fill="#FFFFFF" opacity="0.6" transform="rotate(288)"/>
                <!-- Yellow center -->
                <circle cx="0" cy="0" r="5" fill="#F4D03F"/>
                <circle cx="0" cy="0" r="2.5" fill="#fff" opacity="0.7"/>
              </g>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="max-w-5xl mx-auto w-full px-6 py-20 border-t border-[--color-border]">
    <h2 class="text-2xl md:text-4xl font-black tracking-tight leading-tight mb-12 reveal">
      매일 한 컷,<br/>
      <span style={`color: ${accent}`}>식물</span>은 자라고,<br/>
      <span class="text-[--color-muted]">인스타엔 그대로.</span>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {features.map((f, i) => (
        <article class="lift reveal bg-white p-8 rounded-2xl border border-[--color-border]" data-delay={String((i + 1) * 100)}>
          <div class="text-3xl font-black tracking-tight mb-4" style={`color: ${accent}`}>
            {String(i + 1).padStart(2, '0')}
          </div>
          <h3 class="text-lg font-bold tracking-tight mb-3">
            {f.title}
          </h3>
          <p class="text-sm text-[--color-muted] leading-relaxed">
            {f.body}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- Sticky scroll storytelling — 씨앗에서 만개까지 -->
  <section class="border-t border-[--color-border] bg-gradient-to-b from-[--color-bg] to-white">
    <div id="story" class="relative" style="height: 400vh;">
      <div class="sticky top-0 h-screen flex items-center overflow-hidden">
        <div class="max-w-5xl mx-auto w-full px-6 grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
          <!-- Plant stage stack -->
          <div class="relative aspect-square w-full max-w-md mx-auto md:mx-0">
            <div class="absolute inset-0 rounded-full" style="background: radial-gradient(circle, rgba(255,192,203,0.18), transparent 70%);"></div>

            <!-- Stage 1: 씨앗 -->
            <div class="story-stage story-active absolute inset-0 flex items-center justify-center" data-stage="0">
              <svg viewBox="0 0 100 100" class="w-1/3 h-1/3">
                <ellipse cx="50" cy="55" rx="14" ry="20" fill="#6B4423"/>
                <ellipse cx="46" cy="48" rx="4" ry="6" fill="#fff" opacity="0.35"/>
              </svg>
            </div>

            <!-- Stage 2: 새싹 -->
            <div class="story-stage story-hidden absolute inset-0 flex items-center justify-center" data-stage="1">
              <svg viewBox="0 0 100 100" class="w-1/2 h-1/2">
                <path d="M50 85 L50 55" stroke={accent} stroke-width="3.5" stroke-linecap="round"/>
                <ellipse cx="38" cy="58" rx="11" ry="5" fill={accent} transform="rotate(-30 38 58)"/>
                <ellipse cx="62" cy="58" rx="11" ry="5" fill={accent} transform="rotate(30 62 58)"/>
              </svg>
            </div>

            <!-- Stage 3: 어린 잎 -->
            <div class="story-stage story-hidden absolute inset-0 flex items-center justify-center" data-stage="2">
              <svg viewBox="0 0 100 100" class="w-3/5 h-3/5">
                <path d="M50 90 L50 35" stroke="#6B4423" stroke-width="3" stroke-linecap="round" opacity="0.7"/>
                <ellipse cx="36" cy="62" rx="14" ry="6" fill={accent}/>
                <ellipse cx="64" cy="62" rx="14" ry="6" fill={accent}/>
                <ellipse cx="40" cy="46" rx="11" ry="5" fill={accent} opacity="0.9"/>
                <ellipse cx="60" cy="46" rx="11" ry="5" fill={accent} opacity="0.9"/>
              </svg>
            </div>

            <!-- Stage 4: 꽃봉오리 -->
            <div class="story-stage story-hidden absolute inset-0 flex items-center justify-center" data-stage="3">
              <svg viewBox="0 0 100 100" class="w-3/5 h-3/5">
                <path d="M50 90 L50 35" stroke="#6B4423" stroke-width="3" stroke-linecap="round" opacity="0.7"/>
                <ellipse cx="36" cy="62" rx="14" ry="6" fill={accent}/>
                <ellipse cx="64" cy="62" rx="14" ry="6" fill={accent}/>
                <ellipse cx="50" cy="30" rx="9" ry="14" fill="#FFB6C1"/>
                <ellipse cx="47" cy="25" rx="3.5" ry="5" fill="#fff" opacity="0.5"/>
              </svg>
            </div>

            <!-- Stage 5: 만개 -->
            <div class="story-stage story-hidden absolute inset-0 flex items-center justify-center" data-stage="4">
              <svg viewBox="0 0 100 100" class="w-3/4 h-3/4">
                <path d="M50 90 L50 40" stroke="#6B4423" stroke-width="2.5" stroke-linecap="round" opacity="0.7"/>
                <path d="M50 65 L34 50" stroke="#6B4423" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
                <path d="M50 58 L66 45" stroke="#6B4423" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
                <g transform="translate(30, 48)">
                  <g class="bloom-breathe">
                    <ellipse cx="0" cy="-6" rx="4" ry="5.5" fill="#FFC0CB"/>
                    <ellipse cx="0" cy="-6" rx="4" ry="5.5" fill="#FFC0CB" transform="rotate(72)"/>
                    <ellipse cx="0" cy="-6" rx="4" ry="5.5" fill="#FFC0CB" transform="rotate(144)"/>
                    <ellipse cx="0" cy="-6" rx="4" ry="5.5" fill="#FFC0CB" transform="rotate(216)"/>
                    <ellipse cx="0" cy="-6" rx="4" ry="5.5" fill="#FFC0CB" transform="rotate(288)"/>
                    <circle cx="0" cy="0" r="2.4" fill="#F4D03F"/>
                  </g>
                </g>
                <g transform="translate(70, 43)">
                  <g class="bloom-breathe" style="animation-delay: 0.6s;">
                    <ellipse cx="0" cy="-5" rx="3.5" ry="5" fill="#FFB6C1"/>
                    <ellipse cx="0" cy="-5" rx="3.5" ry="5" fill="#FFB6C1" transform="rotate(72)"/>
                    <ellipse cx="0" cy="-5" rx="3.5" ry="5" fill="#FFB6C1" transform="rotate(144)"/>
                    <ellipse cx="0" cy="-5" rx="3.5" ry="5" fill="#FFB6C1" transform="rotate(216)"/>
                    <ellipse cx="0" cy="-5" rx="3.5" ry="5" fill="#FFB6C1" transform="rotate(288)"/>
                    <circle cx="0" cy="0" r="2.1" fill="#F4D03F"/>
                  </g>
                </g>
                <g transform="translate(50, 28)">
                  <g class="bloom-breathe" style="animation-delay: 1.2s;">
                    <ellipse cx="0" cy="-10" rx="7" ry="9" fill="#FFC0CB"/>
                    <ellipse cx="0" cy="-10" rx="7" ry="9" fill="#FFC0CB" transform="rotate(72)"/>
                    <ellipse cx="0" cy="-10" rx="7" ry="9" fill="#FFC0CB" transform="rotate(144)"/>
                    <ellipse cx="0" cy="-10" rx="7" ry="9" fill="#FFC0CB" transform="rotate(216)"/>
                    <ellipse cx="0" cy="-10" rx="7" ry="9" fill="#FFC0CB" transform="rotate(288)"/>
                    <ellipse cx="0" cy="-9" rx="3.5" ry="5" fill="#fff" opacity="0.55"/>
                    <ellipse cx="0" cy="-9" rx="3.5" ry="5" fill="#fff" opacity="0.55" transform="rotate(72)"/>
                    <ellipse cx="0" cy="-9" rx="3.5" ry="5" fill="#fff" opacity="0.55" transform="rotate(144)"/>
                    <ellipse cx="0" cy="-9" rx="3.5" ry="5" fill="#fff" opacity="0.55" transform="rotate(216)"/>
                    <ellipse cx="0" cy="-9" rx="3.5" ry="5" fill="#fff" opacity="0.55" transform="rotate(288)"/>
                    <circle cx="0" cy="0" r="3.5" fill="#F4D03F"/>
                  </g>
                </g>
              </svg>
            </div>

            <!-- Stage progress dots -->
            <div class="absolute bottom-0 left-0 right-0 flex justify-center gap-2">
              <span class="story-dot w-2 h-2 rounded-full" data-stage-dot="0" style={`background-color: ${accent}`}></span>
              <span class="story-dot w-2 h-2 rounded-full bg-neutral-300" data-stage-dot="1"></span>
              <span class="story-dot w-2 h-2 rounded-full bg-neutral-300" data-stage-dot="2"></span>
              <span class="story-dot w-2 h-2 rounded-full bg-neutral-300" data-stage-dot="3"></span>
              <span class="story-dot w-2 h-2 rounded-full bg-neutral-300" data-stage-dot="4"></span>
            </div>
          </div>

          <!-- Story copy stack -->
          <div class="relative min-h-[200px]">
            <div class="story-stage story-active absolute inset-0" data-stage="0">
              <p class="text-xs uppercase tracking-[0.18em] font-medium mb-3" style={`color: ${accent}`}>Day 0</p>
              <h3 class="text-3xl md:text-5xl font-black tracking-tight leading-[1.1] mb-4">
                씨앗 한 톨로<br/>시작해요.
              </h3>
              <p class="text-base text-[--color-muted] leading-relaxed">
                갓생, 거창하지 않아도 돼요. 오늘 하나만 정해요.
              </p>
            </div>
            <div class="story-stage story-hidden absolute inset-0" data-stage="1">
              <p class="text-xs uppercase tracking-[0.18em] font-medium mb-3" style={`color: ${accent}`}>Day 1</p>
              <h3 class="text-3xl md:text-5xl font-black tracking-tight leading-[1.1] mb-4">
                첫 인증, <span style={`color: ${accent}`}>새싹</span>.
              </h3>
