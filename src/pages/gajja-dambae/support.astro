  h1 { font-size: 2rem; line-height: 1.3; margin: 2rem 0; } h2 { font-size: 1.2rem; margin-top: 2rem; }
  a { color: #a6bdff; text-underline-offset: .2em; } p { color: #d3d5db; }
</style>
