  <style is:global>
    .bg-luvit-ambient {
      background:
        radial-gradient(900px 500px at 80% 10%, #FF6B9D14, transparent 60%),
        radial-gradient(800px 500px at 10% 80%, #4B2E8314, transparent 60%),
        linear-gradient(180deg, #FFF6F8 0%, #FAFAF8 100%);
    }
    .pulse-dot {
      animation: pulse-dot 2.2s ease-in-out infinite;
    }
    @keyframes pulse-dot {
      0%, 100% { opacity: 0.6; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.3); box-shadow: 0 0 0 6px rgba(255, 107, 157, 0.15); }
    }
    .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: calc(var(--reveal-delay, 0) * 1ms);
    }
    .reveal.is-in {
      opacity: 1;
      transform: translateY(0);
    }
    .reveal[data-delay] {
      --reveal-delay: attr(data-delay number, 0);
    }
    /* Falling petals */
    .petal-fall-1 { animation: petal-fall 16s linear infinite; }
    .petal-fall-2 { animation: petal-fall 22s linear infinite; }
    .petal-fall-3 { animation: petal-fall 19s linear infinite; }
    @keyframes petal-fall {
      0% { transform: translateY(-20px) rotate(0deg); opacity: 0; }
      8% { opacity: 1; }
      92% { opacity: 1; }
      100% { transform: translateY(110vh) rotate(360deg); opacity: 0; }
    }
    /* Hero floating dots */
    .float-1 { animation: float-1 5s ease-in-out infinite; }
    .float-2 { animation: float-2 6.5s ease-in-out infinite 1s; }
    .float-3 { animation: float-3 4.5s ease-in-out infinite 0.4s; }
    @keyframes float-1 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(6px,-10px); } }
    @keyframes float-2 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(-8px,8px); } }
    @keyframes float-3 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(4px,-6px); } }
    /* Bunny entrance + idle bob */
    .bunny { animation: bunny-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) both; transform-origin: bottom center; }
    .bunny-left { animation-delay: 0.4s; }
    .bunny-right { animation-delay: 0.55s; }
    @keyframes bunny-in {
      0% { transform: translateY(40px) scale(0.7); opacity: 0; }
      60% { transform: translateY(-6px) scale(1.04); opacity: 1; }
      100% { transform: translateY(0) scale(1); opacity: 1; }
    }
    .bunny-left { animation: bunny-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both, bunny-bob-left 4s ease-in-out infinite 1.5s; }
    .bunny-right { animation: bunny-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.55s both, bunny-bob-right 4.5s ease-in-out infinite 1.7s; }
    @keyframes bunny-bob-left { 0%,100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-6px) rotate(-2deg); } }
    @keyframes bunny-bob-right { 0%,100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-8px) rotate(2deg); } }
    /* Bubble pop */
    .bubble-pop { animation: bubble-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 1.3s both; transform-origin: bottom; }
    @keyframes bubble-pop {
      0% { transform: scale(0); opacity: 0; }
      80% { transform: scale(1.05); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }
    /* Lift on hover */
    .lift-luvit {
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .lift-luvit:hover {
      transform: translateY(-6px);
      box-shadow: 0 14px 30px rgba(255, 107, 157, 0.12);
    }
    /* Story stages */
    .story-stage {
      transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .story-active { opacity: 1; transform: translateY(0) scale(1); }
    .story-hidden { opacity: 0; transform: translateY(20px) scale(0.96); pointer-events: none; }
    /* Marquee */
    .marquee-track {
      display: flex;
      align-items: center;
      animation: marquee-scroll 38s linear infinite;
      width: max-content;
    }
    @keyframes marquee-scroll {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
    /* Step tilt */
    .step-tilt-luvit {
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .lift-luvit:hover .step-tilt-luvit {
      transform: rotate(-1.5deg) translateY(-4px);
    }
    /* Tilt 3D */
    .tilt-3d { transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); transform-style: preserve-3d; }
    /* CTA glow */
    .cta-glow-luvit { box-shadow: 0 12px 30px rgba(255, 107, 157, 0.4); }
    .magnet-cta { transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
    @media (prefers-reduced-motion: reduce) {
      .reveal { opacity: 1; transform: none; transition: none; }
      .petal-fall-1, .petal-fall-2, .petal-fall-3,
      .float-1, .float-2, .float-3,
      .marquee-track, .pulse-dot { animation: none; }
    }
  </style>

  <script is:inline>
    (() => {
      if (typeof window === 'undefined') return;

      // 1. Reveal on scroll
      const targets = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const delay = entry.target.getAttribute('data-delay');
              if (delay) entry.target.style.setProperty('--reveal-delay', delay);
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-in'));
      }

      // 2. Sticky scroll storytelling — 5 stages
      const story = document.getElementById('story');
      if (story) {
        const stages = story.querySelectorAll('.story-stage');
        const dots = story.querySelectorAll('.story-dot');
        const stageCount = 5;
        const updateStory = () => {
          const rect = story.getBoundingClientRect();
          const totalScroll = story.offsetHeight - window.innerHeight;
          const scrolled = Math.min(Math.max(-rect.top, 0), totalScroll);
          const progress = totalScroll > 0 ? scrolled / totalScroll : 0;
          const activeIdx = Math.min(Math.floor(progress * stageCount), stageCount - 1);
          stages.forEach((el) => {
            const idx = parseInt(el.getAttribute('data-stage') || '0', 10);
            if (idx === activeIdx) {
              el.classList.add('story-active');
              el.classList.remove('story-hidden');
            } else {
              el.classList.remove('story-active');
              el.classList.add('story-hidden');
            }
          });
          dots.forEach((dot, i) => {
            if (i <= activeIdx) {
              dot.style.backgroundColor = '#FF6B9D';
              dot.classList.remove('bg-neutral-300');
            } else {
              dot.style.backgroundColor = '';
              dot.classList.add('bg-neutral-300');
            }
          });
        };
        let raf = 0;
        const onScroll = () => {
          if (raf) return;
          raf = requestAnimationFrame(() => { raf = 0; updateStory(); });
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        updateStory();
      }

      // 3. Subtle 3D tilt on rabbits
      const tiltEl = document.getElementById('hero-tilt');
      if (tiltEl && window.matchMedia('(pointer: fine)').matches) {
        const parent = tiltEl.parentElement;
        parent.addEventListener('mousemove', (e) => {
          const rect = tiltEl.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          const dx = (e.clientX - cx) / rect.width;
          const dy = (e.clientY - cy) / rect.height;
          const ry = dx * 6;
          const rx = -dy * 4;
          tiltEl.style.transform = `perspective(900px) rotateX(${rx}deg) rotateY(${ry}deg)`;
        });
        parent.addEventListener('mouseleave', () => {
          tiltEl.style.transform = '';
        });
      }

      // 4. Magnetic CTA
      document.querySelectorAll('.magnet-cta').forEach((btn) => {
        if (!window.matchMedia('(pointer: fine)').matches) return;
        btn.addEventListener('mousemove', (e) => {
          const rect = btn.getBoundingClientRect();
          const x = e.clientX - (rect.left + rect.width / 2);
          const y = e.clientY - (rect.top + rect.height / 2);
          btn.style.transform = `translate(${x * 0.25}px, ${y * 0.25}px)`;
        });
        btn.addEventListener('mouseleave', () => {
          btn.style.transform = '';
        });
      });
    })();
  </script>
</Layout>
