---
import Layout from '../layouts/Layout.astro';

const accent = '#FF6B9D';       // Luvit 핑크 (벽지·하트)
const deep = '#4B2E83';         // 깊은 보라 (UFO·우주)
const cream = '#FBE9D6';        // 미션 카드 크림
const yellow = '#FFC850';       // 토성·UFO 포인트
const dark = '#1A0B3D';         // 우주 다크 네이비

const appStoreUrl = 'https://apps.apple.com/kr/app/%EB%9F%AC%EB%B9%97-luvit/id6762438141';

const heroSubtitle = '둘만의 우주.\n매일 하나의 미션.';

const features = [
  {
    title: '매일 9시',
    body: '우주선이 깨어나는 시간. 오늘의 미션이 둘 사이에 도착해요. 비밀스럽게 수행하는 동안 상대는 무얼 받았는지 추측해보세요.',
  },
  {
    title: '둘만의 룸',
    body: '우주선 한 척, 토끼 두 마리, 그리고 매일 바뀌는 자정 풍경. 너랑 나만의 작은 공간이 진짜 살아 있어요.',
  },
  {
    title: '자정의 채점',
    body: '하루가 닫히면 미션이 채점되고, 추측이 풀려요. 잘했으면 포인트, 못했으면 우주 벌칙. 다음 날 9시까지 살아남기.',
  },
];

const steps = [
  {
    title: '둘만의 우주로 입장',
    body: 'Google · Apple 로 10초만에. 닉네임 한 줄이면 충분.',
    image: '/screenshots/luvit/01-login.png',
  },
  {
    title: '6자리 코드, 한 줄로',
    body: '내 초대 코드를 상대에게. 두 사람이 같은 우주선에 도착하는 순간.',
    image: '/screenshots/luvit/02-connect.png',
  },
  {
    title: '오늘의 미션 도착',
    body: '9시. 토끼 옆 말풍선에 미션이 떠요. 같은 룸 안에서 서로 다른 미션, 다른 비밀.',
    image: '/screenshots/luvit/03-mission.png',
  },
  {
    title: '서로의 미션 추측',
    body: '상대 토끼를 콕 누르면 4지선다. 정답이면 +100, 아니면 단서 더.',
    image: '/screenshots/luvit/04-judge.png',
  },
  {
    title: '자정, 결과 공개',
    body: '오늘의 미션을 끝냈다고 서로에게 도장. 못 끝낸 쪽은 작은 벌칙. 내일 9시까지 또 살아남기.',
    image: '/screenshots/luvit/05-result.png',
  },
];

const faq = [
  {
    q: '커플 아니어도 써도 돼요?',
    a: '아주 친한 친구·가족이랑도 가능해요. 다만 "오늘 안에 안아주기" 같은 미션도 섞여 있어서, 커플로 쓸 때 가장 어울리게 만들었어요.',
  },
  {
    q: '미션은 누가 만들어요?',
    a: 'East Noise 가 매주 풀을 갱신해요. 너무 부담스러운 건 빼고, 5분 안에 할 수 있는 일상 액션 위주. 추후 직접 미션 만드는 기능도 예정.',
  },
  {
    q: '광고가 있어요?',
    a: '지금은 광고 없음. 무료. 앞으로 룸 꾸미기 아이템 / 미션 팩 같은 작은 인앱 결제만 추가될 예정.',
  },
];

const moments = [
  '미션 6일 연속 성공 = "Streak Cosmonaut" 배지',
  '자정 직전에 도착하는 마지막 푸시',
  '상대가 1초 만에 추측 정답 맞춘 그 순간',
  '둘 다 미션 깐 날, 토끼 두 마리가 하트 띄움',
  '깜빡한 날 받는 작은 우주 벌칙 (귀엽게)',
  '룸에 새 가구 들어온 첫 아침',
];

const promises = [
  { x: '광고 0', y: '한 번도 없음. 보여줄 자리도 안 만들 거예요.' },
  { x: '둘만의 공간', y: '친구 추천·랭킹·다른 커플 비교 — 다 없음.' },
  { x: '하루 1번', y: '알림은 9시 1통. 자정 결과 1통. 끝.' },
  { x: '데이터 최소', y: '닉네임과 토끼만. 사진·연락처·SNS 안 받아요.' },
];
---

<Layout locale="ko" title="러빗 Luvit — 둘만의 우주, 매일 하나의 미션." description="매일 9시, 커플에게 미션 한 개. 비밀스럽게 수행하고 상대 미션은 추측. 자정에 결과 공개. App Store 출시." path="/luvit">

  <!-- Hero -->
  <section class="bg-luvit-ambient relative overflow-hidden">
    <!-- Falling stars + hearts -->
    <div class="pointer-events-none absolute inset-0 -z-0">
      <span class="petal-fall-1 absolute" style={`left: 7%; top: 0; animation-delay: 0s;`}>
        <svg width="14" height="14" viewBox="0 0 20 20"><path d="M10 17s-6-4.5-6-9a4 4 0 0 1 7-2.6A4 4 0 0 1 16 8c0 4.5-6 9-6 9z" fill={accent} opacity="0.7"/></svg>
      </span>
      <span class="petal-fall-2 absolute" style="left: 22%; top: 0; animation-delay: 3s;">
        <svg width="10" height="10" viewBox="0 0 20 20"><circle cx="10" cy="10" r="3" fill={yellow} opacity="0.85"/></svg>
      </span>
      <span class="petal-fall-3 absolute" style="left: 38%; top: 0; animation-delay: 1.4s;">
        <svg width="13" height="13" viewBox="0 0 20 20"><path d="M10 17s-6-4.5-6-9a4 4 0 0 1 7-2.6A4 4 0 0 1 16 8c0 4.5-6 9-6 9z" fill={deep} opacity="0.65"/></svg>
      </span>
      <span class="petal-fall-1 absolute" style="left: 56%; top: 0; animation-delay: 7s;">
        <svg width="9" height="9" viewBox="0 0 20 20"><circle cx="10" cy="10" r="3" fill={yellow} opacity="0.9"/></svg>
      </span>
      <span class="petal-fall-2 absolute" style="left: 72%; top: 0; animation-delay: 2.2s;">
        <svg width="14" height="14" viewBox="0 0 20 20"><path d="M10 17s-6-4.5-6-9a4 4 0 0 1 7-2.6A4 4 0 0 1 16 8c0 4.5-6 9-6 9z" fill={accent} opacity="0.8"/></svg>
      </span>
      <span class="petal-fall-3 absolute" style="left: 86%; top: 0; animation-delay: 5s;">
        <svg width="11" height="11" viewBox="0 0 20 20"><circle cx="10" cy="10" r="3" fill={accent} opacity="0.7"/></svg>
      </span>
      <span class="petal-fall-1 absolute" style="left: 93%; top: 0; animation-delay: 11s;">
        <svg width="9" height="9" viewBox="0 0 20 20"><path d="M10 17s-6-4.5-6-9a4 4 0 0 1 7-2.6A4 4 0 0 1 16 8c0 4.5-6 9-6 9z" fill={deep} opacity="0.75"/></svg>
      </span>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto w-full px-6 pt-16 md:pt-28 pb-20 grid grid-cols-1 md:grid-cols-[1.2fr_1fr] gap-10 md:gap-16 items-center">
      <div>
        <div class="flex items-center gap-2 mb-6 reveal">
          <span class="inline-block w-2 h-2 rounded-full pulse-dot" style={`background-color: ${accent}`}></span>
          <p class="text-xs uppercase tracking-[0.18em] text-[--color-muted] font-medium">
            Indie App · East Noise
          </p>
        </div>
        <h1 class="text-5xl md:text-7xl font-black tracking-tight leading-[1.05] mb-6 reveal" data-delay="100">
          러빗<span style={`color: ${accent}`}>.</span>
        </h1>
        <p class="text-2xl md:text-4xl font-black tracking-tight leading-[1.15] mb-8 whitespace-pre-line reveal" data-delay="200">
          {heroSubtitle}
        </p>
        <p class="text-base md:text-lg text-[--color-muted] max-w-2xl leading-relaxed mb-10 reveal" data-delay="300">
          매일 9시, 커플에게 미션 한 개가 도착해요. 비밀스럽게 수행하는 동안 상대는 너의 미션을 추측. 자정에 모든 결과가 공개돼요. 토끼 두 마리가 사는 우주선이 우리 둘만의 공간이 됩니다.
        </p>
        <div class="flex flex-wrap items-center gap-3 reveal" data-delay="400">
          <a href={appStoreUrl} target="_blank" rel="noopener" class="magnet-cta inline-flex items-center transition-transform hover:scale-105" aria-label="App Store 에서 다운로드">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 152 50" class="h-12 md:h-14 w-auto" role="img" aria-hidden="true">
              <rect width="152" height="50" rx="9" fill="#000"/>
              <path d="M30.5 26.6c0-3 2.5-4.5 2.6-4.5-1.4-2-3.6-2.3-4.4-2.3-1.9-.2-3.6 1.1-4.6 1.1-1 0-2.4-1.1-4-1-2 0-3.9 1.2-5 3-2.1 3.7-.5 9.1 1.5 12.1 1 1.5 2.2 3.1 3.8 3 1.5-.1 2.1-1 3.9-1 1.8 0 2.4 1 4 1 1.7 0 2.7-1.5 3.7-2.9 1.2-1.7 1.7-3.3 1.7-3.4-.1-.1-3.2-1.2-3.2-4.9zm-3-9c.8-1 1.4-2.4 1.3-3.8-1.2.1-2.7.8-3.6 1.8-.8.9-1.5 2.4-1.3 3.7 1.4.1 2.8-.7 3.6-1.7z" fill="#fff"/>
              <text x="46" y="20" fill="#fff" font-size="7" font-family="-apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', Helvetica, sans-serif" letter-spacing="0.2">App Store 에서</text>
              <text x="46" y="36" fill="#fff" font-size="16" font-weight="600" font-family="-apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', Helvetica, sans-serif" letter-spacing="-0.3">다운로드</text>
            </svg>
          </a>
          <a href="#story" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[--color-border] bg-white text-sm font-semibold hover:border-[--color-fg] transition-colors min-h-[44px]">
            어떻게 쓰는지 보기 ↓
          </a>
        </div>
      </div>

      <!-- Two rabbits hero -->
      <div class="reveal flex justify-center md:justify-end" data-delay="200">
        <div id="hero-tilt" class="tilt-3d relative w-full max-w-md">
          <!-- Soft glow background -->
          <div class="absolute inset-0 -z-10" style={`background: radial-gradient(circle at 50% 50%, ${accent}1A, transparent 65%); filter: blur(20px);`}></div>

          <div class="relative flex items-end justify-center gap-2 md:gap-6">
            <div class="relative bunny bunny-left">
              <img src="/screenshots/luvit/rabbit_blue.svg" alt="Blue rabbit — you" class="w-32 md:w-40 drop-shadow-xl" loading="eager"/>
              <!-- Speech bubble: 내 미션 -->
              <div class="absolute -top-12 -left-2 md:-left-6 bg-white rounded-2xl border border-[--color-border] px-3 py-2 text-xs md:text-sm font-bold whitespace-nowrap bubble-pop" style={`color: ${deep};`}>
                <span>오늘 내 미션은?</span>
                <span class="absolute -bottom-1 left-6 w-2 h-2 bg-white border-r border-b border-[--color-border] transform rotate-45"></span>
              </div>
            </div>
            <div class="relative bunny bunny-right">
              <img src="/screenshots/luvit/rabbit_pink.svg" alt="Pink rabbit — partner" class="w-32 md:w-40 drop-shadow-xl" loading="eager"/>
              <!-- Speech bubble: 추측 -->
              <div class="absolute -top-12 -right-2 md:-right-6 px-3 py-2 rounded-2xl text-xs md:text-sm font-bold whitespace-nowrap text-white bubble-pop" style={`background-color: ${accent}; animation-delay: 0.3s;`}>
                <span>맞춰봐!</span>
                <span class="absolute -bottom-1 right-6 w-2 h-2 transform rotate-45" style={`background-color: ${accent};`}></span>
              </div>
            </div>
          </div>

          <!-- Floating hearts -->
          <span class="absolute float-1 text-lg" style="top: -8%; left: 10%;">💕</span>
          <span class="absolute float-2 text-base" style="top: 30%; right: 0%;">✨</span>
          <span class="absolute float-3 text-sm" style="bottom: -5%; left: 5%;">⭐</span>
          <span class="absolute float-1 text-base" style="top: 10%; right: 15%; animation-delay: 1.5s;">💫</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Promises (Anti-features) -->
  <section class="max-w-5xl mx-auto w-full px-6 py-20 border-t border-[--color-border]">
    <p class="text-xs uppercase tracking-[0.18em] text-[--color-muted] font-medium mb-3 reveal">
      Luvit 만의 약속
    </p>
    <h2 class="text-2xl md:text-4xl font-black tracking-tight leading-tight mb-12 reveal" data-delay="100">
      다른 커플 앱과<br/>
      <span style={`color: ${accent}`}>뭐가 달라요?</span>
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-[--color-border] border border-[--color-border]">
      {promises.map((p, i) => (
        <article class="bg-white p-7 reveal" data-delay={String((i + 1) * 80)}>
          <div class="text-xl md:text-2xl font-black tracking-tight mb-2" style={`color: ${accent}`}>
            {p.x}
          </div>
          <p class="text-sm text-[--color-muted] leading-relaxed">
            {p.y}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- Features -->
  <section class="max-w-5xl mx-auto w-full px-6 py-20 border-t border-[--color-border]">
    <h2 class="text-2xl md:text-4xl font-black tracking-tight leading-tight mb-12 reveal">
      매일 한 번,<br/>
      <span style={`color: ${accent}`}>둘만의 우주</span>가<br/>
      <span class="text-[--color-muted]">깨어나는 시간.</span>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {features.map((f, i) => (
        <article class="lift-luvit reveal bg-white p-8 rounded-2xl border border-[--color-border]" data-delay={String((i + 1) * 100)}>
          <div class="text-3xl font-black tracking-tight mb-4" style={`color: ${accent}`}>
            {String(i + 1).padStart(2, '0')}
          </div>
          <h3 class="text-lg font-bold tracking-tight mb-3">
            {f.title}
          </h3>
          <p class="text-sm text-[--color-muted] leading-relaxed">
            {f.body}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- Sticky scroll storytelling — 하루의 사이클 -->
  <section class="border-t border-[--color-border] bg-gradient-to-b from-[--color-bg] to-white">
    <div id="story" class="relative" style="height: 500vh;">
      <div class="sticky top-0 h-screen flex items-center overflow-hidden">
        <div class="max-w-5xl mx-auto w-full px-6 grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
          <!-- Stage visual stack -->
          <div class="relative aspect-square w-full max-w-md mx-auto md:mx-0">
            <div class="absolute inset-0 rounded-full" style={`background: radial-gradient(circle, ${accent}1F, transparent 70%);`}></div>

            <!-- Stage 0: 9 PM, 미션 도착 -->
            <div class="story-stage story-active absolute inset-0 flex items-center justify-center" data-stage="0">
              <div class="relative w-3/5">
                <div class="bg-white rounded-2xl border border-neutral-200 p-6 shadow-lg">
                  <div class="text-xs font-bold tracking-[0.18em] mb-3" style={`color: ${accent}`}>오늘 · 21:00</div>
                  <div class="text-xl md:text-2xl font-black tracking-tight leading-snug">
                    오늘 안에<br/>먼저 손 꼭 잡기.
                  </div>
                  <div class="mt-5 inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-xs font-bold text-white" style={`background-color: ${accent}`}>
                    수락하기 →
                  </div>
                </div>
              </div>
            </div>

            <!-- Stage 1: 비밀스럽게 수행 -->
            <div class="story-stage story-hidden absolute inset-0 flex items-center justify-center" data-stage="1">
              <div class="relative w-3/5">
                <!-- Two rabbits, one with thought bubble -->
                <div class="flex items-center justify-around mb-4">
                  <div class="text-5xl" style="filter: hue-rotate(0deg);">🐰</div>
                  <div class="text-5xl" style="filter: hue-rotate(280deg);">🐰</div>
                </div>
                <div class="bg-white rounded-xl border border-neutral-200 p-3 text-center">
                  <div class="text-xs font-bold mb-1" style={`color: ${deep}`}>비밀 임무 수행 중</div>
                  <div class="text-sm font-bold">상대는 모름</div>
                </div>
              </div>
            </div>

            <!-- Stage 2: 추측 -->
            <div class="story-stage story-hidden absolute inset-0 flex items-center justify-center" data-stage="2">
              <div class="w-3/5 space-y-2">
                <div class="text-xs font-bold tracking-[0.18em] mb-2 text-center" style={`color: ${deep}`}>상대 미션 추측</div>
                <div class="bg-white rounded-xl border border-neutral-200 p-3 text-sm font-medium opacity-60">먼저 안아주기</div>
                <div class="rounded-xl p-3 text-sm font-bold border-2" style={`border-color: ${accent}; background-color: ${accent}11;`}>
                  먼저 손 잡기 ✓
                </div>
                <div class="bg-white rounded-xl border border-neutral-200 p-3 text-sm font-medium opacity-60">먼저 사랑한다 말하기</div>
                <div class="bg-white rounded-xl border border-neutral-200 p-3 text-sm font-medium opacity-60">먼저 사진 찍기</div>
              </div>
            </div>

            <!-- Stage 3: 자정 채점 -->
            <div class="story-stage story-hidden absolute inset-0 flex items-center justify-center" data-stage="3">
              <div class="relative w-1/2 aspect-square rounded-full flex items-center justify-center" style={`background-color: ${deep}; border: 2px solid ${accent}55;`}>
                <svg viewBox="0 0 100 100" class="w-1/2 h-1/2" style={`color: ${yellow}`}>
                  <circle cx="50" cy="50" r="42" fill="none" stroke="currentColor" stroke-width="3" opacity="0.5"/>
                  <line x1="50" y1="50" x2="50" y2="12" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
                  <line x1="50" y1="50" x2="50" y2="14" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
                  <circle cx="50" cy="50" r="3" fill="currentColor"/>
                </svg>
                <div class="absolute -bottom-8 left-1/2 -translate-x-1/2 text-xs font-bold tracking-[0.18em]" style={`color: ${deep}`}>
                  00:00 · 자정 채점
                </div>
              </div>
            </div>

            <!-- Stage 4: 결과 공개 -->
            <div class="story-stage story-hidden absolute inset-0 flex items-center justify-center" data-stage="4">
              <div class="relative w-3/5">
                <div class="bg-white rounded-2xl border border-neutral-200 p-6 shadow-lg text-center">
                  <div class="inline-block px-3 py-1 rounded-md text-[10px] font-black tracking-[0.18em] mb-3 text-white" style={`background-color: ${accent}`}>SUCCESS</div>
                  <div class="text-5xl mb-3">💞</div>
                  <div class="text-base font-black tracking-tight mb-1">둘 다 성공</div>
                  <div class="text-xs font-bold" style={`color: ${deep}`}>+100 우주 포인트</div>
                </div>
              </div>
            </div>

            <!-- Progress dots -->
            <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 flex gap-1.5">
              {Array.from({ length: 5 }).map(() => (
                <span class="story-dot w-1.5 h-1.5 rounded-full bg-neutral-300"></span>
              ))}
            </div>
          </div>

          <!-- Stage text stack -->
          <div class="relative min-h-[12rem]">
            <div class="story-stage story-active absolute inset-0" data-stage="0">
              <p class="text-xs uppercase tracking-[0.18em] font-medium mb-3" style={`color: ${accent}`}>9:00 PM</p>
              <h3 class="text-3xl md:text-5xl font-black tracking-tight leading-[1.1] mb-4">
                미션이<br/>도착해요.
              </h3>
              <p class="text-base text-[--color-muted] leading-relaxed">
                매일 밤 9시, 둘만의 우주선에 미션 카드 한 장. 한 시간 안에 수락.
              </p>
            </div>
            <div class="story-stage story-hidden absolute inset-0" data-stage="1">
              <p class="text-xs uppercase tracking-[0.18em] font-medium mb-3" style={`color: ${deep}`}>Secret</p>
              <h3 class="text-3xl md:text-5xl font-black tracking-tight leading-[1.1] mb-4">
