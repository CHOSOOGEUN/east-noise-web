---
import Layout from '../../layouts/Layout.astro';
import UridayInfoPage from '../../components/UridayInfoPage.astro';

const sections = [
  { title: '로그인되지 않아요', body: '네트워크를 확인하고 Apple·Google·Kakao 로그인 창을 다시 여세요. 취소한 경우에는 계정이 만들어지지 않습니다. 같은 이메일처럼 보여도 서로 다른 로그인 수단의 계정을 자동으로 합치지 않습니다. 어떤 로그인 수단을 썼는지 기억나지 않으면 앱 버전과 표시된 오류만 적어 문의해 주세요.' },
  { title: '연결 코드가 안 돼요', body: '코드는 숫자 6자리이며 만든 뒤 10분 동안 한 번만 사용할 수 있습니다. 이미 사용했거나 시간이 지났다면 새 코드를 만드세요. 두 계정 중 하나가 이미 다른 사람과 연결되어 있으면 먼저 연결·계정 관리에서 상태를 확인해야 합니다.' },
  { title: '일정이나 일기가 아직 안 보여요', body: 'pending은 이 기기에 저장됐지만 서버 확정 전, failed는 재전송이 필요한 상태입니다. 네트워크가 돌아오면 자동으로 다시 시도합니다. 같은 일정을 동시에 수정했다면 최신 내용을 확인한 뒤 다시 저장해 주세요. 일기는 “일기 공유하기”를 누르기 전까지 상대에게 보이지 않습니다.' },
  { title: '사진·마이크·알림 권한', body: '사진은 글 일기에 사진을 고를 때, 마이크는 음성 일기를 녹음할 때, 알림은 일정 알림을 켤 때 요청합니다. 거부한 뒤에는 기기 설정에서 우리데이 권한을 다시 켤 수 있습니다. 권한이 없어도 해당 기능 외의 일정과 글·그림 일기는 계속 사용할 수 있습니다.' },
  { title: '구매 복원과 구독 관리', body: '결제한 Apple 또는 Google 계정으로 로그인한 뒤 우리데이의 구매 복원을 실행하세요. 복원 후에도 접근 권한이 보이지 않으면 스토어 결제 상태와 우리데이 계정을 함께 적어 문의해 주세요. 계정 삭제와 커플 연결 해제는 스토어 자동 갱신을 해지하지 않습니다.' },
  { title: '가입 연령', body: '우리데이는 만 14세 이상만 가입할 수 있습니다. 만 14세 미만을 위한 가입·보호자 동의 절차는 제공하지 않습니다. 연령 선택을 잘못했다면 새 계정을 만들기 전에 고객지원으로 문의해 주세요.' },
  { title: '계정·연결을 정리하려면', body: '연결 해제는 7일 동안 두 사람의 동의로 복구할 수 있습니다. 계정 삭제는 요청 후 7일 동안 본인이 취소할 수 있고, 이후에는 본인이 작성한 공유 일기와 첨부파일도 삭제합니다. 자세한 범위는 계정 및 데이터 삭제 안내에서 확인하세요.' },
];
---

<Layout locale="ko" chrome="none" title="우리데이 고객지원 — 동방의 소음" description="우리데이 로그인, 커플 연결, 동기화, 권한, 구독과 계정 삭제 도움말입니다." path="/uriday/support" themeColor="#fbfaf7">
  <UridayInfoPage page="support" title="막히는 순간을 빠르게 풀어요." lead="로그인부터 연결, 동기화, 권한, 결제와 삭제까지 사용자가 바로 시도할 수 있는 해결 방법을 모았습니다." sections={sections} />
</Layout>
