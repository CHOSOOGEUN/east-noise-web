---
import Layout from '../../layouts/Layout.astro';

const accent = '#7B5BFF';       // Pickie purple (sober white-bg ver of #5B4FFF)
const lime = '#76C72A';         // Pickie lime (darkened from #B8FF3D for white-bg contrast)
const pink = '#FF4FA3';         // Pickie pink
const heroSubtitle = '9 PM. One question.\nNext day. Results.';

const features = [
  {
    title: 'Anonymous, for real',
    body: 'Counts go public. Votes never do. The votes collection is rules-locked client-side — only the server tallies it.',
  },
  {
    title: 'Every night at 9',
    body: 'One question, your crew. 23 hours to pick one. Reveal the next day at 8 PM.',
  },
  {
    title: 'Crew only',
    body: 'No bots, no strangers — just your crew of 7-50 close friends. 6-character invite code to join.',
  },
];

const steps = [
  {
    title: 'Tonight\'s round',
    body: '9 PM push. Active round card lands on home. Pickable vs results-pending state at a glance.',
    image: '/screenshots/pickie/01-home.png',
  },
  {
    title: 'Pick one, anonymously',
    body: 'Tap one crew member. Tap another to change. Long-press to report or block.',
    image: '/screenshots/pickie/02-vote.png',
  },
  {
    title: '8 PM next day, public',
    body: 'Vote counts from #1 down to zero. Who voted stays private.',
    image: '/screenshots/pickie/03-results.png',
  },
  {
    title: 'You got picked?',
    body: 'Watch one ad, reveal one picker. One at a time, or all at once.',
    image: '/screenshots/pickie/04-reveal.png',
  },
  {
    title: 'Every day counts',
    body: 'Vote daily, streak grows. Skip a day, back to zero. Picked / Voted / Streak in one view.',
    image: '/screenshots/pickie/05-profile.png',
  },
];

const faq = [
  {
    q: 'Is it really anonymous?',
    a: 'Yes. The votes collection is locked from client reads — Firestore Security Rules enforce this. The server tallies counts and reveals only "X people picked you", never which X. Even if subpoenaed, RevenueCat / Apple don\'t see voter identity either.',
  },
  {
    q: 'How much?',
    a: 'Free. Watch one ad to reveal one picker, $1.09 for a reveal pack (everyone at once), or $1.99/mo Pickie Plus (auto-reveal, no ads). All optional.',
  },
  {
    q: 'What if I don\'t have a close-friends group?',
    a: 'Pickie only works for "crews" of 7-50 close friends — no bot matchmaking, no stranger lobbies. Start one and share the 6-character code, or join with a code from a friend.',
  },
];

const sampleQuestions = [
  'Who sleeps through any alarm?',
  'Who\'ll be rich first?',
  'Slowest to text back?',
  'Secret genius of the crew?',
  'Loudest after a few drinks?',
  'Most "influencer MBTI"?',
  'Won\'t mind if you ghost them?',
  'Never asked anyone for help?',
];
---

<Layout locale="en" title="Pickie — Anonymous crew picks, every night at 9." description="One question a night. Pick one in your crew, anonymously. Reveal at 8 PM the next day. Counts go public — votes stay private." path="/en/pickie">
  <!-- Scroll progress bar -->
  <div id="scroll-progress" class="scroll-progress" style={`background-color: ${accent}`}></div>

  <!-- Hero -->
  <section class="bg-pickie-ambient relative overflow-hidden">
    <!-- Falling pick chips (lime/pink/purple) -->
    <div class="pointer-events-none absolute inset-0 -z-0">
      <span class="petal-fall-1 absolute" style={`left: 6%; top: 0; animation-delay: 0s;`}>
        <svg width="16" height="16" viewBox="0 0 20 20"><rect x="2" y="2" width="16" height="16" rx="5" fill={lime} opacity="0.7"/></svg>
      </span>
      <span class="petal-fall-2 absolute" style="left: 22%; top: 0; animation-delay: 3s;">
        <svg width="12" height="12" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8" fill={pink} opacity="0.65"/></svg>
      </span>
      <span class="petal-fall-3 absolute" style="left: 40%; top: 0; animation-delay: 1.4s;">
        <svg width="14" height="14" viewBox="0 0 20 20"><rect x="2" y="2" width="16" height="16" rx="5" fill={accent} opacity="0.7"/></svg>
      </span>
      <span class="petal-fall-1 absolute" style="left: 58%; top: 0; animation-delay: 7s;">
        <svg width="11" height="11" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8" fill={lime} opacity="0.75"/></svg>
      </span>
      <span class="petal-fall-2 absolute" style="left: 73%; top: 0; animation-delay: 2.2s;">
        <svg width="15" height="15" viewBox="0 0 20 20"><rect x="2" y="2" width="16" height="16" rx="5" fill={pink} opacity="0.7"/></svg>
      </span>
      <span class="petal-fall-3 absolute" style="left: 88%; top: 0; animation-delay: 5s;">
        <svg width="13" height="13" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8" fill={accent} opacity="0.7"/></svg>
      </span>
      <span class="petal-fall-1 absolute" style="left: 94%; top: 0; animation-delay: 11s;">
        <svg width="10" height="10" viewBox="0 0 20 20"><rect x="2" y="2" width="16" height="16" rx="5" fill={lime} opacity="0.8"/></svg>
      </span>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto w-full px-6 pt-16 md:pt-28 pb-20 grid grid-cols-1 md:grid-cols-[1.2fr_1fr] gap-10 md:gap-16 items-center">
      <div>
        <div class="flex items-center gap-2 mb-6 reveal">
          <span class="inline-block w-2 h-2 rounded-full pulse-dot" style={`background-color: ${accent}`}></span>
          <p class="text-xs uppercase tracking-[0.18em] text-[--color-muted] font-medium">
            Indie App · East Noise
          </p>
        </div>
        <h1 class="text-5xl md:text-7xl font-black tracking-tight leading-[1.05] mb-6 reveal" data-delay="100">
          Pickie<span style={`color: ${accent}`}>.</span>
        </h1>
        <p class="text-2xl md:text-4xl font-black tracking-tight leading-[1.15] mb-8 whitespace-pre-line reveal" data-delay="200">
          {heroSubtitle}
        </p>
        <p class="text-base md:text-lg text-[--color-muted] max-w-2xl leading-relaxed mb-10 reveal" data-delay="300">
          친구 크루에서 한 명을 익명으로 픽. 다음 날 저녁 8시, 누가 1등인지만 공개돼요. 누가 표를 줬는지는 비밀. 봇·낯선 사람 없이 가까운 친구 7~50명만.
        </p>
        <div class="flex flex-wrap items-center gap-3 reveal" data-delay="400">
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium text-white" style={`background-color: ${accent}`}>
            In App Store review
          </span>
          <a href="mailto:eastnoise26@gmail.com?subject=Pickie%20launch%20notification" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[--color-border] bg-white text-sm font-semibold hover:border-[--color-fg] transition-colors min-h-[44px]">
            Notify me at launch →
          </a>
        </div>
      </div>

      <!-- Phone mockup with 3D tilt -->
      <div class="reveal flex justify-center md:justify-end" data-delay="200">
        <div id="hero-tilt" class="tilt-3d relative w-64 md:w-72">
          <div class="relative" style={`filter: drop-shadow(0 30px 60px rgba(123, 91, 255, 0.25));`}>
            <img src="/screenshots/pickie/01-home.png" alt="Pickie home screen" class="w-full rounded-[36px] border border-neutral-900/10" loading="eager"/>
          </div>
          <span class="absolute float-1 w-2 h-2 rounded-full" style={`background-color: ${lime}; top: -8%; left: -8%;`}></span>
          <span class="absolute float-2 w-2.5 h-2.5 rounded-full" style={`background-color: ${pink}; top: 50%; right: -10%;`}></span>
          <span class="absolute float-3 w-1.5 h-1.5 rounded-full" style={`background-color: ${accent}; bottom: 5%; left: -6%;`}></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="max-w-5xl mx-auto w-full px-6 py-20 border-t border-[--color-border]">
    <h2 class="text-2xl md:text-4xl font-black tracking-tight leading-tight mb-12 reveal">
      One pick, anonymous.<br/>
      <span style={`color: ${accent}`}>Next day</span>, everyone sees.<br/>
      <span class="text-[--color-muted]">Crew only.</span>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {features.map((f, i) => (
        <article class="lift-pickie reveal bg-white p-8 rounded-2xl border border-[--color-border]" data-delay={String((i + 1) * 100)}>
          <div class="text-3xl font-black tracking-tight mb-4" style={`color: ${accent}`}>
            {String(i + 1).padStart(2, '0')}
          </div>
          <h3 class="text-lg font-bold tracking-tight mb-3">
            {f.title}
          </h3>
          <p class="text-sm text-[--color-muted] leading-relaxed">
            {f.body}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- Sticky scroll storytelling — 하루의 사이클 -->
  <section class="border-t border-[--color-border] bg-gradient-to-b from-[--color-bg] to-white">
    <div id="story" class="relative" style="height: 400vh;">
      <div class="sticky top-0 h-screen flex items-center overflow-hidden">
        <div class="max-w-5xl mx-auto w-full px-6 grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
          <!-- Stage visual stack -->
          <div class="relative aspect-square w-full max-w-md mx-auto md:mx-0">
            <div class="absolute inset-0 rounded-full" style={`background: radial-gradient(circle, ${accent}1F, transparent 70%);`}></div>

            <!-- Stage 0: 9 PM, question lands -->
            <div class="story-stage story-active absolute inset-0 flex items-center justify-center" data-stage="0">
              <div class="relative w-3/5">
                <div class="bg-white rounded-2xl border border-neutral-200 p-6 shadow-lg">
                  <div class="text-xs font-bold tracking-[0.18em] mb-3" style={`color: ${lime}`}>Today · 9:00 PM</div>
                  <div class="text-xl md:text-2xl font-black tracking-tight leading-snug">
                    Who in the crew<br/>sleeps through any alarm?
                  </div>
                  <div class="mt-5 inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-xs font-bold text-white" style={`background-color: ${lime}; color: #0A0A0F`}>
                    Cast your pick →
                  </div>
                </div>
              </div>
            </div>

            <!-- Stage 1: pick one -->
            <div class="story-stage story-hidden absolute inset-0 flex items-center justify-center" data-stage="1">
              <div class="w-3/5 space-y-2">
                <div class="bg-white rounded-xl border border-neutral-200 p-3 flex items-center gap-3 opacity-70">
                  <div class="w-9 h-9 rounded-lg flex items-center justify-center font-black text-sm" style={`background-color: ${lime}; color: #0A0A0F`}>J</div>
                  <span class="text-sm font-bold">Jesse</span>
                </div>
                <div class="rounded-xl p-3 flex items-center gap-3 border-2" style={`border-color: ${accent}; background-color: ${accent}11;`}>
                  <div class="w-9 h-9 rounded-lg flex items-center justify-center font-black text-sm text-white" style={`background-color: ${pink}`}>M</div>
                  <span class="text-sm font-bold">Mira</span>
                  <span class="ml-auto w-5 h-5 rounded-full flex items-center justify-center text-white text-xs" style={`background-color: ${accent}`}>✓</span>
                </div>
                <div class="bg-white rounded-xl border border-neutral-200 p-3 flex items-center gap-3 opacity-70">
                  <div class="w-9 h-9 rounded-lg flex items-center justify-center font-black text-sm text-white" style={`background-color: ${accent}`}>S</div>
                  <span class="text-sm font-bold">Sophie</span>
                </div>
              </div>
            </div>

            <!-- Stage 2: 결과 대기 -->
            <div class="story-stage story-hidden absolute inset-0 flex items-center justify-center" data-stage="2">
              <div class="relative w-1/2 aspect-square rounded-full flex items-center justify-center" style={`background-color: ${accent}11; border: 1px dashed ${accent}55;`}>
                <svg viewBox="0 0 100 100" class="w-1/2 h-1/2" style={`color: ${accent}`}>
                  <circle cx="50" cy="50" r="42" fill="none" stroke="currentColor" stroke-width="3" opacity="0.3"/>
                  <line x1="50" y1="50" x2="50" y2="25" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
                  <line x1="50" y1="50" x2="70" y2="55" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
                  <circle cx="50" cy="50" r="3" fill="currentColor"/>
                </svg>
              </div>
            </div>

            <!-- Stage 3: reveal (winner) -->
            <div class="story-stage story-hidden absolute inset-0 flex items-center justify-center" data-stage="3">
              <div class="relative w-3/5">
                <div class="bg-white rounded-2xl border border-neutral-200 p-6 shadow-lg text-center">
                  <div class="inline-block px-3 py-1 rounded-md text-[10px] font-black tracking-[0.18em] mb-3 text-white" style={`background-color: ${lime}; color: #0A0A0F`}>PICKER</div>
                  <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-3 font-black text-2xl text-white" style={`background-color: ${pink}`}>M</div>
                  <div class="text-lg font-black tracking-tight">Mira</div>
                  <div class="text-xs font-bold mt-1" style={`color: ${lime}`}>4 picks</div>
                </div>
              </div>
            </div>

            <!-- Stage 4: you got picked -->
            <div class="story-stage story-hidden absolute inset-0 flex items-center justify-center" data-stage="4">
              <div class="relative w-3/5">
                <div class="text-center mb-3 text-5xl">🎉</div>
                <div class="bg-white rounded-2xl border border-neutral-200 p-5 shadow-lg text-center">
                  <div class="text-base font-black tracking-tight">4 people picked you</div>
                  <div class="text-xs text-[--color-muted] mt-1 mb-4">One ad = one picker revealed</div>
                  <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold text-white" style={`background: linear-gradient(135deg, ${accent}, ${pink});`}>
                    See who picked you →
                  </div>
                </div>
              </div>
            </div>

            <!-- Progress dots -->
            <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 flex gap-1.5">
              {Array.from({ length: 5 }).map(() => (
                <span class="story-dot w-1.5 h-1.5 rounded-full bg-neutral-300"></span>
              ))}
            </div>
          </div>

          <!-- Stage text stack -->
          <div class="relative min-h-[12rem]">
            <div class="story-stage story-active absolute inset-0" data-stage="0">
              <p class="text-xs uppercase tracking-[0.18em] font-medium mb-3" style={`color: ${lime}`}>9:00 PM</p>
              <h3 class="text-3xl md:text-5xl font-black tracking-tight leading-[1.1] mb-4">
                Question<br/>lands in your crew.
              </h3>
              <p class="text-base text-[--color-muted] leading-relaxed">
                Every night at 9, one question per crew. 23 hours to pick one.
              </p>
            </div>
            <div class="story-stage story-hidden absolute inset-0" data-stage="1">
              <p class="text-xs uppercase tracking-[0.18em] font-medium mb-3" style={`color: ${accent}`}>Pick</p>
              <h3 class="text-3xl md:text-5xl font-black tracking-tight leading-[1.1] mb-4">
                Pick one,<br/>anonymously.
              </h3>
              <p class="text-base text-[--color-muted] leading-relaxed">
                One tap. Tap another to change. Long-press to report or block.
              </p>
            </div>
            <div class="story-stage story-hidden absolute inset-0" data-stage="2">
              <p class="text-xs uppercase tracking-[0.18em] font-medium mb-3" style={`color: ${accent}`}>Waiting</p>
              <h3 class="text-3xl md:text-5xl font-black tracking-tight leading-[1.1] mb-4">
                23 hours,<br/>no one knows.
              </h3>
              <p class="text-base text-[--color-muted] leading-relaxed">
                voterId is never exposed to clients. The server just tallies counts.
              </p>
            </div>
            <div class="story-stage story-hidden absolute inset-0" data-stage="3">
              <p class="text-xs uppercase tracking-[0.18em] font-medium mb-3" style={`color: ${lime}`}>Next day · 8 PM</p>
              <h3 class="text-3xl md:text-5xl font-black tracking-tight leading-[1.1] mb-4">
                Results,<br/>public.
              </h3>
              <p class="text-base text-[--color-muted] leading-relaxed">
                You see the counts. Who voted stays a secret.
              </p>
            </div>
            <div class="story-stage story-hidden absolute inset-0" data-stage="4">
              <p class="text-xs uppercase tracking-[0.18em] font-medium mb-3" style={`color: ${pink}`}>You got picked</p>
              <h3 class="text-3xl md:text-5xl font-black tracking-tight leading-[1.1] mb-4">
                Picked?<br/>Reveal slowly.
              </h3>
              <p class="text-base text-[--color-muted] leading-relaxed">
                One ad = one picker. Or all at once, or auto-reveal with Plus.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How to use -->
  <section class="max-w-6xl mx-auto w-full px-6 py-20 border-t border-[--color-border]">
    <p class="text-xs uppercase tracking-[0.18em] text-[--color-muted] font-medium mb-3 reveal">
      Flow
    </p>
    <h2 class="text-2xl md:text-4xl font-black tracking-tight leading-tight mb-12 reveal" data-delay="100">
      First time you open it.
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      {steps.map((s, i) => (
        <article class="lift-pickie reveal flex flex-col" data-delay={String((i + 1) * 80)}>
          <div class="mb-4 relative">
            <div class="step-tilt step-tilt-pickie aspect-[9/19.5] rounded-[28px] overflow-hidden border border-neutral-200 bg-neutral-950 shadow-sm">
              <img src={s.image} alt={s.title} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <span class="absolute -top-2 -left-2 w-8 h-8 rounded-full flex items-center justify-center text-xs font-black text-white shadow-md z-10" style={`background-color: ${accent}`}>
              {i + 1}
            </span>
          </div>
          <h3 class="text-sm font-bold tracking-tight mb-2 px-1">
            {s.title}
          </h3>
          <p class="text-xs text-[--color-muted] leading-relaxed px-1">
            {s.body}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- Sample questions marquee -->
  <section class="py-20 border-t border-[--color-border] overflow-hidden">
    <div class="max-w-5xl mx-auto px-6">
      <p class="text-xs uppercase tracking-[0.18em] text-[--color-muted] font-medium mb-3 reveal">
        Question Pool
      </p>
      <h2 class="text-2xl md:text-4xl font-black tracking-tight leading-tight mb-2 reveal" data-delay="100">
        What's tonight's question?
      </h2>
      <p class="text-sm text-[--color-muted] mb-10 reveal" data-delay="200">
        Pool of 95 in English (and 95 more in Korean). One random per crew, per night.
      </p>
    </div>
    <div class="marquee-track">
      {[...sampleQuestions, ...sampleQuestions].map((q) => (
        <div class="flex items-center gap-3 px-6 py-3 mr-3 rounded-full border border-[--color-border] bg-white whitespace-nowrap">
          <span class="w-2 h-2 rounded-full" style={`background-color: ${accent}`}></span>
          <span class="text-base font-bold tracking-tight">{q}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-5xl mx-auto w-full px-6 py-20 border-t border-[--color-border]">
    <p class="text-xs uppercase tracking-[0.18em] text-[--color-muted] font-medium mb-3 reveal">
      FAQ
    </p>
    <h2 class="text-2xl md:text-4xl font-black tracking-tight leading-tight mb-12 reveal" data-delay="100">
      Questions before you start.
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {faq.map((item, i) => (
        <article class="lift-pickie reveal bg-white rounded-2xl border border-[--color-border] p-8" data-delay={String((i + 1) * 100)}>
          <h3 class="text-base font-bold tracking-tight mb-3">
            {item.q}
          </h3>
          <p class="text-sm text-[--color-muted] leading-relaxed">
            {item.a}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- Final CTA -->
  <section class="max-w-5xl mx-auto w-full px-6 py-24 border-t border-[--color-border]">
    <div class="reveal rounded-3xl p-10 md:p-16 text-center" style={`background: linear-gradient(135deg, ${accent}, ${pink});`}>
      <p class="text-xs uppercase tracking-[0.18em] text-white/70 font-medium mb-4">
        Coming soon
      </p>
      <h2 class="text-3xl md:text-5xl font-black tracking-tight text-white leading-[1.15] mb-6">
        Get tonight's<br/>first question?
      </h2>
      <p class="text-white/80 text-base md:text-lg max-w-xl mx-auto mb-8 leading-relaxed">
        Round up 7 close friends and start. We'll email you the day Pickie hits the App Store.
      </p>
      <a href="mailto:eastnoise26@gmail.com?subject=Pickie%20launch%20notification" class="magnet-cta cta-glow-pickie inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white text-sm font-bold hover:scale-105 transition-transform min-h-[48px]" style={`color: ${accent}`}>
        Notify me at launch →
      </a>
    </div>
  </section>

  <!-- Legal links -->
  <section class="max-w-5xl mx-auto w-full px-6 pb-16">
    <div class="flex flex-wrap gap-6 reveal">
      <a href="/en/legal/pickie/terms" class="text-sm font-medium hover:opacity-60 transition-opacity inline-flex items-center min-h-[44px]">
        Terms of service →
      </a>
      <a href="/en/legal/pickie/privacy" class="text-sm font-medium hover:opacity-60 transition-opacity inline-flex items-center min-h-[44px]">
        Privacy policy →
      </a>
      <a href="/en/" class="text-sm font-medium text-[--color-muted] hover:text-[--color-fg] transition-colors inline-flex items-center min-h-[44px]">
        ← East Noise home
      </a>
    </div>
  </section>

  <script is:inline>
    (() => {
      if (typeof window === 'undefined') return;

      // 1. Reveal on scroll
      const targets = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-in'));
      }

      // 2. Scroll progress bar
      const bar = document.getElementById('scroll-progress');
      if (bar) {
        const update = () => {
          const h = document.documentElement;
          const scrolled = h.scrollTop / (h.scrollHeight - h.clientHeight);
          bar.style.width = (Math.min(Math.max(scrolled, 0), 1) * 100) + '%';
        };
        window.addEventListener('scroll', update, { passive: true });
        update();
      }

      // 3. Sticky scroll storytelling — 5 stages
      const story = document.getElementById('story');
      if (story) {
        const stages = story.querySelectorAll('.story-stage');
        const dots = story.querySelectorAll('.story-dot');
        const stageCount = 5;
        const updateStory = () => {
          const rect = story.getBoundingClientRect();
          const totalScroll = story.offsetHeight - window.innerHeight;
          const scrolled = Math.min(Math.max(-rect.top, 0), totalScroll);
          const progress = totalScroll > 0 ? scrolled / totalScroll : 0;
          const activeIdx = Math.min(Math.floor(progress * stageCount), stageCount - 1);
          stages.forEach((el) => {
            const idx = parseInt(el.getAttribute('data-stage') || '0', 10);
            if (idx === activeIdx) {
              el.classList.add('story-active');
              el.classList.remove('story-hidden');
            } else {
              el.classList.remove('story-active');
              el.classList.add('story-hidden');
            }
          });
          dots.forEach((dot, i) => {
            if (i <= activeIdx) {
              dot.style.backgroundColor = '#7B5BFF';
              dot.classList.remove('bg-neutral-300');
            } else {
              dot.style.backgroundColor = '';
              dot.classList.add('bg-neutral-300');
            }
          });
        };
        let raf = 0;
        const onScroll = () => {
          if (raf) return;
          raf = requestAnimationFrame(() => { raf = 0; updateStory(); });
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        updateStory();
      }

      // 4. Mouse 3D tilt on hero phone
      const tiltEl = document.getElementById('hero-tilt');
      if (tiltEl && window.matchMedia('(pointer: fine)').matches) {
        const parent = tiltEl.parentElement;
        parent.addEventListener('mousemove', (e) => {
          const rect = tiltEl.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          const dx = (e.clientX - cx) / rect.width;
          const dy = (e.clientY - cy) / rect.height;
          const ry = dx * 14;
          const rx = -dy * 14;
          tiltEl.style.transform = `perspective(900px) rotateX(${rx}deg) rotateY(${ry}deg)`;
        });
        parent.addEventListener('mouseleave', () => {
          tiltEl.style.transform = '';
        });
      }

      // 5. Magnetic CTA
      document.querySelectorAll('.magnet-cta').forEach((btn) => {
        if (!window.matchMedia('(pointer: fine)').matches) return;
        btn.addEventListener('mousemove', (e) => {
          const rect = btn.getBoundingClientRect();
          const x = e.clientX - (rect.left + rect.width / 2);
          const y = e.clientY - (rect.top + rect.height / 2);
          btn.style.transform = `translate(${x * 0.25}px, ${y * 0.25}px)`;
        });
        btn.addEventListener('mouseleave', () => {
          btn.style.transform = '';
        });
      });
    })();
  </script>
</Layout>
