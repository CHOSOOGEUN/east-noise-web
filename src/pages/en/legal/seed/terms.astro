---
import Layout from '../../../../layouts/Layout.astro';
import LegalDoc from '../../../../components/LegalDoc.astro';

const sections = [
  {
    heading: '1. Who can use Seed',
    body: 'You must be at least 14 years old. One person per account. By creating an account you confirm that your information is accurate.',
  },
  {
    heading: '2. How the app works',
    body: "Seed is a solo self-care app where you log each daily routine with a short video clip. As you log routines, a virtual plant grows through stages, and you earn coins to unlock other species in the shop. Your check-in videos and plant state stay inside your own account and are not shared with anyone else.",
  },
  {
    heading: '3. Your content',
    body: 'Your check-in clips, nickname, plant name, and routine settings are visible only to you. We do not use your content for marketing or external display, and we do not access your video content unless you explicitly ask us to.',
  },
  {
    heading: '4. Rules of conduct',
    body: 'Uploading content that identifies other people, explicit material, or violent / illegal content is prohibited. Violating accounts may be suspended or deleted without prior notice. Reports and questions can be sent to the email below.',
  },
  {
    heading: '5. In-app purchases',
    body: 'Seed currently has no in-app purchases — coins are earned only through daily check-ins. If purchases are added later, you will always see the price and a confirmation before any charge, and these terms will be updated accordingly.',
  },
  {
    heading: '6. Deleting your account',
    body: 'You can delete your account at any time from the in-app settings. Deletion removes your profile, routines, check-in videos, and plant state. For follow-up questions, email us from the address linked to your account.',
  },
  {
    heading: '7. Disclaimer',
    body: 'Seed is provided as-is without warranties. The plant stages, coins, and check-in records are a motivational visualisation for self-care and are not a substitute for medical or psychological advice.',
  },
  {
    heading: '8. Changes',
    body: 'We may update these terms from time to time. Significant changes will be announced in-app. Continued use after changes means you accept the new terms.',
  },
];
---

<Layout locale="en">
  <LegalDoc
    kicker="SEED · LEGAL"
    title="Terms of Service"
    lastUpdated="Last updated May 24, 2026"
    contactEmail="eastnoise26@gmail.com"
    contactLabel="Questions?"
    sections={sections}
  />
</Layout>
