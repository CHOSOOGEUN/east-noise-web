---
import Layout from '../../../../layouts/Layout.astro';
import LegalDoc from '../../../../components/LegalDoc.astro';

const sections = [
  {
    heading: '1. Who can use Seed',
    body: 'You must be at least 14 years old. One person per account. By creating an account you confirm that your information is accurate.',
  },
  {
    heading: '2. How the app works',
    body: 'Seed is a solo routine app where you verify routines with short video check-ins and grow a virtual plant as records accumulate. A season runs for 30 days. Completing a plant lets you choose another plant for the next season. Your records and plant state stay in your own account and are not automatically shared with other users.',
  },
  {
    heading: '3. Your content',
    body: 'Your check-in clips, plant name, routine settings, and Daily Stories are visible only to you. We do not use your content for marketing or external display. When you explicitly share a video, the selected third-party app applies its own terms and privacy policy. You are responsible for not recording or sharing content that violates another person’s privacy or rights.',
  },
  {
    heading: '4. Rules of conduct',
    body: 'Uploading content that identifies other people, explicit material, or violent / illegal content is prohibited. Violating accounts may be suspended or deleted without prior notice. Reports and questions can be sent to the email below.',
  },
  {
    heading: '5. Seed Plus and billing',
    body: 'Seed Plus may be offered as monthly or yearly auto-renewing subscriptions and as a non-renewing lifetime purchase. The price, billing period, trial eligibility, and trial end shown in the Apple App Store or Google Play purchase confirmation are controlling. An auto-renewing subscription renews unless you cancel it in your store account settings. You retain Plus through the paid period after cancellation. Restore purchases with the same store account and Seed account. Refunds follow the relevant store policy and applicable law.',
  },
  {
    heading: '6. Storage and Plus expiration',
    body: 'Individual source clips stay on your device by default and can disappear if you delete the app or device storage is cleared. Cloud Daily Stories stored with Seed Plus may be deleted after a 30-day recovery grace period following subscription expiration. Canceling a subscription is different from deleting your Seed account. Deleting Seed may not cancel store auto-renewal, so check subscription management in your store as well.',
  },
  {
    heading: '7. Deleting your account',
    body: 'You can delete your Seed account at any time from in-app Settings. Deletion starts removal of the linked profile, routines, records, plant state, and cloud video. For follow-up questions, email us from the address linked to your account.',
  },
  {
    heading: '8. Disclaimer',
    body: 'We work to keep Seed reliable, but device storage, network conditions, operating systems, and external payment or authentication services can delay or limit features outside our control. Plant growth, check-in records, and pattern insights are motivational tools and are not medical or psychological diagnosis or treatment.',
  },
  {
    heading: '9. Changes',
    body: 'We may update these terms from time to time. Significant changes will be announced in-app. Continued use after changes means you accept the new terms.',
  },
];
---

<Layout locale="en">
  <LegalDoc
    kicker="SEED · LEGAL"
    title="Terms of Service"
    lastUpdated="Last updated July 20, 2026"
    contactEmail="eastnoise26@gmail.com"
    contactLabel="Questions?"
    sections={sections}
  />
</Layout>
