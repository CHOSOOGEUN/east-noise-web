---
import Layout from '../../layouts/Layout.astro';

const accent = '#22A06B';
const heroSubtitle = 'Today,\nyou grew.';

const steps = [
  {
    title: 'Name the plant',
    body: 'The plant\'s name is your name in Seed. Pick one of 8 species — your daily companion.',
    image: '/screenshots/seed/01-profile.png',
  },
  {
    title: 'One seed, four things',
    body: 'Short video check-ins · the plant grows · coins unlock species · a daily reel. All in one app.',
    image: '/screenshots/seed/02-onboarding.png',
  },
  {
    title: 'Check in, one clip',
    body: 'Tap "Record" on a routine. 2-4 seconds is enough. Sweat after a workout, a hand on a page, eyes after meditation.',
    image: '/screenshots/seed/03-today.png',
  },
  {
    title: 'See your discipline grow',
    body: 'Every streak day levels up the plant. Your daily wins, visualized. Even if you break the streak, the highest stage stays.',
    image: '/screenshots/seed/04-plant.png',
  },
  {
    title: 'Saved to your Photos',
    body: 'Next morning, yesterday\'s clips merge into one reel — auto-saved to the "Seed" album. The History tab shows them like a Stories archive.',
    image: '/screenshots/seed/05-history.png',
  },
];

const features = [
  {
    title: 'One clip is enough',
    body: 'No production. Sweat after a workout, a hand on a page, eyes after meditation — 2-4 seconds does it.',
  },
  {
    title: 'Discipline you can see',
    body: 'Each check-in grows the plant. Your daily wins show up on screen. Once a stage is reached, it stays — forever.',
  },
  {
    title: 'Stories-ready, automatic',
    body: 'Next morning, yesterday\'s clips merge into one reel and save to your Photos album. Post to Stories or Reels as-is.',
  },
];

const faq = [
  {
    q: 'Where do my videos go?',
    a: 'Only your phone. Nothing uploads to our servers. Want to show off? Share to Stories yourself.',
  },
  {
    q: 'Does the plant die if I skip?',
    a: 'Never. The highest stage you reached is preserved forever. Discipline allows rest days too.',
  },
  {
    q: 'How much?',
    a: 'Free. 6 of 8 species unlock with in-app coins — earned just by checking in and keeping streaks.',
  },
];

const species = [
  'Dandelion', 'Sunflower', 'Tulip', 'Rose', 'Cactus', 'Monstera', 'Bamboo', 'Cherry blossom',
];

const stages = ['Seed', 'Sprout', 'Young leaf', 'Grown leaf', 'Bud', 'Flower', 'Tree'];
---

<Layout locale="en" title="Seed. — Discipline, as a plant." description="Verify your daily routines with one short clip. The plant grows. Next morning, yesterday's clips merge into one reel — ready for Stories." path="/en/seed">
  <!-- Hero -->
  <section class="bg-seed-ambient">
    <div class="max-w-5xl mx-auto w-full px-6 pt-16 md:pt-28 pb-20 grid grid-cols-1 md:grid-cols-[1.2fr_1fr] gap-10 md:gap-16 items-center">
      <div>
        <div class="flex items-center gap-2 mb-6 reveal">
          <span class="inline-block w-2 h-2 rounded-full pulse-dot" style={`background-color: ${accent}`}></span>
          <p class="text-xs uppercase tracking-[0.18em] text-[--color-muted] font-medium">
            Indie App · East Noise
          </p>
        </div>
        <h1 class="text-5xl md:text-7xl font-black tracking-tight leading-[1.05] mb-6 reveal" data-delay="100">
          Seed<span style={`color: ${accent}`}>.</span>
        </h1>
        <p class="text-2xl md:text-4xl font-black tracking-tight leading-[1.15] mb-8 whitespace-pre-line reveal" data-delay="200">
          {heroSubtitle}
        </p>
        <p class="text-base md:text-lg text-[--color-muted] max-w-2xl leading-relaxed mb-10 reveal" data-delay="300">
          Workouts, reading, meditation — verify your routine with one short video. The plant grows daily. Next morning, yesterday's clips auto-merge into your Photos album. Stories or Reels, drop them in as-is.
        </p>
        <div class="flex flex-wrap items-center gap-3 reveal" data-delay="400">
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium text-white" style={`background-color: ${accent}`}>
            Coming soon
          </span>
          <a href="mailto:eastnoise26@gmail.com?subject=Notify%20me%20when%20Seed%20launches" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[--color-border] bg-white text-sm font-semibold hover:border-[--color-fg] transition-colors min-h-[44px]">
            Tell me when it launches →
          </a>
        </div>
      </div>

      <div class="reveal flex justify-center md:justify-end" data-delay="200">
        <div class="relative w-64 h-64 md:w-80 md:h-80 rounded-full flex items-center justify-center" style={`background: radial-gradient(circle, rgba(34,160,107,0.12), transparent 70%)`}>
          <svg viewBox="0 0 100 130" class="w-3/4 h-3/4">
            <path d="M28 110 L72 110 L68 125 L32 125 Z" fill="#9ca3af" opacity="0.25"/>
            <path d="M50 110 L50 55" stroke={accent} stroke-width="3.5" stroke-linecap="round"/>
            <ellipse class="plant-leaf-l" cx="38" cy="65" rx="14" ry="6" fill={accent} opacity="0.9"/>
            <ellipse class="plant-leaf-r" cx="62" cy="65" rx="14" ry="6" fill={accent} opacity="0.9"/>
            <ellipse class="plant-leaf-l2" cx="42" cy="50" rx="11" ry="5" fill={accent} opacity="0.85"/>
            <ellipse class="plant-leaf-r2" cx="58" cy="50" rx="11" ry="5" fill={accent} opacity="0.85"/>
            <ellipse cx="50" cy="32" rx="10" ry="14" fill={accent} opacity="0.95"/>
            <ellipse cx="46" cy="28" rx="4" ry="6" fill="#fff" opacity="0.5"/>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="max-w-5xl mx-auto w-full px-6 py-20 border-t border-[--color-border]">
    <h2 class="text-2xl md:text-4xl font-black tracking-tight leading-tight mb-12 reveal">
      One clip a day.<br/>
      <span style={`color: ${accent}`}>Plant</span> grows.<br/>
      <span class="text-[--color-muted]">Reel saved.</span>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {features.map((f, i) => (
        <article class="lift reveal bg-white p-8 rounded-2xl border border-[--color-border]" data-delay={String((i + 1) * 100)}>
          <div class="text-3xl font-black tracking-tight mb-4" style={`color: ${accent}`}>
            {String(i + 1).padStart(2, '0')}
          </div>
          <h3 class="text-lg font-bold tracking-tight mb-3">
            {f.title}
          </h3>
          <p class="text-sm text-[--color-muted] leading-relaxed">
            {f.body}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- How to use -->
  <section class="max-w-6xl mx-auto w-full px-6 py-20 border-t border-[--color-border]">
    <p class="text-xs uppercase tracking-[0.18em] text-[--color-muted] font-medium mb-3 reveal">
      Flow
    </p>
    <h2 class="text-2xl md:text-4xl font-black tracking-tight leading-tight mb-12 reveal" data-delay="100">
      From first open, this is how it flows.
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      {steps.map((s, i) => (
        <article class="lift reveal flex flex-col" data-delay={String((i + 1) * 80)}>
          <div class="mb-4 relative">
            <div class="aspect-[9/19.5] rounded-[28px] overflow-hidden border border-neutral-200 bg-white shadow-sm">
              <img src={s.image} alt={s.title} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <span class="absolute -top-2 -left-2 w-8 h-8 rounded-full flex items-center justify-center text-xs font-black text-white shadow-md" style={`background-color: ${accent}`}>
              {i + 1}
            </span>
          </div>
          <h3 class="text-sm font-bold tracking-tight mb-2 px-1">
            {s.title}
          </h3>
          <p class="text-xs text-[--color-muted] leading-relaxed px-1">
            {s.body}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- Stages -->
  <section class="max-w-5xl mx-auto w-full px-6 py-20 border-t border-[--color-border]">
    <p class="text-xs uppercase tracking-[0.18em] text-[--color-muted] font-medium mb-3 reveal">
      Stages
    </p>
    <h2 class="text-2xl md:text-4xl font-black tracking-tight leading-tight mb-12 reveal" data-delay="100">
      From a seed to a <span style={`color: ${accent}`}>tree</span>,<br/>
      in 7 stages.
    </h2>

    <div class="relative">
      <div class="absolute left-0 right-0 top-5 h-px hidden sm:block" style={`background-color: ${accent}; opacity: 0.2`}></div>
      <div class="grid grid-cols-7 gap-2 relative">
        {stages.map((label, i) => (
          <div class="flex flex-col items-center reveal" data-delay={String((i + 1) * 60)}>
            <span class="w-10 h-10 rounded-full flex items-center justify-center text-xs font-black mb-3 transition-transform hover:scale-110" style={`background-color: ${i === stages.length - 1 ? accent : '#E8F5EE'}; color: ${i === stages.length - 1 ? '#fff' : accent}`}>
              {i + 1}
            </span>
            <span class="text-[10px] md:text-xs font-bold tracking-tight text-center" style={i === stages.length - 1 ? `color: ${accent}` : ''}>
              {label}
            </span>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-3">
      {[
        { d: 'Day 1', t: 'Sprout' },
        { d: 'Day 3', t: 'Young leaf' },
        { d: 'Day 7', t: 'Grown leaf + bonus' },
        { d: 'Day 14', t: 'Bud + bonus' },
      ].map((m, i) => (
        <div class="lift reveal bg-white rounded-2xl p-4 border border-[--color-border]" data-delay={String((i + 1) * 80)}>
          <div class="text-2xl font-black tracking-tight" style={`color: ${accent}`}>{m.d}</div>
          <div class="text-xs text-[--color-muted] font-medium mt-1">{m.t}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- 8 species marquee -->
  <section class="py-20 border-t border-[--color-border] overflow-hidden">
    <div class="max-w-5xl mx-auto px-6">
      <p class="text-xs uppercase tracking-[0.18em] text-[--color-muted] font-medium mb-3 reveal">
        8 Species
      </p>
      <h2 class="text-2xl md:text-4xl font-black tracking-tight leading-tight mb-2 reveal" data-delay="100">
        Which one starts your day?
      </h2>
      <p class="text-sm text-[--color-muted] mb-10 reveal" data-delay="200">
        2 are free; 6 unlock with coins — just from check-ins and streaks.
      </p>
    </div>
    <div class="marquee-track">
      {[...species, ...species].map((name) => (
        <div class="flex items-center gap-3 px-8 py-4 mr-3 rounded-full border border-[--color-border] bg-white whitespace-nowrap">
          <span class="w-2.5 h-2.5 rounded-full" style={`background-color: ${accent}`}></span>
          <span class="text-base font-bold tracking-tight">{name}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-5xl mx-auto w-full px-6 py-20 border-t border-[--color-border]">
    <p class="text-xs uppercase tracking-[0.18em] text-[--color-muted] font-medium mb-3 reveal">
      FAQ
    </p>
    <h2 class="text-2xl md:text-4xl font-black tracking-tight leading-tight mb-12 reveal" data-delay="100">
      What you might wonder.
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {faq.map((item, i) => (
        <article class="lift reveal bg-white rounded-2xl border border-[--color-border] p-8" data-delay={String((i + 1) * 100)}>
          <h3 class="text-base font-bold tracking-tight mb-3">
            {item.q}
          </h3>
          <p class="text-sm text-[--color-muted] leading-relaxed">
            {item.a}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- Final CTA -->
  <section class="max-w-5xl mx-auto w-full px-6 py-24 border-t border-[--color-border]">
    <div class="reveal rounded-3xl p-10 md:p-16 text-center" style={`background: linear-gradient(135deg, ${accent}, #1a8054)`}>
      <p class="text-xs uppercase tracking-[0.18em] text-white/70 font-medium mb-4">
        Coming soon
      </p>
      <h2 class="text-3xl md:text-5xl font-black tracking-tight text-white leading-[1.15] mb-6">
        Ready to grow one?
      </h2>
      <p class="text-white/80 text-base md:text-lg max-w-xl mx-auto mb-8 leading-relaxed">
        One clip a day is enough. We'll let you know the moment it launches.
      </p>
      <a href="mailto:eastnoise26@gmail.com?subject=Notify%20me%20when%20Seed%20launches" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white text-sm font-bold hover:scale-105 transition-transform min-h-[48px]" style={`color: ${accent}`}>
        Notify me on launch →
      </a>
    </div>
  </section>

  <!-- Legal links -->
  <section class="max-w-5xl mx-auto w-full px-6 pb-16">
    <div class="flex flex-wrap gap-6 reveal">
      <a href="/en/legal/seed/terms" class="text-sm font-medium hover:opacity-60 transition-opacity inline-flex items-center min-h-[44px]">
        Terms of Service →
      </a>
      <a href="/en/legal/seed/privacy" class="text-sm font-medium hover:opacity-60 transition-opacity inline-flex items-center min-h-[44px]">
        Privacy Policy →
      </a>
      <a href="/en/" class="text-sm font-medium text-[--color-muted] hover:text-[--color-fg] transition-colors inline-flex items-center min-h-[44px]">
        ← East Noise home
      </a>
    </div>
  </section>

  <script is:inline>
    (() => {
      if (typeof window === 'undefined') return;
      const targets = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-in'));
        return;
      }
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
      targets.forEach((el) => io.observe(el));
    })();
  </script>
</Layout>
