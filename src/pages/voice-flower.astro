---
import Layout from '../layouts/Layout.astro';
import ProductWorldPage from '../components/ProductWorldPage.astro';
---

<Layout
  locale="ko"
  chrome="none"
  title="우리의 꽃 — 목소리로 함께 키우는 커플 정원"
  description="두 사람이 하루 한 번씩 목소리를 남기고, 둘의 기록으로 꽃과 정원을 함께 키우는 커플 앱입니다."
  path="/voice-flower"
  themeColor="#bfe6f2"
  ogImage="/visuals/company/voice-flower/home.png"
  ogImageAlt="목소리로 함께 꽃을 키우는 우리의 꽃 홈 화면"
>
  <ProductWorldPage locale="ko" slug="voice-flower" />
</Layout>
