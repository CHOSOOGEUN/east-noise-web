---
type PageType = 'privacy' | 'terms' | 'delete' | 'support';

interface Section {
  title: string;
  body: string;
}

interface Props {
  page: PageType;
  title: string;
  lead: string;
  sections: Section[];
}

const { page, title, lead, sections } = Astro.props;
const labels: Record<PageType, string> = {
  privacy: '개인정보 처리방침',
  terms: '이용약관',
  delete: '계정 및 데이터 삭제',
  support: '고객지원',
};
---

<main class="uriday-info">
  <nav aria-label="우리데이 문서">
    <a class="brand" href="/uriday/support" aria-label="우리데이 고객지원 홈">
      <img src="/visuals/uriday/mark.png" width="34" height="34" alt="" />
      <strong>우리데이</strong>
    </a>
    <div class="nav-links">
      <a aria-current={page === 'support' ? 'page' : undefined} href="/uriday/support">지원</a>
      <a aria-current={page === 'privacy' ? 'page' : undefined} href="/legal/uriday/privacy">개인정보</a>
      <a aria-current={page === 'terms' ? 'page' : undefined} href="/legal/uriday/terms">이용약관</a>
    </div>
  </nav>

  <header>
    <p class="eyebrow">우리 둘의 일정과 일기를 하나로</p>
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
    <div class="meta">
      <span>{labels[page]}</span>
      <span>2026년 9월 28일 시행</span>
    </div>
  </header>

  <article>
    {sections.map((section, index) => (
      <section id={`section-${index + 1}`}>
        <span class="number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <div>
          <h2>{section.title}</h2>
          <p>{section.body}</p>
        </div>
      </section>
    ))}
  </article>

  <aside class="contact" aria-label="우리데이 문의">
    <div>
      <p>더 필요한 도움이 있나요?</p>
      <h2>상황을 구체적으로 알려 주세요.</h2>
      <span>앱 버전, 기기·OS, 문제가 생긴 화면을 적어 주시면 더 빠르게 확인할 수 있어요. 비밀번호·인증 코드·결제 카드번호·사적인 일기 원문은 보내지 마세요.</span>
    </div>
    <a href="mailto:eastnoise26@gmail.com?subject=%EC%9A%B0%EB%A6%AC%EB%8D%B0%EC%9D%B4%20%EB%AC%B8%EC%9D%98">이메일로 문의하기</a>
  </aside>

  <footer>
    <div><strong>동방의 소음</strong><span>대표 조수근</span></div>
    <a href="mailto:eastnoise26@gmail.com">eastnoise26@gmail.com</a>
    {page !== 'delete' && <a href="/legal/uriday/delete-account">계정 삭제 안내</a>}
  </footer>
</main>

<style>
  .uriday-info {
    --blue: #2477f3;
    --blue-deep: #0c52c9;
    --ink: #0b1528;
    --secondary: #667085;
    --canvas: #fbfaf7;
    --surface: rgba(255, 255, 255, 0.82);
    --line: rgba(20, 44, 82, 0.1);
    min-height: 100vh;
    color: var(--ink);
    background:
      radial-gradient(circle at 78% 5%, rgba(36, 119, 243, 0.11), transparent 25rem),
      radial-gradient(circle at 15% 42%, rgba(255, 222, 196, 0.28), transparent 28rem),
      var(--canvas);
    font-family: Pretendard Variable, Pretendard, -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
  }

  nav, header, article, .contact, footer {
    width: min(calc(100% - 40px), 1024px);
    margin-inline: auto;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76px;
    gap: 20px;
  }

  a { color: inherit; text-decoration: none; }

  .brand { display: inline-flex; align-items: center; gap: 9px; font-size: 1.05rem; }
  .brand img {
    display: block;
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  .nav-links { display: flex; align-items: center; gap: 8px; }
  .nav-links a {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    padding: 0 12px;
    border-radius: 14px;
    color: var(--secondary);
    font-size: 0.88rem;
    font-weight: 600;
  }
  .nav-links a[aria-current='page'] { color: var(--blue-deep); background: rgba(36, 119, 243, 0.09); }

  header { padding: clamp(5rem, 12vw, 9rem) 0 clamp(4rem, 8vw, 7rem); }
  .eyebrow { margin: 0 0 18px; color: var(--blue-deep); font-size: 0.9rem; font-weight: 720; }
  h1 {
    max-width: 780px;
    margin: 0;
    font-size: clamp(3rem, 8vw, 6.8rem);
    line-height: 0.98;
    letter-spacing: -0.065em;
  }
  .lead {
    max-width: 660px;
    margin: 30px 0 42px;
    color: #3c4c64;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.72;
  }
  .meta { display: flex; flex-wrap: wrap; gap: 10px; }
  .meta span {
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.58);
    color: var(--secondary);
    font-size: 0.82rem;
    font-weight: 600;
  }

  article {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.92);
    border-radius: 36px;
    background: var(--surface);
    box-shadow: 0 28px 80px rgba(33, 51, 79, 0.09);
    backdrop-filter: blur(20px) saturate(130%);
  }
  article section {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 24px;
    padding: clamp(28px, 5vw, 54px);
    border-bottom: 1px solid var(--line);
  }
  article section:last-child { border-bottom: 0; }
  .number { padding-top: 5px; color: var(--blue); font-size: 0.78rem; font-weight: 750; letter-spacing: 0.08em; }
  h2 { margin: 0 0 15px; font-size: clamp(1.35rem, 2.5vw, 1.85rem); line-height: 1.3; letter-spacing: -0.035em; }
  article p { margin: 0; color: #435067; font-size: 1rem; line-height: 1.9; white-space: pre-line; }

  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 32px;
    margin-top: 28px;
    padding: clamp(30px, 5vw, 56px);
    border-radius: 36px;
    color: white;
    background: linear-gradient(140deg, #135fd8, #3186ff);
    box-shadow: 0 24px 60px rgba(36, 119, 243, 0.22);
  }
  .contact p { margin: 0 0 10px; color: rgba(255,255,255,.76); font-size: .84rem; font-weight: 650; }
  .contact h2 { margin-bottom: 14px; }
  .contact span { display: block; max-width: 620px; color: rgba(255,255,255,.78); line-height: 1.72; }
  .contact a {
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    border-radius: 17px;
    color: var(--blue-deep);
    background: white;
    font-weight: 740;
    white-space: nowrap;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    padding: 54px 0 64px;
    color: var(--secondary);
    font-size: .85rem;
  }
  footer div { display: flex; gap: 12px; margin-right: auto; }
  footer strong { color: var(--ink); }
  footer a { text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 680px) {
    nav { align-items: flex-start; padding-top: 18px; }
    .nav-links { gap: 2px; overflow-x: auto; }
    .nav-links a { padding-inline: 9px; font-size: .78rem; white-space: nowrap; }
    .brand strong { display: none; }
    header { padding-top: 4.5rem; }
    article { border-radius: 28px; }
    article section { grid-template-columns: 1fr; gap: 9px; }
    .number { padding-top: 0; }
    .contact { grid-template-columns: 1fr; align-items: start; border-radius: 28px; }
    .contact a { width: 100%; }
    footer { align-items: flex-start; flex-direction: column; gap: 14px; }
    footer div { margin-right: 0; }
  }

  @media (prefers-reduced-transparency: reduce) {
    article { background: #ffffff; backdrop-filter: none; }
  }

  @media (prefers-contrast: more) {
    article, .meta span { border-color: rgba(11, 21, 40, 0.55); }
    article p, .lead { color: #1a2535; }
  }
</style>
