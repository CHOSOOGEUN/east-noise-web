---
interface Section {
  heading: string;
  body: string;
}

interface Props {
  kicker: string;
  title: string;
  lastUpdated: string;
  contactEmail: string;
  contactLabel: string;
  sections: Section[];
}

const { kicker, title, lastUpdated, contactEmail, contactLabel, sections } = Astro.props;
---

<article class="legal-page">
  <header class="legal-hero">
    <p>{kicker}</p>
    <h1>{title}</h1>
    <span>{lastUpdated}</span>
  </header>

  <div class="legal-body">
    <div class="legal-index" aria-hidden="true">
      <span>Document</span>
      <strong>{String(sections.length).padStart(2, '0')} sections</strong>
    </div>

    <div class="legal-sections">
      {sections.map((section, index) => (
        <section id={`s-${index + 1}`} class="legal-section reveal" data-reveal>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h2>{section.heading.replace(/^\d+\.\s*/, '')}</h2>
            <p>{section.body}</p>
          </div>
        </section>
      ))}
    </div>
  </div>

  <section class="legal-contact">
    <p>{contactLabel}</p>
    <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
  </section>
</article>

<script>
  const sections = document.querySelectorAll<HTMLElement>('.legal-page [data-reveal]');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      entry.target.classList.add('is-visible');
      observer.unobserve(entry.target);
    });
  }, { threshold: 0.12 });
  sections.forEach((section) => observer.observe(section));
</script>

<style>
  .legal-page {
    --ink: #0a0a0a;
    --night: #050505;
    --paper: #efede7;
    --signal: #ff7448;
    --line: rgba(10, 10, 10, 0.18);
    color: var(--ink);
    background: var(--paper);
  }

  .legal-hero {
    min-height: 32rem;
    padding: 7rem 6.7vw 5rem;
    background:
      linear-gradient(90deg, rgba(5,5,5,.98) 0%, rgba(5,5,5,.86) 46%, rgba(5,5,5,.28) 100%),
      url('/visuals/company/east-noise-signal-hero.webp') 78% center / cover no-repeat,
      var(--night);
    color: #f4f2ec;
  }

  .legal-hero p,
  .legal-hero span {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: rgba(226, 234, 242, 0.62);
  }

  .legal-hero h1 {
    max-width: 64rem;
    margin: 3.5rem 0 3rem;
    font-size: clamp(3.7rem, 7vw, 7.4rem);
    font-weight: 800;
    line-height: 0.96;
    letter-spacing: -0.075em;
  }

  .legal-body {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: 4rem;
    width: min(100%, 1440px);
    margin: 0 auto;
    padding: 8rem 6.7vw 10rem;
  }

  .legal-index {
    position: sticky;
    top: 8rem;
    align-self: start;
  }

  .legal-index span,
  .legal-index strong {
    display: block;
    font-size: 0.75rem;
  }

  .legal-index span {
    margin-bottom: 0.7rem;
    color: #707070;
    text-transform: uppercase;
  }

  .legal-section {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 2rem;
    padding: 0 0 4rem;
    margin-bottom: 4rem;
    border-bottom: 1px solid var(--line);
  }

  .legal-section > span {
    color: var(--signal);
    font-size: 0.78rem;
  }

  .legal-section h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(1.65rem, 2.7vw, 2.5rem);
    font-weight: 740;
    line-height: 1.25;
  }

  .legal-section p {
    margin: 0;
    color: #444444;
    font-size: 0.98rem;
    line-height: 1.85;
    white-space: pre-line;
  }

  .legal-contact {
    padding: 6rem 6.7vw;
    background:
      linear-gradient(90deg, rgba(5,5,5,.96), rgba(5,5,5,.7)),
      url('/visuals/company/east-noise-signal-hero.webp') 78% center / cover no-repeat,
      var(--night);
    color: #ffffff;
  }

  .legal-contact p {
    margin: 0 0 2rem;
    color: #a8a8a8;
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .legal-contact a {
    display: inline-block;
    max-width: 100%;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid currentColor;
    font-size: clamp(1.35rem, 3vw, 2.8rem);
    font-weight: 720;
    overflow-wrap: anywhere;
  }

  @media (max-width: 760px) {
    .legal-hero {
      min-height: 28rem;
      padding: 5.5rem 1.25rem 3.5rem;
      background-position: 66% center;
    }

    .legal-hero h1 {
      margin: 3rem 0 2.5rem;
      font-size: clamp(3.1rem, 14vw, 4.8rem);
    }

    .legal-body {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding: 4.5rem 1.25rem 5rem;
    }

    .legal-index {
      position: static;
    }

    .legal-section {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: 1rem;
      padding-bottom: 3rem;
      margin-bottom: 3rem;
    }

    .legal-section h2 {
      font-size: 1.55rem;
    }

    .legal-contact {
      padding: 4.5rem 1.25rem;
    }

    .legal-contact a {
      font-size: 1.3rem;
    }
  }
</style>
