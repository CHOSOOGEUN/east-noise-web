---
import AuroraOrb from './AuroraOrb.astro';

interface Section {
  heading: string;
  body: string;
}

interface Props {
  kicker: string;
  title: string;
  lastUpdated: string;
  contactEmail: string;
  contactLabel: string;
  sections: Section[];
}

const { kicker, title, lastUpdated, contactEmail, contactLabel, sections } = Astro.props;
---

<article class="relative">
  <!-- Hero with subtle aurora -->
  <header class="relative overflow-hidden border-b border-[--color-border]">
    <div class="legal-aurora">
      <AuroraOrb />
    </div>

    <div class="relative z-10 max-w-3xl mx-auto px-6 pt-20 md:pt-28 pb-16 md:pb-24">
      <p class="legal-kicker text-[10px] uppercase tracking-[0.22em] text-[--color-muted] font-medium mb-6 inline-flex items-center gap-2">
        <span class="legal-kicker-bar"></span>
        <span>{kicker}</span>
      </p>

      <h1 class="legal-title font-bold tracking-[-0.03em] leading-[1.02]">
        {Array.from(title).map((ch, ci) => (
          <span class="legal-char" style={`--ci: ${ci};`}>{ch === ' ' ? ' ' : ch}</span>
        ))}
      </h1>

      <p class="legal-updated mt-6 text-xs text-[--color-muted] tabular-nums">
        {lastUpdated}
      </p>
    </div>
  </header>

  <!-- Body: 2-col with sticky TOC on desktop -->
  <div class="max-w-6xl mx-auto px-6 py-16 md:py-24 grid md:grid-cols-[1fr_280px] gap-12 md:gap-20">
    <div class="space-y-14 md:space-y-20 min-w-0">
      {
        sections.map((s, i) => (
          <section class="legal-section grid grid-cols-[auto_1fr] gap-6 md:gap-10" id={`s-${i + 1}`}>
            <div class="legal-num text-3xl md:text-4xl font-bold tabular-nums tracking-tight text-[--color-muted] select-none">
              {String(i + 1).padStart(2, '0')}
            </div>
            <div class="min-w-0">
              <h2 class="text-xl md:text-2xl font-bold tracking-tight mb-4 leading-snug">{s.heading.replace(/^\d+\.\s*/, '')}</h2>
              <p class="text-[15px] leading-[1.75] text-[--color-fg]/85 whitespace-pre-line">{s.body}</p>
            </div>
          </section>
        ))
      }
    </div>

    <!-- Sticky TOC (desktop only) -->
    <aside class="hidden md:block">
      <nav class="sticky top-24 text-xs space-y-1.5">
        <p class="text-[10px] uppercase tracking-[0.22em] text-[--color-muted] font-medium mb-4">목차</p>
        {sections.map((s, i) => (
          <a
            href={`#s-${i + 1}`}
            class="legal-toc-link block py-1.5 text-[--color-muted] hover:text-[--color-fg] transition-colors leading-snug"
          >
            <span class="tabular-nums text-[10px] mr-2 opacity-60">{String(i + 1).padStart(2, '0')}</span>
            <span>{s.heading.replace(/^\d+\.\s*/, '')}</span>
          </a>
        ))}
      </nav>
    </aside>
  </div>

  <!-- Contact card -->
  <section class="max-w-3xl mx-auto px-6 pb-24">
    <a
      href={`mailto:${contactEmail}`}
      class="legal-contact magnet relative block overflow-hidden border border-[--color-fg] p-6 md:p-8 group"
    >
      <div class="legal-contact-bg" aria-hidden="true"></div>
      <div class="relative z-10 magnet-inner">
        <p class="text-[10px] uppercase tracking-[0.22em] font-medium mb-2 legal-contact-label">{contactLabel}</p>
        <div class="flex items-baseline justify-between gap-4 flex-wrap">
          <span class="text-xl md:text-2xl font-semibold tracking-tight legal-contact-email">{contactEmail}</span>
          <span class="legal-contact-arrow inline-flex items-center gap-1 text-xs font-semibold tracking-tight">
            메일 보내기 <span class="legal-contact-arrow-mark">→</span>
          </span>
        </div>
      </div>
    </a>
  </section>
</article>

<style>
  /* Aurora behind hero — extra subtle */
  .legal-aurora :global(.aurora-wrap) { opacity: 0.7; }
  .legal-aurora :global(.orb) { filter: blur(110px); opacity: 0.45; }

  .legal-kicker-bar {
    display: inline-block;
    width: 24px;
    height: 1px;
    background: currentColor;
    transform-origin: left;
    animation: legal-bar 1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes legal-bar {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }
  .legal-kicker span:last-child {
    opacity: 0;
    animation: legal-fadeup 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
  }
  @keyframes legal-fadeup {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .legal-title {
    font-size: clamp(2.4rem, 6.5vw, 4.2rem);
  }
  .legal-char {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.4em) rotate(4deg);
    animation: legal-char-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(0.5s + (var(--ci) * 0.022s));
    transform-origin: bottom;
  }
  @keyframes legal-char-in {
    to { opacity: 1; transform: translateY(0) rotate(0); }
  }
  .legal-updated {
    opacity: 0;
    animation: legal-fadeup 0.9s cubic-bezier(0.16, 1, 0.3, 1) 1.2s both;
  }

  /* Sections — scroll-driven reveal */
  .legal-section {
    opacity: 0;
    transform: translateY(24px);
  }
  @supports (animation-timeline: view()) {
    .legal-section {
      animation: legal-rise both;
      animation-timeline: view();
      animation-range: entry 0% entry 60%;
    }
  }
  @keyframes legal-rise {
    to { opacity: 1; transform: translateY(0); }
  }

  /* TOC link — animated underline on hover */
  .legal-toc-link {
    position: relative;
  }
  .legal-toc-link::after {
    content: '';
    position: absolute;
    left: 22px;
    right: 8px;
    bottom: 4px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .legal-toc-link:hover::after { transform: scaleX(1); }

  /* Contact invert card */
  .legal-contact {
    transition: transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .legal-contact-bg {
    position: absolute;
    inset: 0;
    background: #18181b;
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .legal-contact:hover .legal-contact-bg { transform: scaleY(1); }
  .legal-contact-label,
  .legal-contact-email,
  .legal-contact-arrow {
    color: #18181b;
    transition: color 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .legal-contact:hover .legal-contact-label,
  .legal-contact:hover .legal-contact-email,
  .legal-contact:hover .legal-contact-arrow { color: #fafaf8; }
  .legal-contact-arrow-mark {
    display: inline-block;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .legal-contact:hover .legal-contact-arrow-mark { transform: translateX(6px); }

  @media (prefers-reduced-motion: reduce) {
    .legal-kicker-bar,
    .legal-kicker span:last-child,
    .legal-char,
    .legal-updated,
    .legal-section {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .legal-contact-bg { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    if (CSS.supports('animation-timeline: view()')) return;
    const els = document.querySelectorAll('.legal-section');
    if (!els.length) return;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
          entry.target.style.transition = 'opacity 800ms cubic-bezier(0.16, 1, 0.3, 1), transform 800ms cubic-bezier(0.16, 1, 0.3, 1)';
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    els.forEach((el) => io.observe(el));
  })();
</script>
