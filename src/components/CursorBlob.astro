<div id="cursor-blob" aria-hidden="true"></div>

<script is:inline>
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(hover: none), (pointer: coarse)').matches) return;

    const blob = document.getElementById('cursor-blob');
    if (!blob) return;

    let mx = window.innerWidth / 2;
    let my = window.innerHeight / 2;
    let x = mx, y = my;
    let scale = 1, targetScale = 1;
    let visible = false;

    function showBlob() {
      if (!visible) {
        blob.style.opacity = '1';
        visible = true;
      }
    }

    document.addEventListener('mousemove', (e) => {
      mx = e.clientX;
      my = e.clientY;
      showBlob();
    });

    document.addEventListener('mouseleave', () => {
      blob.style.opacity = '0';
      visible = false;
    });

    const HOVER_SELECTOR = 'a, button, [role="button"], .cursor-target';
    document.addEventListener('mouseover', (e) => {
      if (e.target instanceof Element && e.target.closest(HOVER_SELECTOR)) {
        targetScale = 2.8;
        blob.classList.add('is-hover');
      }
    });
    document.addEventListener('mouseout', (e) => {
      if (e.target instanceof Element && e.target.closest(HOVER_SELECTOR)) {
        targetScale = 1;
        blob.classList.remove('is-hover');
      }
    });

    function loop() {
      x += (mx - x) * 0.18;
      y += (my - y) * 0.18;
      scale += (targetScale - scale) * 0.22;
      blob.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%) scale(${scale})`;
      requestAnimationFrame(loop);
    }
    loop();
  })();
</script>

<style>
  #cursor-blob {
    position: fixed;
    top: 0;
    left: 0;
    width: 20px;
    height: 20px;
    background: #18181b;
    border-radius: 999px;
    pointer-events: none;
    z-index: 9999;
    mix-blend-mode: difference;
    opacity: 0;
    transition: opacity 200ms ease, background-color 200ms ease;
    will-change: transform;
  }
  #cursor-blob.is-hover {
    background: #fafaf8;
  }
  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    #cursor-blob { display: none !important; }
  }
</style>
