---
import { strings, type Locale } from '../i18n/strings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings[locale];
---

<section id="company" class="about-section" aria-labelledby="company-heading">
  <div class="max-w-6xl mx-auto w-full px-6">
    <div class="about-main">
      <div>
        <h2 id="company-heading">{t.about.heading}</h2>
        <p class="about-body">{t.about.body}</p>
      </div>

      <dl class="about-stats" aria-label={t.about.heading}>
        {t.about.stats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="team-strip" aria-label={locale === 'ko' ? '동방의 소음 팀' : 'East Noise team'}>
      {t.about.people.map((person) => (
        <div>
          <span>{person.role}</span>
          <strong>{person.name}</strong>
        </div>
      ))}
    </div>

    <div class="legal-block" aria-labelledby="legal-heading">
      <h3 id="legal-heading">{t.legal.heading}</h3>
      <dl class="legal-list">
        {t.legal.rows.map((row) => (
          <div>
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: 8rem 0 7rem;
    border-top: 1px solid var(--color-border);
    background:
      linear-gradient(180deg, #fff8ec 0%, #ffffff 54%);
  }

  .about-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.62fr);
    gap: 60px;
    align-items: end;
  }

  .about-main h2 {
    margin: 0;
    color: #130d08;
    font-size: 5.2rem;
    font-weight: 820;
    line-height: 1;
    letter-spacing: 0;
  }

  .about-body {
    max-width: 720px;
    margin: 30px 0 0;
    color: #4f3b2b;
    font-size: 2rem;
    font-weight: 650;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .about-stats {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid #130d08;
  }

  .about-stats div {
    display: grid;
    grid-template-columns: 0.52fr 1fr;
    gap: 16px;
    align-items: baseline;
    padding: 22px 0;
    border-bottom: 1px solid rgba(70, 38, 16, 0.18);
  }

  .about-stats dt,
  .legal-list dt {
    color: #7a5a40;
    font-size: 12px;
    font-weight: 720;
    letter-spacing: 0;
  }

  .about-stats dd {
    margin: 0;
    color: #130d08;
    font-size: 2.1rem;
    font-weight: 780;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .team-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 4.5rem;
    border-top: 1px solid #130d08;
    border-bottom: 1px solid rgba(70, 38, 16, 0.18);
    background: rgba(70, 38, 16, 0.16);
  }

  .team-strip div {
    min-height: 138px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 22px;
    background: rgba(255, 255, 255, 0.72);
  }

  .team-strip span {
    color: #7a5a40;
    font-size: 12px;
    font-weight: 720;
  }

  .team-strip strong {
    color: #130d08;
    font-size: 2.05rem;
    font-weight: 820;
    line-height: 1;
  }

  .legal-block {
    margin-top: 88px;
    border-top: 1px solid #130d08;
  }

  .legal-block h3 {
    margin: 0;
    padding: 22px 0;
    border-bottom: 1px solid rgba(70, 38, 16, 0.18);
    color: #130d08;
    font-size: 16px;
    font-weight: 780;
    letter-spacing: 0;
  }

  .legal-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 60px;
  }

  .legal-list div {
    display: grid;
    grid-template-columns: minmax(130px, 0.4fr) minmax(0, 1fr);
    gap: 24px;
    padding: 20px 0;
    border-bottom: 1px solid rgba(70, 38, 16, 0.12);
  }

  .legal-list dd {
    margin: 0;
    color: #130d08;
    font-size: 14px;
    font-weight: 650;
    line-height: 1.55;
    letter-spacing: 0;
  }

  @media (max-width: 860px) {
    .about-main,
    .legal-list {
      grid-template-columns: 1fr;
    }

    .about-main {
      gap: 42px;
    }

    .about-section {
      padding: 6rem 0 5.5rem;
    }

    .about-main h2 {
      font-size: 3.7rem;
    }

    .about-body {
      font-size: 1.55rem;
    }

    .team-strip {
      grid-template-columns: 1fr;
      margin-top: 3.5rem;
    }

    .legal-block {
      margin-top: 64px;
    }
  }

  @media (max-width: 560px) {
    .about-stats div,
    .legal-list div {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .about-main h2 {
      font-size: 3rem;
    }

    .about-body {
      font-size: 1.32rem;
    }
  }
</style>
