---
import { strings, type Locale } from '../i18n/strings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings[locale];
---

<section class="max-w-6xl mx-auto w-full px-6 py-24 md:py-32 border-t border-[--color-border]">
  <div class="grid md:grid-cols-2 gap-12 mb-20 about-reveal">
    <div>
      <h2 class="text-xs uppercase tracking-[0.22em] text-[--color-muted] font-medium mb-8">
        {t.about.heading}
      </h2>
      <p class="text-lg md:text-2xl leading-relaxed tracking-tight">
        {t.about.body}
      </p>
    </div>
    <dl class="grid grid-cols-3 gap-4 self-end">
      {t.about.stats.map((stat) => {
        const num = /^\d+$/.test(stat.value) ? parseInt(stat.value, 10) : NaN;
        // Only count up meaningful small numbers — skip years like "2026"
        const animate = !Number.isNaN(num) && num <= 50;
        return (
          <div class="border-t border-[--color-fg] pt-4 stat-cell">
            <dt class="text-[10px] uppercase tracking-wider text-[--color-muted] font-medium mb-2">
              {stat.label}
            </dt>
            <dd
              class="text-3xl md:text-4xl font-bold tracking-tight tabular-nums stat-value"
              data-target={animate ? stat.value : ''}
            >
              {animate ? '0' : stat.value}
            </dd>
          </div>
        );
      })}
    </dl>
  </div>

  <div class="border-t border-[--color-border] pt-10 about-reveal">
    <h3 class="text-xs uppercase tracking-[0.22em] text-[--color-muted] font-medium mb-8">
      {t.legal.heading}
    </h3>
    <dl class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-5 text-sm">
      {t.legal.rows.map((row) => (
        <div class="flex flex-col gap-1.5 legal-row">
          <dt class="text-[10px] uppercase tracking-wider text-[--color-muted] font-medium">
            {row.label}
          </dt>
          <dd class="font-medium tabular-nums">
            {row.value}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .about-reveal {
    opacity: 0;
    transform: translateY(28px);
  }
  @supports (animation-timeline: view()) {
    .about-reveal {
      animation: about-in both;
      animation-timeline: view();
      animation-range: entry 0% entry 55%;
    }
  }
  @keyframes about-in {
    to { opacity: 1; transform: translateY(0); }
  }

  .stat-cell {
    transition: border-color 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .stat-cell:hover {
    border-color: var(--color-accent, #ef4444);
  }

  .legal-row dd {
    transition: color 200ms ease;
  }
  .legal-row:hover dd {
    color: #18181b;
  }

  @media (prefers-reduced-motion: reduce) {
    .about-reveal { opacity: 1; transform: none; animation: none; }
  }
</style>

<script is:inline>
  (function () {
    // Reveal fallback
    if (!CSS.supports('animation-timeline: view()')) {
      const els = document.querySelectorAll('.about-reveal');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.style.opacity = '1';
            entry.target.style.transform = 'translateY(0)';
            entry.target.style.transition = 'opacity 800ms cubic-bezier(0.16, 1, 0.3, 1), transform 800ms cubic-bezier(0.16, 1, 0.3, 1)';
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      els.forEach((el) => io.observe(el));
    }

    // Number ticker — count up when visible
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const targets = document.querySelectorAll('.stat-value[data-target]');
    targets.forEach((el) => {
      const targetAttr = el.getAttribute('data-target');
      if (!targetAttr) return;
      const target = parseInt(targetAttr, 10);
      if (Number.isNaN(target)) return;
      if (reduce) { el.textContent = String(target); return; }

      const tick = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          tick.unobserve(entry.target);
          const start = performance.now();
          const dur = 1200;
          function step(now) {
            const t = Math.min(1, (now - start) / dur);
            const eased = 1 - Math.pow(1 - t, 3);
            entry.target.textContent = String(Math.round(eased * target));
            if (t < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
        });
      }, { threshold: 0.6 });
      tick.observe(el);
    });
  })();
</script>
