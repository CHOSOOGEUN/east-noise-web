---
import SunGlassScene from './SunGlassScene.astro';
import { apps } from '../data/apps';
import { strings, type Locale } from '../i18n/strings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings[locale];
const homeUrl = locale === 'ko' ? '/' : '/en/';
const otherUrl = locale === 'ko' ? '/en/' : '/';
const otherLabel = locale === 'ko' ? 'EN' : 'KO';

const localizeHref = (href?: string) => {
  if (!href) return '#contact';
  if (href.startsWith('/')) return locale === 'en' ? `/en${href}` : href;
  return href;
};

const glowColors: Record<string, string> = {
  luvit: '#ff5a18',
  seed: '#ff7418',
  heum: '#f04a14',
  nambona: '#ff681f',
  alpha: '#ff5018',
  'buying-service': '#ff5a18',
};

const products = apps
  .map((app, index) => ({
    index,
    slug: app.slug,
    name: app.copy[locale].shortName,
    tagline: app.copy[locale].tagline,
    description: app.copy[locale].description,
    status: app.status[locale],
    kind: app.kind[locale],
    href: localizeHref(app.links?.web),
    external: Boolean(app.links?.web?.startsWith('http')),
    glow: glowColors[app.slug] ?? '#ff5a18',
  }));

const firstProduct = products[0];

const copy = {
  ko: {
    label: 'Independent product team',
    title: '제품을 만들고 직접 운영합니다.',
    lead: 'Luvit, Seed, heum, 남보나, ALPHA, Buying OS를 만들고 운영합니다.',
    products: 'Products',
    productLead: '출시, 운영, 심사, 개발 중인 프로젝트를 현재 상태 그대로 정리했습니다.',
    view: '제품 보기',
    team: 'Team',
    roles: ['Product', 'Product', 'Marketing'],
    names: ['조수근', '이유석', '김윤서'],
    contact: 'Contact',
    contactLead: '제품과 협업에 관한 연락은 메일로 받습니다.',
  },
  en: {
    label: 'Independent product team',
    title: 'We make products and operate them ourselves.',
    lead: 'Building and operating Luvit, Seed, heum, Nambona, ALPHA, and Buying OS.',
    products: 'Products',
    productLead: 'Projects currently live, in review, or under active development.',
    view: 'View product',
    team: 'Team',
    roles: ['Product', 'Product', 'Marketing'],
    names: ['Soogeun Cho', 'Yuseok Lee', 'Yunseo Kim'],
    contact: 'Contact',
    contactLead: 'For product and collaboration inquiries, email us.',
  },
}[locale];
---

<div class="sunset-site" data-sunset-home style={`--active-orange: ${firstProduct.glow}`}>
  <div class="scroll-progress" aria-hidden="true"></div>

  <header class="site-nav" aria-label="East Noise">
    <a href={homeUrl} class="brand" aria-label={locale === 'ko' ? '동방의 소음 홈' : 'East Noise home'}>
      동방의 소음
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href="#products">{copy.products}</a>
      <a href="#team">{copy.team}</a>
      <a href="#contact">{copy.contact}</a>
      <a href={otherUrl}>{otherLabel}</a>
    </nav>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-white">
        <div class="hero-copy reveal" data-reveal>
          <p class="eyebrow">{copy.label}</p>
          <h1 id="hero-title">{copy.title}</h1>
          <p class="hero-lead">{copy.lead}</p>
        </div>
      </div>

      <div class="sun-wrap" aria-hidden="false">
        <SunGlassScene
          label={locale === 'ko' ? '커서에 반응하는 유리 노을 오브젝트' : 'Interactive glass sunset object'}
          accent={firstProduct.glow}
        />
      </div>

      <div class="product-stage" id="products" style={`--product-count: ${products.length};`}>
        <div class="product-tabs" role="list" aria-label={locale === 'ko' ? '제품 선택' : 'Select a product'}>
          {products.map((product) => (
            <button
              type="button"
              role="listitem"
              class="product-tab"
              data-product-control
              data-active={product.index === 0 ? 'true' : 'false'}
              data-name={product.name}
              data-tagline={product.tagline}
              data-status={product.status}
              data-href={product.href}
              data-external={product.external ? 'true' : 'false'}
              data-glow={product.glow}
            >
              {product.name}
            </button>
          ))}
        </div>

        <div class="active-product" aria-live="polite">
          <strong data-active-name>{firstProduct.name}</strong>
          <div class="active-product__meta">
            <p data-active-tagline>{firstProduct.tagline}</p>
            <a
              href={firstProduct.href}
              data-active-link
              target={firstProduct.external ? '_blank' : undefined}
              rel={firstProduct.external ? 'noopener' : undefined}
            >
              {copy.view}
            </a>
          </div>
        </div>

        <div class="stage-progress" aria-hidden="true"><span></span></div>
      </div>
    </section>

    <section class="catalogue" aria-labelledby="catalogue-title">
      <div class="section-intro reveal" data-reveal>
        <p class="eyebrow">01 / {String(products.length).padStart(2, '0')}</p>
        <h2 id="catalogue-title">{copy.products}</h2>
        <p>{copy.productLead}</p>
      </div>

      <div class="catalogue-list">
        {products.map((product) => (
          <a
            class="catalogue-row reveal"
            data-reveal
            href={product.href}
            target={product.external ? '_blank' : undefined}
            rel={product.external ? 'noopener' : undefined}
          >
            <span class="catalogue-row__number">{String(product.index + 1).padStart(2, '0')}</span>
            <strong>{product.name}</strong>
            <span class="catalogue-row__tagline">{product.tagline}</span>
            <span class="catalogue-row__status">{product.status}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="team-section" id="team" aria-labelledby="team-title">
      <div class="section-intro section-intro--dark reveal" data-reveal>
        <p class="eyebrow">02 / 02</p>
        <h2 id="team-title">{copy.team}</h2>
      </div>
      <div class="team-list">
        {copy.names.map((name, index) => (
          <div class="team-row reveal" data-reveal>
            <span>{copy.roles[index]}</span>
            <strong>{name}</strong>
          </div>
        ))}
      </div>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <p class="eyebrow">{copy.contact}</p>
      <h2 id="contact-title">{copy.contactLead}</h2>
      <a href={`mailto:${t.contact.email}`}>{t.contact.email}</a>
    </section>
  </main>

  <footer class="site-footer">
    <span>{t.contact.copyright}</span>
    <span>{t.contact.bizNo}</span>
  </footer>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-sunset-home]');

  if (root) {
    const controls = [...root.querySelectorAll<HTMLButtonElement>('[data-product-control]')];
    const name = root.querySelector<HTMLElement>('[data-active-name]');
    const tagline = root.querySelector<HTMLElement>('[data-active-tagline]');
    const link = root.querySelector<HTMLAnchorElement>('[data-active-link]');
    const progress = root.querySelector<HTMLElement>('.scroll-progress');
    const stageProgress = root.querySelector<HTMLElement>('.stage-progress span');
    let activeControl = controls[0];

    const setProduct = (control: HTMLButtonElement) => {
      if (control === activeControl) return;
      activeControl = control;
      controls.forEach((item) => item.dataset.active = item === control ? 'true' : 'false');

      root.classList.add('is-changing');
      window.setTimeout(() => {
        if (name) name.textContent = control.dataset.name || '';
        if (tagline) tagline.textContent = control.dataset.tagline || '';
        if (link) {
          link.href = control.dataset.href || '#contact';
          if (control.dataset.external === 'true') {
            link.target = '_blank';
            link.rel = 'noopener';
          } else {
            link.removeAttribute('target');
            link.removeAttribute('rel');
          }
        }
        const glow = control.dataset.glow || '#ff5a18';
        root.style.setProperty('--active-orange', glow);
        window.dispatchEvent(new CustomEvent('east-noise:sun-accent', { detail: { accent: glow } }));
        if (stageProgress) {
          const index = controls.indexOf(control);
          stageProgress.style.width = `${((index + 1) / controls.length) * 100}%`;
        }
        root.classList.remove('is-changing');
      }, 150);
    };

    controls.forEach((control) => {
      control.addEventListener('click', () => setProduct(control));
      control.addEventListener('focus', () => setProduct(control));
    });

    const updateScroll = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      if (progress) progress.style.transform = `scaleX(${ratio})`;
    };

    const reveals = [...root.querySelectorAll<HTMLElement>('[data-reveal]')];
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        revealObserver.unobserve(entry.target);
      });
    }, { threshold: 0.14 });
    reveals.forEach((element) => revealObserver.observe(element));

    window.addEventListener('scroll', updateScroll, { passive: true });
    updateScroll();
  }
</script>

<style>
  .sunset-site {
    --ink: #111111;
    --paper: #ffffff;
    --line: #d7d7d7;
    --muted: #707070;
    min-height: 100vh;
    overflow: clip;
    background: var(--paper);
    color: var(--ink);
  }

  .scroll-progress {
    position: fixed;
    inset: 0 auto auto 0;
    z-index: 100;
    width: 100%;
    height: 2px;
    background: var(--active-orange);
    transform: scaleX(0);
    transform-origin: left;
    transition: background-color 280ms ease;
  }

  .site-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
    padding: 0 3rem;
    border-bottom: 1px solid rgba(17, 17, 17, 0.08);
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(16px);
  }

  .brand,
  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2.4rem;
  }

  .nav-links a {
    position: relative;
    font-weight: 500;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 8px;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-links a:hover::after,
  .nav-links a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .hero {
    position: relative;
    min-height: 100svh;
    padding-top: 72px;
  }

  .hero-white {
    min-height: calc(51svh - 72px);
    padding: 10rem 6.7vw 3rem;
    background: var(--paper);
  }

  .hero-copy {
    width: min(58rem, 68%);
  }

  .eyebrow {
    margin: 0 0 1.5rem;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 58rem;
    margin: 0;
    font-size: 4rem;
    font-weight: 650;
    line-height: 1.12;
    letter-spacing: 0;
  }

  .hero-lead {
    margin: 2rem 0 0;
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.6;
  }

  .sun-wrap {
    position: absolute;
    z-index: 5;
    top: calc(51svh - 17rem);
    right: 7vw;
    width: 24rem;
    height: 24rem;
  }

  .product-stage {
    position: relative;
    min-height: 49svh;
    padding: 2.2rem 6.7vw 3rem;
    overflow: hidden;
    border-bottom: 8px solid var(--ink);
    background: var(--active-orange);
    color: var(--paper);
    transition: background-color 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .product-tabs {
    position: relative;
    z-index: 8;
    display: grid;
    grid-template-columns: repeat(var(--product-count), minmax(6.5rem, 1fr));
    gap: 1.25rem;
    width: 100%;
    border-bottom: 1px solid rgba(255, 255, 255, 0.72);
  }

  .product-tab {
    position: relative;
    min-height: 3.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    text-align: left;
    cursor: pointer;
  }

  .product-tab::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 2.6rem;
    height: 2px;
    background: var(--paper);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .product-tab[data-active='true'] {
    font-weight: 700;
  }

  .product-tab[data-active='true']::after {
    transform: scaleX(1);
  }

  .active-product {
    position: relative;
    min-height: 20rem;
    padding-top: 1rem;
  }

  .active-product > strong {
    display: block;
    max-width: 94%;
    overflow: hidden;
    color: transparent;
    font-size: 18rem;
    font-weight: 560;
    line-height: 0.82;
    white-space: nowrap;
    -webkit-text-stroke: 1.25px var(--paper);
    transform: scaleX(1.2);
    transform-origin: left center;
    transition: opacity 160ms ease, transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .active-product__meta {
    position: relative;
    z-index: 8;
    display: flex;
    align-items: center;
    gap: 2.5rem;
    margin-top: 1rem;
    transition: opacity 160ms ease, transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .active-product__meta p {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .active-product__meta a {
    min-height: 44px;
    padding: 0.7rem 0;
    border-bottom: 1px solid currentColor;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .is-changing .active-product > strong {
    opacity: 0;
    transform: translateY(10px) scaleX(1.2);
  }

  .is-changing .active-product__meta {
    opacity: 0;
    transform: translateY(10px);
  }

  .stage-progress {
    position: absolute;
    right: 6.7vw;
    bottom: 1.1rem;
    left: 6.7vw;
    height: 1px;
    background: rgba(255, 255, 255, 0.42);
  }

  .stage-progress span {
    display: block;
    width: calc(100% / var(--product-count));
    height: 100%;
    background: var(--paper);
    transition: width 440ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .catalogue {
    padding: 8rem 6.7vw 9rem;
    background: var(--paper);
  }

  .section-intro {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr) minmax(18rem, 32rem);
    align-items: start;
    gap: 2rem;
    margin-bottom: 5rem;
  }

  .section-intro h2 {
    margin: 0;
    font-size: 3.4rem;
    font-weight: 600;
    line-height: 1;
  }

  .section-intro > p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .catalogue-list {
    border-top: 1px solid var(--ink);
  }

  .catalogue-row {
    display: grid;
    grid-template-columns: 6rem minmax(10rem, 0.8fr) minmax(18rem, 1.2fr) minmax(14rem, 0.7fr);
    align-items: center;
    min-height: 8.5rem;
    gap: 1.5rem;
    border-bottom: 1px solid var(--line);
    transition: background-color 300ms ease, padding 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .catalogue-row:hover,
  .catalogue-row:focus-visible {
    padding-right: 1.25rem;
    padding-left: 1.25rem;
    background: #fff0e9;
  }

  .catalogue-row__number,
  .catalogue-row__status {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .catalogue-row strong {
    font-size: 2.1rem;
    font-weight: 600;
  }

  .catalogue-row__tagline {
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .catalogue-row__status {
    text-align: right;
  }

  .team-section {
    padding: 8rem 6.7vw 9rem;
    background: var(--ink);
    color: var(--paper);
  }

  .section-intro--dark {
    grid-template-columns: 12rem 1fr;
  }

  .section-intro--dark .eyebrow {
    color: #a8a8a8;
  }

  .team-list {
    border-top: 1px solid rgba(255, 255, 255, 0.8);
  }

  .team-row {
    display: grid;
    grid-template-columns: 12rem 1fr;
    align-items: center;
    min-height: 8rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }

  .team-row span {
    color: #a8a8a8;
    font-size: 0.78rem;
    text-transform: uppercase;
  }

  .team-row strong {
    font-size: 3rem;
    font-weight: 500;
  }

  .contact-section {
    padding: 8rem 6.7vw;
    background: var(--active-orange);
    color: var(--paper);
    transition: background-color 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-section .eyebrow {
    color: rgba(255, 255, 255, 0.72);
  }

  .product-stage :focus-visible,
  .contact-section :focus-visible {
    outline-color: var(--paper);
  }

  .contact-section h2 {
    max-width: 46rem;
    margin: 0 0 4rem;
    font-size: 3.4rem;
    font-weight: 600;
    line-height: 1.16;
  }

  .contact-section a {
    display: inline-block;
    max-width: 100%;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid currentColor;
    font-size: 1.45rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 5.5rem;
    padding: 0 6.7vw;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.75rem;
  }

  @media (max-width: 1100px) {
    .hero h1 {
      font-size: 3.25rem;
    }

    .sun-wrap {
      right: 3vw;
      width: 21rem;
      height: 21rem;
    }

    .active-product > strong {
      font-size: 8rem;
    }

    .catalogue-row {
      grid-template-columns: 4rem minmax(8rem, 0.8fr) minmax(15rem, 1.2fr) minmax(11rem, 0.7fr);
    }
  }

  @media (max-width: 820px) {
    .site-nav {
      padding: 0 1.5rem;
    }

    .nav-links {
      gap: 1.4rem;
    }

    .hero-white {
      min-height: 31rem;
      padding: 6.5rem 1.5rem 7rem;
    }

    .hero-copy {
      width: 100%;
    }

    .hero h1 {
      max-width: 37rem;
      font-size: 3rem;
    }

    .sun-wrap {
      top: 21.5rem;
      right: 1rem;
      width: 16rem;
      height: 16rem;
    }

    .product-stage {
      min-height: 30rem;
      padding: 2rem 1.5rem 3rem;
    }

    .product-tabs {
      width: 100%;
      min-width: 0;
      grid-template-columns: repeat(var(--product-count), minmax(5.5rem, 1fr));
      gap: 0.65rem;
    }

    .active-product {
      padding-top: 4rem;
    }

    .active-product > strong {
      max-width: 100%;
      font-size: 8rem;
    }

    .stage-progress {
      right: 1.5rem;
      left: 1.5rem;
    }

    .catalogue,
    .team-section,
    .contact-section {
      padding: 6rem 1.5rem;
    }

    .section-intro,
    .section-intro--dark {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-bottom: 3rem;
    }

    .section-intro h2,
    .contact-section h2 {
      font-size: 2.6rem;
    }

    .catalogue-row {
      grid-template-columns: 3rem minmax(8rem, 0.8fr) minmax(15rem, 1.2fr);
    }

    .catalogue-row__status {
      display: none;
    }

    .team-row {
      grid-template-columns: 8rem 1fr;
    }

    .site-footer {
      padding: 0 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .site-nav {
      min-height: 64px;
    }

    .nav-links a:not(:last-child) {
      display: none;
    }

    .hero {
      padding-top: 64px;
    }

    .hero-white {
      min-height: 31rem;
      padding-top: 5.5rem;
    }

    .hero h1 {
      font-size: 2.35rem;
      line-height: 1.18;
    }

    .hero-lead {
      max-width: 18rem;
      font-size: 1rem;
    }

    .sun-wrap {
      top: 23.5rem;
      right: -0.5rem;
      width: 13rem;
      height: 13rem;
      pointer-events: none;
    }

    .product-stage {
      min-height: 28rem;
      padding-top: 1.5rem;
    }

    .product-tabs {
      width: 100%;
      min-width: 0;
      grid-template-columns: repeat(var(--product-count), minmax(5.6rem, 1fr));
      gap: 0.25rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }

    .product-tabs::-webkit-scrollbar {
      display: none;
    }

    .product-tab {
      min-height: 3.25rem;
      font-size: 0.82rem;
    }

    .active-product {
      min-height: 17rem;
      padding-top: 5.5rem;
    }

    .active-product > strong {
      font-size: 5.2rem;
      transform: none;
    }

    .active-product__meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.6rem;
      margin-top: 1.5rem;
    }

    .active-product__meta p {
      max-width: 18rem;
      font-size: 0.9rem;
    }

    .catalogue,
    .team-section,
    .contact-section {
      padding: 4.5rem 1.25rem;
