---
import { Image } from 'astro:assets';
import apartmentExterior from '../assets/east-apartment/apartment-exterior.png';
import luvitRoom from '../assets/east-apartment/luvit-room.png';
import seedRoom from '../assets/east-apartment/seed-room.png';
import heumDesk from '../assets/east-apartment/heum-desk.png';
import alphaRoom from '../assets/east-apartment/alpha-room.jpg';
import { apps } from '../data/apps';
import { strings, type Locale } from '../i18n/strings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings[locale];
const homeUrl = locale === 'ko' ? '/' : '/en/';
const otherUrl = locale === 'ko' ? '/en/' : '/';
const otherLabel = locale === 'ko' ? 'EN' : 'KO';
const privacyUrl = locale === 'ko' ? '/legal/seed/privacy' : '/en/legal/seed/privacy';
const termsUrl = locale === 'ko' ? '/legal/seed/terms' : '/en/legal/seed/terms';

const localizeHref = (href?: string) => {
  if (!href) return '#contact';
  if (href.startsWith('/')) return locale === 'en' ? `/en${href}` : href;
  return href;
};

const products = apps.map((app) => ({
  ...app,
  name: app.copy[locale].shortName,
  tagline: app.copy[locale].tagline,
  description: app.copy[locale].description,
  status: app.status[locale],
  kind: app.kind[locale],
  href: localizeHref(app.links?.web),
  external: Boolean(app.links?.web?.startsWith('http')),
}));

const featuredSlugs = ['luvit', 'seed', 'heum', 'alpha'];
const featured = featuredSlugs
  .map((slug) => products.find((product) => product.slug === slug))
  .filter((product): product is (typeof products)[number] => Boolean(product));
const otherRooms = products.filter((product) => !featuredSlugs.includes(product.slug));

const copy = {
  ko: {
    navRooms: '불이 켜진 방', navStudio: '스튜디오', navContact: '연락',
    heroKicker: 'Everyday, somewhere', heroTitle: '동방의 소음',
    heroLead: '사소한 순간에서, 오래 쓰고 싶은 제품을 만듭니다.', heroPrompt: '오늘 불이 켜진 방',
    heroCta: '방 둘러보기', visit: '이 방 자세히 보기',
    luvitBody: '매일 오전 9시, 서로를 한 번 더 떠올리는\n둘만의 비밀 미션.',
    seedBody: '해낸 순간을 짧은 영상으로 남기고\n나만의 식물을 키웁니다.',
    heumBody: '가상의 웹사이트를 탐색하고\n서로 맞지 않는 기록으로 사건을 풉니다.',
    alphaBody: '오늘의 루틴을 끝내고\n삼십 일의 기록으로 기준을 다시 세웁니다.',
    moreKicker: 'The other windows', moreTitle: '조금 다른 소음이 나는 방들',
    studioKicker: 'East Noise, Suwon', studioTitle: '출시보다, 그다음 날을\n더 오래 생각합니다.',
    studioBody: '조수근과 이유석이 공동 창업하고, 김윤서가 마케팅을 맡습니다. 일상 가까이에서 아이디어를 찾고, 앱과 웹을 직접 출시한 뒤 매일의 운영까지 함께합니다.',
    contactKicker: 'Knock, knock', contactTitle: '같이 만들 이야기가 있나요?',
    contactBody: '제품과 콘텐츠, 협업과 다음 실험에 관한 이야기를 기다립니다.',
    privacy: 'Seed 개인정보처리방침', terms: 'Seed 이용약관', location: 'Suwon, Korea',
    screenLuvit: 'Luvit의 오늘의 미션 화면', screenSeed: 'Seed의 오늘 루틴 화면',
  },
  en: {
    navRooms: 'Lit rooms', navStudio: 'Studio', navContact: 'Contact',
    heroKicker: 'Everyday, somewhere', heroTitle: 'East Noise',
    heroLead: 'We make products worth keeping from the small moments of everyday life.', heroPrompt: 'Rooms lit tonight',
    heroCta: 'Explore the rooms', visit: 'See inside',
    luvitBody: 'A private 9 AM mission\nthat brings two people closer.',
    seedBody: 'Record the moment you showed up\nand grow a plant of your own.',
    heumBody: 'Explore fictional websites\nand solve cases through conflicting records.',
    alphaBody: 'Finish today\'s routines\nand rebuild your standards over thirty days.',
    moreKicker: 'The other windows', moreTitle: 'Rooms making a different kind of noise',
    studioKicker: 'East Noise, Suwon', studioTitle: 'We think longer about day two\nthan launch day.',
    studioBody: 'Founded by Soogeun Cho and Yuseok Lee, with marketing by Yunseo Kim. We find ideas close to everyday life, launch apps and web products ourselves, and stay for the daily operation.',
    contactKicker: 'Knock, knock', contactTitle: 'Have something we should make together?',
    contactBody: 'We are open to conversations about products, content, collaboration, and the next experiment.',
    privacy: 'Seed Privacy Policy', terms: 'Seed Terms of Use', location: 'Suwon, Korea',
    screenLuvit: "Luvit's daily mission screen", screenSeed: "Seed's today routine screen",
  },
}[locale];

const roomIds = ['luvit-room', 'seed-room', 'heum-room', 'alpha-room', 'other-rooms', 'other-rooms'];
const roomAccents = ['#e58ba8', '#8bc9b1', '#9fb4d5', '#ff1b1f', '#f0b6ca', '#a9e1db'];
const windowRects = [
  { x: 798, y: 224, width: 230, height: 149 },
  { x: 1100, y: 228, width: 294, height: 142 },
  { x: 800, y: 478, width: 227, height: 138 },
  { x: 1102, y: 479, width: 296, height: 139 },
  { x: 800, y: 721, width: 226, height: 141 },
  { x: 1101, y: 717, width: 301, height: 149 },
].map((rect) => ({
  left: `${rect.x / 15.86}%`,
  top: `${rect.y / 9.92}%`,
  width: `${rect.width / 15.86}%`,
  height: `${rect.height / 9.92}%`,
}));
const windowProducts = [...featured, ...otherRooms].slice(0, windowRects.length);
---

<div class="apartment-site" data-apartment-home>
  <a class="skip-link" href="#luvit-room">{copy.heroCta}</a>
  <div class="scroll-progress" aria-hidden="true"><span></span></div>

  <header class="site-nav" aria-label={locale === 'ko' ? '동방의 소음' : 'East Noise'}>
    <a href={homeUrl} class="brand" aria-label={locale === 'ko' ? '동방의 소음 홈' : 'East Noise home'}>
      <span>{locale === 'ko' ? '동방의 소음' : 'East Noise'}</span>
    </a>
    <nav aria-label={locale === 'ko' ? '주요 메뉴' : 'Primary navigation'}>
      <a href="#luvit-room" data-section-link="rooms">{copy.navRooms}</a>
      <a href="#studio" data-section-link="studio">{copy.navStudio}</a>
      <a href="#contact" data-section-link="contact">{copy.navContact}</a>
      <a href={otherUrl} hreflang={locale === 'ko' ? 'en' : 'ko'}>{otherLabel}</a>
    </nav>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <Image class="hero-image" src={apartmentExterior} alt="" loading="eager" fetchpriority="high"
        widths={[640, 960, 1280, 1586]} sizes="100vw" quality={88} />
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="hero-copy reveal" data-reveal>
        <p class="kicker">{copy.heroKicker}</p>
        <h1 id="hero-title">{copy.heroTitle}</h1>
        <p class="hero-lead">{copy.heroLead}</p>
      </div>

      <div class="window-map" aria-label={locale === 'ko' ? '제품 방 선택' : 'Choose a product room'}>
        {windowProducts.map((product, index) => (
          <a class="window-hotspot" href={`#${roomIds[index]}`} data-window data-accent={roomAccents[index]}
            style={`--window-left:${windowRects[index].left};--window-top:${windowRects[index].top};--window-width:${windowRects[index].width};--window-height:${windowRects[index].height}`}
            aria-label={`${product.name}: ${product.tagline}`}><span>{product.name}</span></a>
        ))}
      </div>

      <div class="hero-entry reveal" data-reveal>
        <p>{copy.heroPrompt}</p>
        <a class="outline-button" href="#luvit-room">{copy.heroCta}</a>
      </div>

      <nav class="mobile-room-nav" aria-label={locale === 'ko' ? '제품 방 바로가기' : 'Product room shortcuts'}>
        {windowProducts.map((product, index) => <a href={`#${roomIds[index]}`}>{product.name}</a>)}
      </nav>
    </section>

    <section class="room room--luvit" id="luvit-room" data-room aria-labelledby="luvit-title">
      <Image class="room-image" src={luvitRoom} alt="" loading="lazy" widths={[640, 960, 1440, 1942]}
        sizes="100vw" quality={86} />
      <div class="room-shade" aria-hidden="true"></div>
      <div class="room-copy reveal" data-reveal>
        <p class="room-number">01 / 04 · {featured[0].kind}</p>
        <h2 id="luvit-title">{featured[0].name}</h2>
        <p class="room-line">{copy.luvitBody}</p>
        <p class="room-status">{featured[0].status}</p>
        <a class="text-link" href={featured[0].href}>{copy.visit}</a>
      </div>
      <figure class="screen-proof screen-proof--luvit reveal" data-reveal>
        <img src="/screenshots/luvit/03-mission.png" alt={copy.screenLuvit} loading="lazy" decoding="async" />
      </figure>
    </section>

    <section class="room room--seed" id="seed-room" data-room aria-labelledby="seed-title">
      <Image class="room-image" src={seedRoom} alt="" loading="lazy" widths={[640, 960, 1440, 1858]}
        sizes="100vw" quality={86} />
      <div class="room-shade" aria-hidden="true"></div>
      <div class="room-copy reveal" data-reveal>
        <p class="room-number">02 / 04 · {featured[1].kind}</p>
        <h2 id="seed-title">{featured[1].name}</h2>
        <p class="room-line">{copy.seedBody}</p>
        <p class="room-status">{featured[1].status}</p>
        <a class="text-link" href={featured[1].href}>{copy.visit}</a>
      </div>
      <figure class="screen-proof screen-proof--seed reveal" data-reveal>
        <img src="/screenshots/seed/03-today.png" alt={copy.screenSeed} loading="lazy" decoding="async" />
      </figure>
    </section>

    <section class="room room--heum" id="heum-room" data-room aria-labelledby="heum-title">
      <Image class="room-image" src={heumDesk} alt="" loading="lazy" widths={[640, 960, 1440, 1914]}
        sizes="100vw" quality={86} />
      <div class="room-shade" aria-hidden="true"></div>
      <div class="room-copy reveal" data-reveal>
        <p class="room-number">03 / 04 · {featured[2].kind}</p>
        <h2 id="heum-title">{featured[2].name}</h2>
        <p class="room-line">{copy.heumBody}</p>
        <p class="room-status">{featured[2].status}</p>
        <a class="text-link" href={featured[2].href} target="_blank" rel="noopener">{copy.visit}</a>
      </div>
    </section>

    <section class="room room--alpha" id="alpha-room" data-room aria-labelledby="alpha-title">
      <Image class="room-image" src={alphaRoom} alt="" loading="lazy" widths={[640, 960, 1440, 1672]}
        sizes="100vw" quality={88} />
      <div class="room-shade" aria-hidden="true"></div>
      <div class="room-copy reveal" data-reveal>
        <p class="room-number">04 / 04 · {featured[3].kind}</p>
        <h2 id="alpha-title">{featured[3].name}</h2>
        <p class="room-line">{copy.alphaBody}</p>
        <p class="room-status">{featured[3].status}</p>
        <a class="text-link" href={featured[3].href}>{copy.visit}</a>
      </div>
    </section>

    <section class="other-rooms" id="other-rooms" aria-labelledby="other-rooms-title">
      <div class="other-heading reveal" data-reveal>
        <p class="kicker">{copy.moreKicker}</p><h2 id="other-rooms-title">{copy.moreTitle}</h2>
      </div>
      <div class="other-grid">
        {otherRooms.map((product, index) => {
          const hasWeb = Boolean(product.links?.web);
          const Wrapper = hasWeb ? 'a' : 'article';
          return (
            <Wrapper class="other-card reveal" data-reveal href={hasWeb ? product.href : undefined}
              target={product.external ? '_blank' : undefined} rel={product.external ? 'noopener' : undefined}>
              <p>{product.kind}</p><h3>{product.name}</h3><span>{product.tagline}</span>
              <small>{product.status}</small>
            </Wrapper>
          );
        })}
      </div>
    </section>

    <section class="studio" id="studio" aria-labelledby="studio-title">
      <div class="studio-copy reveal" data-reveal>
        <p class="kicker">{copy.studioKicker}</p><h2 id="studio-title">{copy.studioTitle}</h2><p>{copy.studioBody}</p>
      </div>
      <div class="studio-names reveal" data-reveal aria-label={locale === 'ko' ? '팀 구성' : 'Team'}>
        <div><span>Co-founder</span><strong>{locale === 'ko' ? '조수근' : 'Soogeun Cho'}</strong></div>
        <div><span>Co-founder</span><strong>{locale === 'ko' ? '이유석' : 'Yuseok Lee'}</strong></div>
        <div><span>Marketing</span><strong>{locale === 'ko' ? '김윤서' : 'Yunseo Kim'}</strong></div>
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <div class="contact-copy reveal" data-reveal>
        <p class="kicker">{copy.contactKicker}</p><h2 id="contact-title">{copy.contactTitle}</h2><p>{copy.contactBody}</p>
      </div>
      <a class="contact-button" href={`mailto:${t.contact.email}`}>{t.contact.email}</a>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-brand"><strong>{locale === 'ko' ? '동방의 소음' : 'East Noise'}</strong><span>{t.contact.copyright}</span></div>
    <nav aria-label={locale === 'ko' ? '법적 고지' : 'Legal'}><a href={privacyUrl}>{copy.privacy}</a><a href={termsUrl}>{copy.terms}</a></nav>
    <div class="footer-meta"><a href={`mailto:${t.contact.email}`}>{t.contact.email}</a><span>{copy.location} · {t.contact.bizNo}</span></div>
  </footer>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-apartment-home]');
  if (root) {
    const revealItems = [...root.querySelectorAll<HTMLElement>('[data-reveal]')];
    const progress = root.querySelector<HTMLElement>('.scroll-progress span');
    const hero = root.querySelector<HTMLElement>('.hero');
    const rooms = [...root.querySelectorAll<HTMLElement>('[data-room]')];
    const windows = [...root.querySelectorAll<HTMLElement>('[data-window]')];
    const sectionLinks = [...root.querySelectorAll<HTMLAnchorElement>('[data-section-link]')];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let ticking = false;

    const syncHeroArtwork = () => {
      if (!hero) return;
      const width = hero.clientWidth;
      const height = hero.clientHeight;
      const imageRatio = 1586 / 992;
      const heroRatio = width / height;
      const artWidth = heroRatio >= imageRatio ? width : height * imageRatio;
      const artHeight = heroRatio >= imageRatio ? width / imageRatio : height;
      const horizontalPosition = width <= 900 ? .67 : 1;
      hero.style.setProperty('--hero-art-left', `${heroRatio >= imageRatio ? 0 : (width - artWidth) * horizontalPosition}px`);
      hero.style.setProperty('--hero-art-top', `${heroRatio >= imageRatio ? (height - artHeight) / 2 : 0}px`);
      hero.style.setProperty('--hero-art-width', `${artWidth}px`);
      hero.style.setProperty('--hero-art-height', `${artHeight}px`);
    };
    syncHeroArtwork();
    const heroResizeObserver = 'ResizeObserver' in window ? new ResizeObserver(syncHeroArtwork) : null;
    if (hero) heroResizeObserver?.observe(hero);

    if ('IntersectionObserver' in window && !reduceMotion.matches) {
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        });
      }, { threshold: 0.13 });
      revealItems.forEach((item) => revealObserver.observe(item));
    } else revealItems.forEach((item) => item.classList.add('is-visible'));

    const updateScroll = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      if (progress) progress.style.transform = `scaleX(${ratio})`;
      if (!reduceMotion.matches) rooms.forEach((room) => {
        const rect = room.getBoundingClientRect();
        const ratio = Math.max(-1, Math.min(1, (rect.top + rect.height / 2 - innerHeight / 2) / innerHeight));
        room.style.setProperty('--room-shift', `${ratio * -18}px`);
      });
      ticking = false;
    };
    const requestScrollUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateScroll);
    };

    windows.forEach((link) => {
      const setAccent = () => root.style.setProperty('--window-accent', link.dataset.accent || '#b5d7e8');
      link.addEventListener('pointerenter', setAccent); link.addEventListener('focus', setAccent);
    });

    if ('IntersectionObserver' in window) {
      const sectionObserver = new IntersectionObserver((entries) => {
        const current = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!current) return;
        const section = current.target.id === 'studio' ? 'studio' : current.target.id === 'contact' ? 'contact' : 'rooms';
        sectionLinks.forEach((link) => {
          const active = link.dataset.sectionLink === section;
          link.classList.toggle('is-active', active);
          if (active) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current');
        });
      }, { rootMargin: '-22% 0px -55%', threshold: [0, .2, .45] });
      [...rooms, root.querySelector<HTMLElement>('#studio'), root.querySelector<HTMLElement>('#contact')]
        .filter((section): section is HTMLElement => Boolean(section))
        .forEach((section) => sectionObserver.observe(section));
    }

    if (matchMedia('(pointer: fine)').matches && !reduceMotion.matches) {
      root.querySelector<HTMLElement>('.hero')?.addEventListener('pointermove', (event) => {
        root.style.setProperty('--hero-x', `${(event.clientX / innerWidth - 0.5) * 8}px`);
        root.style.setProperty('--hero-y', `${(event.clientY / innerHeight - 0.5) * 6}px`);
      });
    }
    addEventListener('scroll', requestScrollUpdate, { passive: true });
    addEventListener('resize', () => { syncHeroArtwork(); requestScrollUpdate(); }, { passive: true });
    updateScroll();
  }
</script>

<style>
  .apartment-site {
    --night: #030d1b; --paper: #f4f2ec; --muted: #a8b4c4; --line: rgba(220, 231, 241, .22);
    --window-accent: #e58ba8; --hero-x: 0px; --hero-y: 0px;
    min-height: 100vh; overflow: clip; background: var(--night); color: var(--paper);
  }
  .skip-link { position: fixed; top: 0; left: .75rem; z-index: 200; padding: .75rem 1rem; transform: translateY(-110%); background: var(--paper); color: var(--night); }
  .skip-link:focus { top: .75rem; transform: translateY(0); }
  .scroll-progress { position: fixed; inset: 0 0 auto; z-index: 150; height: 2px; background: rgba(255,255,255,.06); }
  .scroll-progress span { display: block; width: 100%; height: 100%; transform: scaleX(0); transform-origin: left; background: var(--window-accent); }

  .site-nav { position: fixed; inset: 0 0 auto; z-index: 100; display: flex; min-height: 76px; align-items: center; justify-content: space-between; padding: 0 4.8vw; border-bottom: 1px solid rgba(226,234,242,.12); background: rgba(2,9,19,.58); backdrop-filter: blur(12px); }
  .brand, .site-nav nav, .site-nav nav a { display: flex; align-items: center; }
  .brand { gap: .75rem; min-height: 44px; font-size: .88rem; font-weight: 650; letter-spacing: -.02em; }
  .site-nav nav { gap: clamp(1rem,2.6vw,2.8rem); }
  .site-nav nav a { min-height: 44px; color: rgba(244,242,236,.78); font-size: .78rem; letter-spacing: .05em; transition: color 180ms ease; }
  .site-nav nav a:hover, .site-nav nav a:focus-visible { color: var(--paper); }
  .site-nav nav a.is-active { color: var(--paper); }
  .site-nav nav a.is-active::after { width: 100%; }
  .site-nav nav a[data-section-link] { position: relative; }
  .site-nav nav a[data-section-link]::after { position: absolute; right: 0; bottom: 7px; left: 0; width: 0; height: 1px; margin: auto; background: currentColor; content: ''; transition: width 180ms ease; }

  .hero { --hero-art-left: 0px; --hero-art-top: 0px; --hero-art-width: 100%; --hero-art-height: 100%; position: relative; min-height: max(720px,100svh); overflow: hidden; isolation: isolate; }
  .hero-image, .room-image { position: absolute; width: 100%; height: 100%; object-fit: cover; }
  .hero-image { top: var(--hero-art-top); left: var(--hero-art-left); width: var(--hero-art-width); max-width: none; height: var(--hero-art-height); object-fit: fill; transform: translate3d(var(--hero-x),var(--hero-y),0) scale(1.02); transition: transform 1.2s cubic-bezier(.16,1,.3,1); }
  .room-image { inset: 0; }
  .hero-shade { position: absolute; inset: 0; z-index: 1; background: rgba(1,8,18,.16); }
  .hero-copy, .hero-entry, .window-map, .mobile-room-nav { position: absolute; z-index: 2; }
  .hero-copy { top: 32%; left: 6.2vw; width: min(34rem,36vw); }
  .kicker, .room-number { margin: 0; color: rgba(226,234,242,.66); font-size: .68rem; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; }
  .hero-copy h1 { margin: 1.15rem 0 0; font-size: clamp(3.2rem,5.4vw,6rem); font-weight: 540; letter-spacing: -.065em; line-height: .98; }
  .hero-lead { max-width: 24rem; margin: 1.4rem 0 0; color: rgba(244,242,236,.74); font-size: clamp(.96rem,1.15vw,1.18rem); line-height: 1.75; }
  .hero-entry { bottom: 7.4vh; left: 6.2vw; }
  .hero-entry p { margin: 0 0 1.2rem; color: rgba(244,242,236,.72); font-size: .76rem; }
  .outline-button, .contact-button { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; padding: .8rem 1.15rem; border: 1px solid rgba(238,242,246,.58); color: var(--paper); font-size: .78rem; transition: background-color 180ms ease,border-color 180ms ease,color 180ms ease; }
  .outline-button:hover, .outline-button:focus-visible, .contact-button:hover, .contact-button:focus-visible { border-color: var(--paper); background: var(--paper); color: var(--night); }

  .window-map { top: var(--hero-art-top); left: var(--hero-art-left); width: var(--hero-art-width); height: var(--hero-art-height); transform: translate3d(var(--hero-x),var(--hero-y),0) scale(1.02); transition: transform 1.2s cubic-bezier(.16,1,.3,1); pointer-events: none; }
