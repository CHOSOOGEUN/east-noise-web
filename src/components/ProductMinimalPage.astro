---
import { Image } from 'astro:assets';
import luvitRoom from '../assets/east-apartment/luvit-room.png';
import seedRoom from '../assets/east-apartment/seed-room.png';
import { apps } from '../data/apps';
import { strings, type Locale } from '../i18n/strings';

type ProductSlug = 'luvit' | 'seed';
interface Props { locale: Locale; slug: ProductSlug; }

const { locale, slug } = Astro.props;
const t = strings[locale];
const product = apps.find((app) => app.slug === slug);
if (!product) throw new Error(`Unknown product slug: ${slug}`);

const homeUrl = locale === 'ko' ? '/' : '/en/';
const otherUrl = locale === 'ko' ? `/en/${slug}` : `/${slug}`;
const otherLabel = locale === 'ko' ? 'EN' : 'KO';
const privacyUrl = locale === 'ko' ? '/legal/seed/privacy' : '/en/legal/seed/privacy';
const termsUrl = locale === 'ko' ? '/legal/seed/terms' : '/en/legal/seed/terms';
const current = product.copy[locale];
const actionHref = product.links?.ios ?? `mailto:${t.contact.email}?subject=${encodeURIComponent(`${current.shortName} launch`)}`;
const scene = slug === 'luvit' ? luvitRoom : seedRoom;
const shot = slug === 'luvit' ? '/screenshots/luvit/03-mission.png' : '/screenshots/seed/03-today.png';
const accent = slug === 'luvit' ? '#e58ba8' : '#8bc9b1';

const localizeHref = (href?: string) => {
  if (!href) return '#contact';
  if (href.startsWith('/')) return locale === 'en' ? `/en${href}` : href;
  return href;
};

const primaryProducts = apps.filter((app) => ['luvit', 'seed', 'heum'].includes(app.slug)).map((app) => ({
  slug: app.slug, name: app.copy[locale].shortName, tagline: app.copy[locale].tagline,
  href: localizeHref(app.links?.web), external: Boolean(app.links?.web?.startsWith('http')),
}));

const copy = {
  ko: {
    back: '아파트로 돌아가기', overview: '이 방에서 일어나는 일', state: '지금 운영 중인 모습',
    open: 'App Store에서 만나기', related: '다음 방 둘러보기', contact: '연락', privacy: '개인정보처리방침', terms: '이용약관',
    facts: {
      luvit: [['오전 9시', '둘에게 서로 다른 비밀 미션이 도착합니다.'], ['자정 공개', '상대의 미션을 추측하고 결과를 함께 확인합니다.'], ['커플 루틴', '하루 한 번 서로를 떠올리는 짧은 흐름을 만듭니다.']],
      seed: [['짧은 인증', '2–4초 영상으로 실제로 해낸 순간을 남깁니다.'], ['식물 성장', '인증이 쌓일수록 식물과 기록이 함께 자랍니다.'], ['Daily Story', '오늘의 인증을 한 편의 세로 영상으로 다시 봅니다.']],
    },
    screenAlt: `${current.shortName} 실제 앱 화면`,
  },
  en: {
    back: 'Back to the apartment', overview: 'What happens in this room', state: 'Live today',
    open: 'Meet it on the App Store', related: 'Explore the next room', contact: 'Contact', privacy: 'Privacy Policy', terms: 'Terms of Use',
    facts: {
      luvit: [['Every 9 AM', 'A different private mission arrives for each person.'], ['Midnight reveal', 'Guess the other mission and check the result together.'], ['Couple routine', 'A short daily flow that makes room for each other.']],
      seed: [['Short proof', 'Capture the moment you showed up in a 2–4 second video.'], ['Plant growth', 'The plant and archive grow with every check-in.'], ['Daily Story', 'Revisit the day as one vertical video.']],
    },
    screenAlt: `${current.shortName} real app screen`,
  },
}[locale];

const facts = copy.facts[slug];
---

<div class="product-room" data-product-room style={`--accent: ${accent}`}>
  <div class="scroll-progress" aria-hidden="true"><span></span></div>
  <header class="room-nav">
    <a class="room-brand" href={homeUrl}>{locale === 'ko' ? '동방의 소음' : 'East Noise'}</a>
    <nav aria-label={locale === 'ko' ? '제품 메뉴' : 'Product navigation'}>
      <a href={homeUrl}>{copy.back}</a><a href="#overview">{copy.overview}</a><a href="#contact">{copy.contact}</a><a href={otherUrl}>{otherLabel}</a>
    </nav>
  </header>

  <main>
    <section class:list={['product-hero', `product-hero--${slug}`]} aria-labelledby="product-title">
      <Image class="scene-image" src={scene} alt="" loading="eager" fetchpriority="high"
        widths={[640, 960, 1440, slug === 'luvit' ? 1942 : 1858]} sizes="100vw" quality={88} />
      <div class="scene-shade" aria-hidden="true"></div>
      <div class="product-copy reveal" data-reveal>
        <p class="eyebrow">{product.kind[locale]}</p><h1 id="product-title">{current.shortName}</h1>
        <p class="tagline">{current.tagline}</p><p class="status">{product.status[locale]}</p>
        <a class="primary-action" href={actionHref} target="_blank" rel="noopener">{copy.open}</a>
      </div>
      <figure class="product-screen reveal" data-reveal><img src={shot} alt={copy.screenAlt} /></figure>
    </section>

    <section class="overview" id="overview" aria-labelledby="overview-title">
      <div class="overview-copy reveal" data-reveal>
        <p class="eyebrow">01 / 02</p><h2 id="overview-title">{copy.overview}</h2><p>{current.description}</p>
      </div>
      <div class="fact-list">
        {facts.map(([title, body], index) => (
          <article class="fact reveal" data-reveal><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{body}</p></article>
        ))}
      </div>
    </section>

    <section class="state-section" aria-labelledby="state-title">
      <div class="reveal" data-reveal><p class="eyebrow">02 / 02</p><h2 id="state-title">{copy.state}</h2></div>
      <div class="state-copy reveal" data-reveal><strong>{product.status[locale]}</strong><p>{current.proof}</p></div>
    </section>

    <section class="related" aria-labelledby="related-title">
      <p class="eyebrow">{copy.related}</p><h2 id="related-title">{copy.related}</h2>
      <div class="related-list">
        {primaryProducts.map((item, index) => (
          <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined} aria-current={item.slug === slug ? 'page' : undefined}>
            <span>{String(index + 1).padStart(2, '0')}</span><strong>{item.name}</strong><em>{item.tagline}</em>
          </a>
        ))}
      </div>
    </section>
  </main>

  <footer class="room-footer" id="contact"><span>{t.contact.copyright}</span>{slug === 'seed' && <nav aria-label={locale === 'ko' ? 'Seed 법적 고지' : 'Seed legal'}><a href={privacyUrl}>{copy.privacy}</a><a href={termsUrl}>{copy.terms}</a></nav>}<a href={`mailto:${t.contact.email}`}>{t.contact.email}</a></footer>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-product-room]');
  if (root) {
    const progress = root.querySelector<HTMLElement>('.scroll-progress span');
    const items = [...root.querySelectorAll<HTMLElement>('[data-reveal]')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if ('IntersectionObserver' in window && !reduced) {
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible'); observer.unobserve(entry.target);
      }), { threshold: .12 });
      items.forEach((item) => observer.observe(item));
    } else items.forEach((item) => item.classList.add('is-visible'));
    const update = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      if (progress) progress.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
    };
    addEventListener('scroll', update, { passive: true }); update();
  }
</script>

<style>
  .product-room { --night: #030d1b; --paper: #e9e7e1; min-height: 100vh; overflow: clip; background: var(--night); color: #f4f2ec; }
  .scroll-progress { position: fixed; inset: 0 0 auto; z-index: 120; height: 2px; }
  .scroll-progress span { display: block; width: 100%; height: 100%; transform: scaleX(0); transform-origin: left; background: var(--accent); }
  .room-nav { position: fixed; inset: 0 0 auto; z-index: 100; display: flex; min-height: 72px; align-items: center; justify-content: space-between; padding: 0 4.8vw; border-bottom: 1px solid rgba(240,244,247,.14); background: rgba(2,9,19,.58); backdrop-filter: blur(12px); }
  .room-brand, .room-nav nav, .room-nav nav a { display: flex; align-items: center; }
  .room-brand { min-height: 44px; gap: .7rem; font-size: .84rem; font-weight: 650; }
  .room-nav nav { gap: clamp(1rem,2.6vw,2.8rem); }
  .room-nav nav a { min-height: 44px; color: rgba(244,242,236,.72); font-size: .74rem; }

  .product-hero { position: relative; min-height: max(720px,100svh); overflow: hidden; isolation: isolate; }
  .scene-image { position: absolute; inset: -2%; width: 104%; height: 104%; object-fit: cover; }
  .scene-shade { position: absolute; inset: 0; z-index: 1; background: rgba(2,8,17,.3); }
  .product-copy { position: absolute; top: 50%; left: 7vw; z-index: 2; width: min(32rem,38vw); transform: translateY(-50%); }
  .eyebrow { margin: 0; color: rgba(224,233,240,.58); font-size: .68rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
  .product-copy h1 { margin: 1.1rem 0 0; font-size: clamp(4.4rem,8vw,9rem); font-weight: 520; letter-spacing: -.075em; line-height: .88; }
  .tagline { max-width: 28rem; margin: 2rem 0 0; font-size: clamp(1.05rem,1.45vw,1.38rem); font-weight: 560; line-height: 1.6; }
  .status { margin: .9rem 0 2rem; color: rgba(224,233,240,.55); font-size: .72rem; }
  .primary-action { display: inline-flex; min-height: 50px; align-items: center; padding: 0 1.2rem; border: 1px solid rgba(244,242,236,.58); font-size: .78rem; transition: background 180ms ease,color 180ms ease; }
  .primary-action:hover, .primary-action:focus-visible { background: #f4f2ec; color: #07111f; }
  .product-screen { position: absolute; top: 52%; right: 13vw; z-index: 2; width: clamp(210px,19vw,310px); margin: 0; transform: translateY(-50%) rotate(3deg); overflow: hidden; border: 7px solid #090d15; border-radius: 2rem; box-shadow: 0 34px 100px rgba(0,0,0,.52); }
  .product-hero--seed .product-screen { transform: translateY(-50%) rotate(-2deg); }
  .product-screen img { display: block; width: 100%; height: auto; }

  .overview { display: grid; grid-template-columns: minmax(18rem,.75fr) minmax(0,1.35fr); gap: 8vw; padding: clamp(7rem,11vw,11rem) 6.2vw; background: var(--paper); color: #07111f; }
  .overview .eyebrow { color: rgba(7,17,31,.45); }
  .overview h2, .state-section h2, .related h2 { margin: 1.5rem 0 0; font-size: clamp(2.4rem,4.4vw,5rem); font-weight: 490; letter-spacing: -.06em; line-height: 1.05; }
  .overview-copy>p:last-child { margin: 2rem 0 0; color: rgba(7,17,31,.66); line-height: 1.85; }
  .fact-list { border-top: 1px solid rgba(7,17,31,.18); }
  .fact { display: grid; grid-template-columns: 3.5rem minmax(8rem,.7fr) 1.4fr; gap: 1rem; padding: 2rem 0; border-bottom: 1px solid rgba(7,17,31,.18); }
  .fact span { color: rgba(7,17,31,.42); font-size: .7rem; }
  .fact h3, .fact p { margin: 0; }
  .fact h3 { font-size: 1rem; font-weight: 620; }
  .fact p { color: rgba(7,17,31,.62); font-size: .85rem; line-height: 1.7; }

  .state-section { display: grid; grid-template-columns: 1fr 1fr; gap: 8vw; padding: clamp(6rem,10vw,10rem) 6.2vw; background: #071628; }
  .state-copy { padding-top: 2.2rem; border-top: 1px solid rgba(228,236,242,.2); }
  .state-copy strong { font-size: 1.2rem; font-weight: 600; }
  .state-copy p { max-width: 34rem; margin: 1rem 0 0; color: rgba(228,236,242,.58); line-height: 1.75; }

  .related { padding: clamp(6rem,10vw,10rem) 6.2vw; background: #020b16; }
  .related-list { margin-top: 3rem; border-top: 1px solid rgba(228,236,242,.18); }
  .related-list a { display: grid; grid-template-columns: 3rem .7fr 1.4fr; gap: 1rem; min-height: 6rem; align-items: center; border-bottom: 1px solid rgba(228,236,242,.18); }
  .related-list a[aria-current='page'] { color: var(--accent); }
  .related-list span { color: rgba(228,236,242,.4); font-size: .7rem; }
  .related-list strong { font-size: 1.15rem; }
  .related-list em { color: rgba(228,236,242,.58); font-size: .82rem; font-style: normal; }
  .room-footer { display: flex; min-height: 6rem; align-items: center; justify-content: space-between; padding: 0 6.2vw; border-top: 1px solid rgba(228,236,242,.14); background: #020b16; color: rgba(228,236,242,.48); font-size: .7rem; }
  .room-footer a { padding-bottom: .25rem; border-bottom: 1px solid currentColor; }
  .room-footer nav { display: flex; gap: 1.4rem; }

  .reveal { opacity: 0; transform: translateY(22px); transition: opacity 850ms cubic-bezier(.16,1,.3,1),transform 850ms cubic-bezier(.16,1,.3,1); }
  .product-copy.reveal, .product-screen.reveal { transform: translateY(calc(-50% + 22px)); }
  .reveal.is-visible { opacity: 1; transform: translateY(0); }
  .product-copy.reveal.is-visible { transform: translateY(-50%); }
  .product-screen.reveal.is-visible { transform: translateY(-50%) rotate(3deg); }
  .product-hero--seed .product-screen.reveal.is-visible { transform: translateY(-50%) rotate(-2deg); }

  @media (max-width: 800px) {
    .room-nav { padding: 0 1.25rem; }
    .room-nav nav a:not(:last-child) { display: none; }
    .product-hero { min-height: 790px; }
    .scene-image { object-position: 54% center; }
    .scene-shade { background: rgba(2,8,17,.38); }
    .product-copy { top: 8rem; left: 1.25rem; width: calc(100% - 2.5rem); transform: none; }
    .product-copy.reveal { transform: translateY(22px); }
    .product-copy.reveal.is-visible { transform: translateY(0); }
    .product-copy h1 { font-size: clamp(4.5rem,23vw,7rem); }
    .product-screen { top: auto; right: 1.25rem; bottom: 1.5rem; width: clamp(160px,42vw,220px); border-width: 5px; border-radius: 1.4rem; }
    .overview, .state-section { grid-template-columns: 1fr; gap: 4rem; }
    .overview, .state-section, .related { padding-right: 1.25rem; padding-left: 1.25rem; }
    .fact { grid-template-columns: 2.5rem 1fr; }
    .fact p { grid-column: 2; }
    .related-list a { grid-template-columns: 2.5rem 1fr; padding: 1.2rem 0; }
    .related-list em { grid-column: 2; }
    .room-footer { flex-direction: column; align-items: flex-start; justify-content: center; gap: .6rem; padding: 1.5rem 1.25rem; }
    .room-footer nav { flex-wrap: wrap; gap: .6rem 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal, .product-copy.reveal, .product-screen.reveal { opacity: 1; transform: none; transition: none; }
  }
</style>
