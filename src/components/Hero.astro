---
import { strings, type Locale } from '../i18n/strings';
import AuroraOrb from './AuroraOrb.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings[locale];
const titleLines = t.hero.title.split('\n');
---

<section class="relative overflow-hidden hero-section">
  <AuroraOrb />

  <div class="relative z-10 max-w-6xl mx-auto w-full px-6 pt-20 md:pt-36 pb-24 md:pb-40">
    <p class="text-xs uppercase tracking-[0.22em] text-[--color-muted] font-medium mb-8 hero-eyebrow inline-flex items-center gap-2">
      <span class="eyebrow-bar"></span>
      <span>{t.hero.eyebrow}</span>
    </p>

    <h1 class="hero-title font-bold tracking-[-0.04em] leading-[0.92] whitespace-pre-line">
      {titleLines.map((line, lineIdx) => (
        <span class="block hero-line" data-line={lineIdx}>
          {Array.from(line).map((ch, ci) => (
            <span
              class="hero-char"
              style={`--ci: ${ci}; --li: ${lineIdx};`}
            >{ch === ' ' ? ' ' : ch}</span>
          ))}
        </span>
      ))}
    </h1>

    <p class="mt-12 text-base md:text-lg text-[--color-muted] max-w-2xl leading-relaxed hero-lead">
      {t.hero.lead}
    </p>
  </div>

  <div class="hero-scroll-hint" aria-hidden="true">
    <span></span>
  </div>
</section>

<style>
  .hero-section {
    min-height: 92vh;
    display: flex;
    align-items: center;
  }

  .eyebrow-bar {
    display: inline-block;
    width: 28px;
    height: 1px;
    background: currentColor;
    transform-origin: left;
    animation: bar-grow 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes bar-grow {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }
  .hero-eyebrow span:last-child {
    opacity: 0;
    animation: fade-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero-title {
    font-size: clamp(3.5rem, 13vw, 11rem);
  }

  .hero-char {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.6em) rotate(6deg);
    animation: char-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(0.55s + (var(--li) * 0.18s) + (var(--ci) * 0.024s));
    transition: color 380ms cubic-bezier(0.16, 1, 0.3, 1), transform 380ms cubic-bezier(0.16, 1, 0.3, 1);
    cursor: default;
    transform-origin: bottom;
  }
  @keyframes char-in {
    to { opacity: 1; transform: translateY(0) rotate(0); }
  }
  .hero-title:hover .hero-char {
    color: rgba(24, 24, 27, 0.35);
  }
  .hero-line .hero-char:hover {
    color: #18181b;
    transform: translateY(-6px) scale(1.04);
  }

  .hero-lead {
    opacity: 0;
    animation: fade-up 1.1s cubic-bezier(0.16, 1, 0.3, 1) 1.4s both;
  }

  .hero-scroll-hint {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 56px;
    background: rgba(24, 24, 27, 0.12);
    overflow: hidden;
    z-index: 5;
  }
  .hero-scroll-hint span {
    display: block;
    width: 100%;
    height: 50%;
    background: #18181b;
    animation: scroll-hint 2.4s ease-in-out infinite 2s;
  }
  @keyframes scroll-hint {
    0%   { transform: translateY(-100%); }
    100% { transform: translateY(200%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .eyebrow-bar,
    .hero-eyebrow span:last-child,
    .hero-char,
    .hero-lead,
    .hero-scroll-hint span {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
