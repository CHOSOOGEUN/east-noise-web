---
import { strings, type Locale } from '../i18n/strings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings[locale];
---

<section class="max-w-5xl mx-auto w-full px-6 pt-16 md:pt-32 pb-20">
  <p class="text-xs uppercase tracking-[0.18em] text-[--color-muted] font-medium mb-6">
    {t.hero.eyebrow}
  </p>
  <h1 class="text-4xl md:text-6xl font-bold tracking-tight leading-[1.1] whitespace-pre-line mb-8">
    {t.hero.title}
  </h1>
  <p class="text-base md:text-lg text-[--color-muted] max-w-2xl leading-relaxed">
    {t.hero.lead}
  </p>
</section>
