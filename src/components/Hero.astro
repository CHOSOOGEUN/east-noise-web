---
import { strings, type Locale } from '../i18n/strings';
import { apps } from '../data/apps';
import SignalScene from './SignalScene.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings[locale];
const titleLines = t.hero.title.split('\n');
const featured = apps.filter((app) => ['luvit', 'seed', 'heum'].includes(app.slug));
const liveCount = apps.filter((app) => app.group === 'live').length;
const labCount = apps.filter((app) => app.group === 'lab' || app.group === 'ops').length;
---

<section class="company-hero" aria-labelledby="home-hero-title" data-company-hero>
  <div class="company-hero__glow" aria-hidden="true"></div>
  <div class="company-hero__shell max-w-6xl mx-auto w-full px-6">
    <div class="company-hero__main">
      <div class="company-hero__copy">
        <h1 id="home-hero-title" class="company-hero__title">
          {titleLines.map((line) => (
            <span>{line}</span>
          ))}
        </h1>
        <p class="company-hero__lead">{t.hero.lead}</p>
        <div class="company-hero__actions">
          <a href="#products" class="hero-action hero-action--primary">
            {t.hero.cta}
            <svg viewBox="0 0 18 18" aria-hidden="true">
              <path d="M3.5 9h10M9.8 4.8 14 9l-4.2 4.2" />
            </svg>
          </a>
          <a href={`mailto:${t.contact.email}`} class="hero-action hero-action--secondary">
            {t.hero.secondaryCta}
          </a>
        </div>
      </div>

      <div class="company-hero__stage" style="--active-accent: #ff6a00;">
        <SignalScene locale={locale} />
        <div class="stage-readout" aria-hidden="true">
          <span>{t.hero.stageLabel}</span>
          <strong>East Noise</strong>
          <p>{t.hero.stageHint}</p>
        </div>
      </div>
    </div>

    <div class="company-hero__board" aria-label={t.hero.channelLabel}>
      <div class="board-summary">
        <span>{locale === 'ko' ? '현재 운영' : 'Operating now'}</span>
        <strong>{liveCount}</strong>
      </div>
      <div class="board-summary">
        <span>{locale === 'ko' ? '심사·실험' : 'Review / Lab'}</span>
        <strong>{apps.length - liveCount}</strong>
      </div>
      <div class="board-summary">
        <span>{locale === 'ko' ? '실험실' : 'Lab systems'}</span>
        <strong>{labCount}</strong>
      </div>
      <div class="hero-product-strip">
        {featured.map((app) => {
          const copy = app.copy[locale];
          return (
            <a
              href={app.links?.web?.startsWith('/') ? (locale === 'en' ? `/en${app.links.web}` : app.links.web) : app.links?.web ?? '#products'}
              class="hero-product-chip"
              style={`--accent: ${app.accent}`}
              data-accent={app.accent}
              data-product-chip
              target={app.links?.web?.startsWith('http') ? '_blank' : undefined}
              rel={app.links?.web?.startsWith('http') ? 'noopener' : undefined}
            >
              <span>{copy.shortName}</span>
              <small>{app.status[locale]}</small>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-company-hero]');
  if (hero) {
    const chips = hero.querySelectorAll<HTMLElement>('[data-product-chip]');
    const setAccent = (accent: string) => {
      hero.style.setProperty('--active-accent', accent);
      window.dispatchEvent(new CustomEvent('east-noise:accent', { detail: { accent } }));
    };

    const onMove = (event: PointerEvent) => {
      const rect = hero.getBoundingClientRect();
      hero.style.setProperty('--mx', `${((event.clientX - rect.left) / rect.width) * 100}%`);
      hero.style.setProperty('--my', `${((event.clientY - rect.top) / rect.height) * 100}%`);
    };

    hero.addEventListener('pointermove', onMove);
    chips.forEach((chip) => {
      const accent = chip.dataset.accent;
      if (!accent) return;
      chip.addEventListener('pointerenter', () => setAccent(accent));
      chip.addEventListener('focus', () => setAccent(accent));
    });
  }
</script>

<style>
  .company-hero {
    --active-accent: #ff6a00;
    --mx: 58%;
    --my: 38%;
    position: relative;
    min-height: calc(100vh - 68px);
    overflow: hidden;
    border-top: 1px solid rgba(70, 38, 16, 0.14);
    background:
      radial-gradient(circle at var(--mx) var(--my), color-mix(in srgb, var(--active-accent) 18%, transparent), transparent 28rem),
      linear-gradient(145deg, #fff8ec 0%, #fff2df 34%, #ffffff 68%);
  }

  .company-hero__glow {
    position: absolute;
    inset: auto -12vw -26vh -12vw;
    height: 46vh;
    background:
      radial-gradient(ellipse at 50% 100%, rgba(255, 106, 0, 0.42), transparent 62%),
      linear-gradient(90deg, rgba(255, 185, 87, 0), rgba(255, 111, 0, 0.28), rgba(255, 185, 87, 0));
    filter: blur(28px);
    pointer-events: none;
  }

  .company-hero__shell {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: calc(100vh - 68px);
    flex-direction: column;
    justify-content: space-between;
    gap: 34px;
    padding-top: 5.5rem;
    padding-bottom: 2.4rem;
  }

  .company-hero__main {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.78fr);
    gap: 4.5rem;
    align-items: center;
  }

  .company-hero__copy {
    min-width: 0;
  }

  .company-hero__title {
    margin: 0;
    color: #130d08;
    font-size: 4.55rem;
    font-weight: 860;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .company-hero__title span {
    display: block;
  }

  :global(html[lang='en']) .company-hero__title {
    font-size: 4.45rem;
  }

  .company-hero__lead {
    max-width: 720px;
    margin: 28px 0 0;
    color: #5b4532;
    font-size: 1.16rem;
    line-height: 1.78;
    letter-spacing: 0;
  }

  .company-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .hero-action {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 999px;
    padding: 0 19px;
    font-size: 14px;
    font-weight: 780;
    letter-spacing: 0;
    transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1), border-color 180ms ease, background-color 180ms ease;
  }

  .hero-action svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-width: 1.85;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
  }

  .hero-action:hover {
    transform: translateY(-2px);
  }

  .hero-action--primary {
    background: #15100b;
    color: #ffffff;
  }

  .hero-action--secondary {
    border: 1px solid rgba(70, 38, 16, 0.24);
    background: rgba(255, 255, 255, 0.54);
    color: #15100b;
  }

  .company-hero__stage {
    position: relative;
    min-width: 0;
    border-radius: 999px;
  }

  .stage-readout {
    position: absolute;
    right: 2%;
    bottom: 8%;
    display: grid;
    gap: 3px;
    min-width: 168px;
    padding: 15px 16px;
    border: 1px solid rgba(70, 38, 16, 0.16);
    border-radius: 8px;
    background: rgba(255, 250, 242, 0.74);
    color: #130d08;
    box-shadow: 0 18px 44px rgba(103, 53, 10, 0.12);
    backdrop-filter: blur(14px);
  }

  .stage-readout span,
  .stage-readout p {
    margin: 0;
    color: #7a5a40;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.4;
  }

  .stage-readout strong {
    font-size: 22px;
    font-weight: 850;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .company-hero__board {
    display: grid;
    grid-template-columns: repeat(3, minmax(92px, 0.12fr)) minmax(0, 1fr);
    gap: 12px;
    align-items: stretch;
  }

  .board-summary,
  .hero-product-chip {
    min-height: 74px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border: 1px solid rgba(70, 38, 16, 0.16);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(12px);
  }

  .board-summary {
    padding: 12px 14px;
  }

  .board-summary span {
    color: #7a5a40;
    font-size: 11px;
    font-weight: 740;
  }

  .board-summary strong {
    color: #130d08;
    font-size: 32px;
    font-weight: 850;
    line-height: 1;
  }

  .hero-product-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .hero-product-chip {
    min-width: 0;
    padding: 12px 14px;
    color: #130d08;
    transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1), background-color 180ms ease, border-color 180ms ease;
  }

  .hero-product-chip:hover,
  .hero-product-chip:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 52%, rgba(70, 38, 16, 0.16));
    background: color-mix(in srgb, var(--accent) 11%, #ffffff);
    transform: translateY(-3px);
    outline: none;
  }

  .hero-product-chip span {
    font-size: 1.12rem;
    font-weight: 850;
    line-height: 1.05;
  }

  .hero-product-chip small {
    margin-top: 7px;
    color: #7a5a40;
    font-size: 11px;
    font-weight: 680;
    line-height: 1.35;
  }

  @media (max-width: 940px) {
    .company-hero__shell {
      min-height: auto;
      padding-top: 4rem;
    }

    .company-hero__main,
    .company-hero__board {
      grid-template-columns: 1fr;
    }

    .company-hero__stage {
      order: -1;
    }

    .company-hero__main {
      gap: 2.25rem;
    }

    .company-hero__title,
    :global(html[lang='en']) .company-hero__title {
      font-size: 4rem;
    }

    .hero-product-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 580px) {
    .company-hero__shell {
      padding-top: 34px;
    }

    .company-hero__title {
      font-size: 2.68rem;
    }

    :global(html[lang='en']) .company-hero__title {
      font-size: 2.56rem;
    }

    .company-hero__lead {
      margin-top: 22px;
      font-size: 15.5px;
      line-height: 1.72;
    }

    .company-hero__actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .stage-readout {
      right: 0;
      bottom: 0;
    }

    .hero-product-strip {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-action,
    .hero-product-chip {
      transition: none;
    }
  }
</style>
