const initial = copy.en[page];
---

<article class="scene-info" data-scene-info data-page={page}>
  <div class="ambient" aria-hidden="true"></div>

  <header class="scene-nav">
    <a href="/" class="brand" aria-label="East Noise home">SCENE <span>BY EAST NOISE</span></a>
    <select id="scene-locale" aria-label="Language">
      {Object.entries(copy).map(([locale, item]) => <option value={locale}>{item.language}</option>)}
    </select>
  </header>

  <main>
    <header class="scene-hero">
      <p data-field="kicker">{initial.kicker}</p>
      <h1 data-field="title">{initial.title}</h1>
      <span data-field="lead">{initial.lead}</span>
      <em data-field="updated">{initial.updated}</em>
    </header>

    <div class="scene-sections">
      {initial.sections.map(([heading, body], index) => (
        <section>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h2 data-section-heading={index}>{heading}</h2>
            <p data-section-body={index}>{body}</p>
          </div>
        </section>
      ))}
    </div>

    <section class="scene-contact">
      <p data-field="contact">Contact</p>
      <a href="mailto:eastnoise26@gmail.com">eastnoise26@gmail.com</a>
    </section>
  </main>

  <footer>
    <span>© 2026 East Noise</span>
    <nav aria-label="SCENE documents">
      <a href="/scene/support" data-field="supportLink">Support</a>
      <a href="/legal/scene/privacy" data-field="privacyLink">Privacy</a>
    </nav>
  </footer>

  <script is:inline id="scene-info-copy" type="application/json" set:html={JSON.stringify(copy)}></script>
</article>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-scene-info]');
    const source = document.getElementById('scene-info-copy');
    const select = document.getElementById('scene-locale');
    if (!(root instanceof HTMLElement) || !(source instanceof HTMLScriptElement) || !(select instanceof HTMLSelectElement)) return;

    const allCopy = JSON.parse(source.textContent || '{}');
    const supported = Object.keys(allCopy);
    const resolveLocale = (value) => {
      if (!value) return null;
      const normalized = value.toLowerCase();
      const exact = supported.find((locale) => locale.toLowerCase() === normalized);
      if (exact) return exact;
      if (normalized.startsWith('pt')) return 'pt-BR';
      if (normalized.startsWith('zh-hant') || /zh-(tw|hk|mo)/.test(normalized)) return 'zh-Hant';
      if (normalized.startsWith('zh')) return 'zh-Hans';
      const base = normalized.split('-')[0];
      return supported.includes(base) ? base : null;
    };
    const requested = new URLSearchParams(window.location.search).get('lang');
    const initialLocale = resolveLocale(requested) || resolveLocale(navigator.language) || 'en';

    const applyLocale = (locale) => {
      const localeCopy = allCopy[locale];
      const pageCopy = localeCopy[root.dataset.page];
      if (!localeCopy || !pageCopy) return;

      document.documentElement.lang = locale;
      select.value = locale;
      ['kicker', 'title', 'lead', 'updated'].forEach((field) => {
        const element = root.querySelector(`[data-field="${field}"]`);
        if (element) element.textContent = pageCopy[field];
      });
      ['supportLink', 'privacyLink', 'contact'].forEach((field) => {
        const element = root.querySelector(`[data-field="${field}"]`);
        if (element) element.textContent = localeCopy[field];
      });
      pageCopy.sections.forEach(([heading, body], index) => {
        const headingElement = root.querySelector(`[data-section-heading="${index}"]`);
        const bodyElement = root.querySelector(`[data-section-body="${index}"]`);
        if (headingElement) headingElement.textContent = heading;
        if (bodyElement) bodyElement.textContent = body;
      });
      document.title = `${pageCopy.title} — SCENE`;
    };

    applyLocale(initialLocale);
    select.addEventListener('change', () => {
      applyLocale(select.value);
      const url = new URL(window.location.href);
      url.searchParams.set('lang', select.value);
      window.history.replaceState({}, '', url);
    });
  })();
</script>

<style>
  .scene-info {
    --canvas: #050608;
    --raised: #0d1012;
    --ink: #f6f7f8;
    --muted: #a4a9ae;
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background: var(--canvas);
    color: var(--ink);
  }

  .ambient {
    position: absolute;
    inset: -12rem -20vw auto;
    height: 44rem;
    pointer-events: none;
    background:
      radial-gradient(circle at 28% 28%, rgba(119, 147, 255, 0.34), transparent 38%),
      radial-gradient(circle at 72% 40%, rgba(255, 126, 103, 0.22), transparent 34%);
    filter: blur(28px);
    opacity: 0.88;
  }

  .scene-nav,
  .scene-hero,
  .scene-sections,
  .scene-contact,
  footer {
    position: relative;
    z-index: 1;
  }

  .scene-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76px;
    padding: 0 6.7vw;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(5, 6, 8, 0.62);
    backdrop-filter: blur(24px) saturate(130%);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.84rem;
    font-weight: 720;
    letter-spacing: 0.14em;
  }

  .brand span { color: var(--muted); font-size: 0.58rem; font-weight: 620; }

  select {
    min-width: 8.5rem;
    min-height: 44px;
    padding: 0 2.2rem 0 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    background: rgba(18, 21, 25, 0.82);
    color: var(--ink);
    font: inherit;
  }

  .scene-hero {
    display: flex;
    min-height: 35rem;
    flex-direction: column;
    justify-content: flex-end;
    padding: 8rem 6.7vw 5.5rem;
  }

  .scene-hero p,
  .scene-hero em {
    margin: 0;
    color: rgba(246, 247, 248, 0.64);
    font-size: 0.72rem;
    font-style: normal;
    font-weight: 680;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .scene-hero h1 {
    max-width: 61rem;
    margin: 2.2rem 0 1.4rem;
    font-size: clamp(3.4rem, 8vw, 7.5rem);
    font-weight: 650;
    letter-spacing: -0.055em;
    line-height: 0.96;
  }

  .scene-hero > span {
    display: block;
    max-width: 44rem;
    color: rgba(246, 247, 248, 0.78);
    font-size: clamp(1rem, 1.6vw, 1.22rem);
    line-height: 1.7;
  }

  .scene-hero em { margin-top: 2rem; letter-spacing: 0; text-transform: none; }

  .scene-sections { padding: 3rem 6.7vw 8rem; }

  .scene-sections section {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 2rem;
    max-width: 72rem;
    padding: 3.5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .scene-sections section > span { color: #737980; font-size: 0.75rem; }

  .scene-sections h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.45rem, 2.6vw, 2.15rem);
    font-weight: 590;
    letter-spacing: -0.025em;
  }

  .scene-sections p {
    max-width: 52rem;
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.85;
  }

  .scene-contact {
    padding: 6rem 6.7vw;
    background: var(--raised);
    border-block: 1px solid rgba(255, 255, 255, 0.10);
