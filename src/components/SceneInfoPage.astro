---
type PageType = 'support' | 'privacy';

interface Props {
  page: PageType;
}

const { page } = Astro.props;

const copy = {
  en: {
    language: 'English',
    support: {
      kicker: 'SCENE · SUPPORT',
      title: 'Private sound. Clear answers.',
      lead: 'Everything you need to start a mood, recover from an interruption, or contact East Noise.',
      updated: 'Updated August 26, 2026',
      sections: [
        ['Before you start', 'Connect wired or Bluetooth headphones, choose a mood, and tap Start. Allow microphone access when iOS asks. Use SCENE only in a safe place—never while driving, cycling, or crossing a road.'],
        ['If microphone access is off', 'Open iOS Settings, find SCENE, and enable Microphone. Return to the app and choose Try Again. Without microphone access, the live reactive-audio experience cannot start.'],
        ['If audio is interrupted', 'Reconnect your headphones, confirm they are selected as the output, and try again. An active four-minute scene continues in the background and, when Live Activities are enabled, shows its remaining time there. It stops immediately if the route is lost or another audio session interrupts it.'],
        ['What SCENE does with sound', 'Nearby sound is processed live in memory on your iPhone. It is never recorded, saved, transcribed, uploaded, or retained. SCENE has no account, ads, trackers, analytics SDKs, cloud service, or AI.'],
        ['Contact support', 'Email eastnoise26@gmail.com with the app version, iOS version, headphone model, and the state shown in the app. Do not send recordings or sensitive content.'],
      ],
    },
    privacy: {
      kicker: 'SCENE · PRIVACY',
      title: 'Your sound stays with you.',
      lead: 'This policy explains what happens to microphone audio and other data when you use SCENE.',
      updated: 'Effective August 26, 2026',
      sections: [
        ['Microphone audio', 'SCENE uses the microphone only after you tap Start, grant permission, and connect supported headphones. Audio is processed live in device memory to apply effects and drive the reactive visual. It is never recorded, saved, transcribed, uploaded, or retained. An active scene continues for up to four minutes in the background and stops when you stop, the session ends, the route is lost, or an interruption occurs.'],
        ['Data collection and sharing', 'SCENE stores only your sound-effect and haptic choices in its private storage on this iPhone; deleting the app removes them. SCENE does not create accounts or include analytics, advertising, tracking, cloud storage, or network uploads. East Noise does not collect, sell, or share personal or usage data through the app.'],
        ['Your choices', 'Microphone access is optional until you start a mood. You may deny or revoke it at any time in iOS Settings. Without access, SCENE cannot start the live experience. During a scene, iOS may show its mood and remaining time in a Live Activity on the Dynamic Island and Lock Screen; you can manage Live Activities in iOS Settings and stop the scene in SCENE at any time.'],
        ['Children', 'SCENE is not directed to children and does not knowingly collect personal information from children. The app does not collect personal data.'],
        ['Changes and contact', 'If SCENE’s data practices change, East Noise will update this policy and its effective date before releasing the changed behavior. Questions can be sent to eastnoise26@gmail.com.'],
