    experienceBody: 'We start with the real operating journey, not decorative effects. Using confirmed information and supplied materials, we build quickly and review the experience on mobile and desktop.',
    steps: [
      ['Start with the place and its customer journey.', 'We review existing links and materials to decide what a first-time customer needs to know and do.'],
      ['Align quickly through a production example.', 'We create an opening direction that fits the business, then review only confirmed information together.'],
      ['Publish one address and keep refining it.', 'Menus, directions, reservations, and inquiries stay easy to use across mobile and desktop.'],
    ],
    screens: [
      { src: '/visuals/company/heum-studio-work.webp', alt: 'HEUM website production examples for different local businesses', label: 'PRODUCTION EXAMPLES / DESKTOP' },
      { src: '/visuals/company/heum-studio-mobile.webp', alt: 'HEUM web studio opening screen on mobile', label: 'OPENING / MOBILE' },
    ],
    closing: 'The next scene belongs to your place.',
    closingBody: 'Bring the character of your business and the customer’s next action into one address.',
  },
};

const page = (isKo ? ko : en)[slug];

const productNav = (['luvit', 'seed', 'alpha', 'heum'] as ProductSlug[]).map((item) => ({
  slug: item,
  number: (isKo ? ko : en)[item].number.split(' / ')[0],
  name: (isKo ? ko : en)[item].name,
  category: (isKo ? ko : en)[item].category,
  href: isKo ? `/${item}` : `/en/${item}`,
  accent: (isKo ? ko : en)[item].accent,
}));

const screenSizes: Record<string, [number, number]> = {
  '/visuals/company/luvit-current-mission.webp': [900, 1956],
  '/visuals/company/luvit-current-home.webp': [900, 1956],
  '/visuals/company/seed-current-today.webp': [900, 1951],
  '/visuals/company/seed-current-story.webp': [900, 1951],
  '/visuals/company/alpha-store-today-2026-08.webp': [1320, 2868],
  '/visuals/company/alpha-store-course-2026-08.webp': [1320, 2868],
  '/visuals/company/heum-studio-work.webp': [1440, 1024],
  '/visuals/company/heum-studio-mobile.webp': [390, 844],
};

const labels = isKo
  ? { overview: '소개', experience: '경험', product: '제품', contact: '문의', open: '새 창', next: '다른 제품', top: '위로', legal: '법적 고지' }
  : { overview: 'Overview', experience: 'Experience', product: 'Product', contact: 'Contact', open: 'new tab', next: 'Other products', top: 'Back to top', legal: 'Legal' };
---

<div class:list={['product-world-page', `product-world-page--${slug}`]} style={`--accent:${page.accent};--soft:${page.soft};--product-ink:${page.ink}`} data-product-world>
  <a class="skip-link" href="#main-content">{isKo ? '본문으로 이동' : 'Skip to content'}</a>
  <div class="scroll-progress" aria-hidden="true"><span></span></div>

  <header class="product-header">
    <a class="wordmark" href={homeUrl} aria-label={isKo ? '동방의 소음 홈' : 'East Noise home'}>동방의 소음</a>
    <nav class="section-nav" aria-label={isKo ? '페이지 메뉴' : 'Page navigation'}>
      <a href="#overview" data-section-link="overview">{labels.overview}</a>
      <a href="#experience" data-section-link="experience">{labels.experience}</a>
      <a href="#product" data-section-link="product">{labels.product}</a>
    </nav>
    <div class="header-actions">
      <a href="#contact">{labels.contact}</a>
      <span aria-hidden="true"></span>
      <a href={languageUrl} lang={isKo ? 'en' : 'ko'}>{languageLabel}</a>
    </div>
  </header>

  <main id="main-content">
    <section class="product-hero" aria-labelledby="product-title">
      <div class="hero-copy reveal is-visible">
        <p class="eyebrow"><span>{page.number}</span>{page.category}</p>
        <h1 id="product-title">{page.name}</h1>
        <h2>{page.heroTitle.split('\n').map((line) => <span>{line}</span>)}</h2>
        <p class="hero-body">{page.heroBody}</p>
        <p class="status"><span aria-hidden="true"></span>{page.status}</p>
        <div class="hero-actions">
          {page.ctas.map((cta) => (
            <a class:list={['hero-cta', { 'hero-cta--quiet': cta.quiet }]} href={cta.href} target="_blank" rel="noreferrer">
              {cta.label}<span aria-hidden="true">↗</span><span class="sr-only"> ({labels.open})</span>
            </a>
          ))}
        </div>
      </div>

      <figure class="hero-world reveal is-visible">
        <img src={page.heroImage} alt={page.heroAlt} width={page.heroWidth} height={page.heroHeight} loading="eager" fetchpriority="high" />
      </figure>

      <dl class="hero-stats reveal is-visible">
        {page.stats.map(([value, label]) => (
          <div><dt>{value}</dt><dd>{label}</dd></div>
        ))}
      </dl>
    </section>

    <section class="overview" id="overview" aria-labelledby="overview-title" data-section="overview">
      <div class="section-index reveal"><span>{page.number.split(' / ')[0]}</span><span>{page.name}</span></div>
      <div class="overview-copy reveal">
        <p class="eyebrow">{labels.overview}</p>
        <h2 id="overview-title">{page.statement}</h2>
      </div>
      <p class="overview-body reveal">{page.intro}</p>
    </section>

    <section class="experience" id="experience" aria-labelledby="experience-title" data-section="experience">
      <div class="experience-heading reveal">
        <p class="eyebrow">{labels.experience}</p>
        <h2 id="experience-title">{page.experienceTitle.split('\n').map((line) => <span>{line}</span>)}</h2>
        <p>{page.experienceBody}</p>
      </div>

      <div class="step-list">
        {page.steps.map(([title, body], index) => (
          <article class="step-row reveal">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="product-evidence" id="product" aria-label={isKo ? `${page.name} 실제 제품 화면` : `${page.name} real product screens`} data-section="product">
      <div class="evidence-heading reveal">
        <p class="eyebrow">{labels.product}</p>
        <h2>{isKo ? '설명보다, 실제 화면으로.' : 'The product, not a promise.'}</h2>
      </div>
      <div class="screen-pair">
        {page.screens.map((screen, index) => (
          <figure class:list={['screen-shot', `screen-shot--${index + 1}`, 'reveal']}>
            <figcaption><span>{screen.label}</span><span>{String(index + 1).padStart(2, '0')}</span></figcaption>
            <img src={screen.src} alt={screen.alt} width={screenSizes[screen.src][0]} height={screenSizes[screen.src][1]} loading="lazy" />
          </figure>
        ))}
      </div>
    </section>

    <section class="product-closing" id="contact" aria-labelledby="closing-title">
      <p class="eyebrow reveal">{page.name} / EAST NOISE</p>
      <h2 id="closing-title" class="reveal">{page.closing}</h2>
      <p class="reveal">{page.closingBody}</p>
      <div class="closing-actions reveal">
        <a href={page.ctas[0].href} target="_blank" rel="noreferrer">{page.ctas[0].label}<span aria-hidden="true">↗</span></a>
        <a href={`mailto:${t.contact.email}?subject=${encodeURIComponent(page.name)}`}>{labels.contact}<span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="other-products" aria-labelledby="other-products-title">
      <p class="eyebrow" id="other-products-title">{labels.next}</p>
      <nav aria-label={labels.next}>
        {productNav.map((product) => (
          <a href={product.href} aria-current={product.slug === slug ? 'page' : undefined} style={`--item-accent:${product.accent}`}>
            <span class="other-index">{product.number}</span>
            <span class="other-copy"><strong>{product.name}</strong><small>{product.category}</small></span>
            <span aria-hidden="true">↘</span>
          </a>
        ))}
      </nav>
    </section>
  </main>

  <footer class="product-footer">
    <a class="wordmark" href={homeUrl}>동방의 소음</a>
    <div>
      <span>{t.contact.copyright}</span>
      <span>{t.contact.bizNo}</span>
    </div>
    <nav aria-label={labels.legal}>
      {slug === 'seed' && <a href={isKo ? '/legal/seed/privacy' : '/en/legal/seed/privacy'}>{isKo ? '개인정보처리방침' : 'Privacy'}</a>}
      {slug === 'seed' && <a href={isKo ? '/legal/seed/terms' : '/en/legal/seed/terms'}>{isKo ? '이용약관' : 'Terms'}</a>}
      {slug === 'alpha' && <a href={isKo ? '/alpha/support' : '/en/alpha/support'}>{isKo ? '지원' : 'Support'}</a>}
      {slug === 'alpha' && <a href={isKo ? '/legal/alpha/privacy' : '/en/legal/alpha/privacy'}>{isKo ? '개인정보처리방침' : 'Privacy'}</a>}
      {slug === 'alpha' && <a href={isKo ? '/legal/alpha/terms' : '/en/legal/alpha/terms'}>{isKo ? '이용약관' : 'Terms'}</a>}
      <a href="#main-content">{labels.top} ↑</a>
    </nav>
  </footer>
</div>

<script>
  import { initProductMotion } from '../scripts/productMotion';

  const root = document.querySelector<HTMLElement>('[data-product-world]');
  if (root) {
    const cleanupMotion = initProductMotion(root);
    addEventListener('pagehide', cleanupMotion, { once: true });

    const progress = root.querySelector<HTMLElement>('.scroll-progress span');
    const sectionLinks = [...root.querySelectorAll<HTMLAnchorElement>('[data-section-link]')];
    const sections = [...root.querySelectorAll<HTMLElement>('[data-section]')];
    const setCurrentSection = (sectionId: string) => {
      sectionLinks.forEach((link) => {
        if (link.dataset.sectionLink === sectionId) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    if ('IntersectionObserver' in window && sectionLinks.length) {
      const sectionObserver = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible?.target.id) setCurrentSection(visible.target.id);
      }, { threshold: [0.18, 0.35, 0.6], rootMargin: '-20% 0px -55% 0px' });
      sections.forEach((section) => sectionObserver.observe(section));
    }

    let frame = 0;
    const update = () => {
      frame = 0;
      const max = document.documentElement.scrollHeight - innerHeight;
      if (progress) progress.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
    };
    const requestUpdate = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    addEventListener('scroll', requestUpdate, { passive: true });
    update();
  }
</script>

<style>
  .product-world-page {
    --paper: #fbfaf8;
    --ink: #111111;
    --muted: #707177;
    --line: rgba(17, 17, 17, 0.13);
    min-height: 100vh;
    overflow: clip;
    background: var(--paper);
    color: var(--ink);
  }

  .product-world-page[data-motion-active='true'] .reveal {
    transition: none;
  }

  :global(html.motion-booting) .product-world-page .hero-copy,
  :global(html.motion-booting) .product-world-page .hero-world,
  :global(html.motion-booting) .product-world-page .hero-stats {
    opacity: 0;
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 200;
    padding: 0.75rem 1rem;
    background: var(--ink);
    color: #fff;
    transform: translateY(-160%);
  }
  .skip-link:focus { transform: translateY(0); }

  .scroll-progress { position: fixed; inset: 0 0 auto; z-index: 180; height: 2px; }
  .scroll-progress span { display: block; width: 100%; height: 100%; background: var(--accent); transform: scaleX(0); transform-origin: left; }

  .product-header {
    position: sticky;
    top: 0;
    z-index: 120;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 72px;
    padding: 0 clamp(1.5rem, 3.25vw, 3.2rem);
    border-bottom: 1px solid var(--line);
    background: rgba(251, 250, 248, 0.92);
    backdrop-filter: blur(16px);
  }
  .wordmark { font-size: 0.92rem; font-weight: 720; letter-spacing: -0.035em; }
  .section-nav, .header-actions { display: flex; align-items: center; gap: clamp(1.5rem, 3.2vw, 3.25rem); }
  .section-nav a, .header-actions a { display: inline-flex; min-height: 44px; align-items: center; color: #36363a; font-size: 0.78rem; font-weight: 560; }
  .section-nav a { border-bottom: 1px solid transparent; transition: border-color 180ms ease, color 180ms ease; }
  .section-nav a:hover, .section-nav a:focus-visible, .section-nav a[aria-current='location'] { border-bottom-color: var(--accent); color: var(--accent); }
  .header-actions { justify-self: end; }
  .header-actions > span { width: 4px; height: 4px; border-radius: 50%; background: #c3c4c8; }

  .product-hero {
    position: relative;
    min-height: calc(100svh - 72px);
    padding: clamp(5.5rem, 10vh, 8.5rem) clamp(1.5rem, 6vw, 6.5rem) 0;
    border-bottom: 1px solid var(--line);
    isolation: isolate;
  }
  section[id] { scroll-margin-top: 72px; }
  .hero-copy { position: relative; z-index: 2; width: min(35rem, 41vw); padding-bottom: 11rem; }
  .eyebrow { margin: 0; color: var(--muted); font-size: 0.68rem; font-weight: 650; letter-spacing: 0.12em; text-transform: uppercase; }
  .eyebrow > span { margin-right: 0.8rem; color: var(--accent); }
  .hero-copy h1 { margin: 1.35rem 0 0; color: var(--accent); font-size: clamp(1rem, 1.25vw, 1.25rem); font-weight: 720; letter-spacing: 0.04em; }
  .hero-copy h2 { margin: 1.55rem 0 0; font-size: clamp(3.2rem, 5.5vw, 6.2rem); font-weight: 720; letter-spacing: -0.075em; line-height: 0.98; }
  .hero-copy h2 span { display: block; }
  .hero-body { max-width: 31rem; margin: 2rem 0 0; color: #5f6065; font-size: clamp(0.98rem, 1.15vw, 1.12rem); line-height: 1.8; }
  .status { display: flex; align-items: center; gap: 0.55rem; margin: 1.6rem 0 0; color: #77787d; font-size: 0.73rem; }
  .status span { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 12%, transparent); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.55rem 1.25rem; margin-top: 2rem; }
  .hero-cta { display: inline-flex; min-height: 50px; align-items: center; justify-content: space-between; gap: 2rem; padding: 0 1.15rem; border: 1px solid var(--product-ink); background: var(--product-ink); color: #fff; font-size: 0.78rem; font-weight: 650; transition: border-color 180ms ease, background 180ms ease, color 180ms ease, transform 180ms ease; }
  .hero-cta--quiet { border-color: var(--line); background: transparent; color: var(--ink); }
  .hero-cta:hover, .hero-cta:focus-visible { border-color: var(--accent); background: var(--accent); color: #fff; transform: translateY(-2px); }
  .hero-cta:active, .closing-actions a:active, .other-products a:active { transform: scale(0.975); }

  .hero-world { position: absolute; right: -2.5%; bottom: 7.5rem; z-index: 1; width: min(68vw, 1120px); margin: 0; pointer-events: none; }
  .hero-world img { display: block; width: 100%; height: auto; }
  .product-world-page--heum .hero-world { right: 2.5%; bottom: 9.5rem; width: min(51vw, 820px); }
  .product-world-page--heum .hero-world img { border: 8px solid rgba(255,255,255,.88); border-radius: 24px; box-shadow: 0 28px 80px rgba(30, 56, 104, .2); }
  .hero-stats { position: absolute; inset: auto 0 0; z-index: 3; display: grid; grid-template-columns: repeat(3, 1fr); min-height: 7.5rem; margin: 0; border-top: 1px solid var(--line); background: rgba(251, 250, 248, 0.88); backdrop-filter: blur(12px); }
  .hero-stats div { display: flex; flex-direction: column; justify-content: center; padding: 1rem clamp(1.5rem, 4vw, 4.8rem); border-right: 1px solid var(--line); }
  .hero-stats div:last-child { border-right: 0; }
  .hero-stats dt { color: var(--accent); font-size: clamp(1.1rem, 1.7vw, 1.7rem); font-weight: 730; letter-spacing: -0.035em; }
  .hero-stats dd { margin: 0.42rem 0 0; color: var(--muted); font-size: 0.72rem; }

  .overview { display: grid; grid-template-columns: 0.34fr 1.18fr 0.72fr; gap: clamp(2rem, 6vw, 7rem); padding: clamp(7rem, 11vw, 12rem) clamp(1.5rem, 6vw, 6.5rem); }
  .section-index { display: flex; flex-direction: column; gap: 0.45rem; color: var(--muted); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .section-index span:first-child { color: var(--accent); font-size: 1.5rem; font-weight: 720; letter-spacing: -0.04em; }
  .overview-copy h2 { max-width: 52rem; margin: 1.4rem 0 0; font-size: clamp(2.7rem, 4.7vw, 5.2rem); font-weight: 690; letter-spacing: -0.07em; line-height: 1.08; }
  .overview-body { align-self: end; margin: 0; color: #68696e; font-size: 0.95rem; line-height: 1.9; }

  .experience { display: grid; grid-template-columns: 0.82fr 1.18fr; gap: clamp(4rem, 10vw, 11rem); padding: clamp(7rem, 10vw, 11rem) clamp(1.5rem, 6vw, 6.5rem); background: var(--soft); color: var(--product-ink); }
  .experience-heading { position: sticky; top: 8.5rem; align-self: start; }
  .experience-heading h2 { margin: 1.5rem 0 0; font-size: clamp(2.7rem, 4.6vw, 5rem); font-weight: 700; letter-spacing: -0.07em; line-height: 1.05; }
  .experience-heading h2 span { display: block; }
  .experience-heading > p:last-child { max-width: 31rem; margin: 2rem 0 0; color: color-mix(in srgb, var(--product-ink) 66%, transparent); line-height: 1.85; }
  .step-list { border-top: 1px solid color-mix(in srgb, var(--product-ink) 18%, transparent); }
  .step-row { display: grid; grid-template-columns: 3.5rem 0.84fr 1.16fr; gap: 1.25rem; padding: 2.3rem 0; border-bottom: 1px solid color-mix(in srgb, var(--product-ink) 18%, transparent); }
  .step-row > span { color: var(--accent); font-size: 0.72rem; font-weight: 650; }
  .step-row h3, .step-row p { margin: 0; }
  .step-row h3 { font-size: clamp(1rem, 1.4vw, 1.25rem); font-weight: 700; line-height: 1.5; }
  .step-row p { color: color-mix(in srgb, var(--product-ink) 62%, transparent); font-size: 0.86rem; line-height: 1.8; }

  .product-evidence { padding: clamp(7rem, 11vw, 12rem) clamp(1.5rem, 6vw, 6.5rem); background: #111; color: #fff; }
  .evidence-heading { display: flex; align-items: end; justify-content: space-between; gap: 3rem; }
  .evidence-heading .eyebrow { color: rgba(255,255,255,.5); }
  .evidence-heading h2 { margin: 0; font-size: clamp(2.7rem, 5vw, 5.4rem); font-weight: 690; letter-spacing: -0.07em; }
  .screen-pair { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(1.25rem, 4vw, 4.5rem); align-items: start; max-width: 78rem; margin: 6rem auto 0; }
  .screen-shot { margin: 0; }
  .screen-shot--2 { margin-top: 11rem; }
  .screen-shot figcaption { display: flex; justify-content: space-between; padding: 0 0 0.9rem; border-bottom: 1px solid rgba(255,255,255,.2); color: rgba(255,255,255,.55); font-size: 0.66rem; letter-spacing: 0.1em; }
  .screen-shot img { display: block; width: 100%; max-height: 920px; object-fit: contain; object-position: top center; margin-top: 1.25rem; background: #171717; }
  .product-world-page--heum .screen-pair { grid-template-columns: 1.2fr 0.8fr; max-width: 86rem; }
  .product-world-page--heum .screen-shot img { max-height: 760px; }

  .product-closing { padding: clamp(8rem, 13vw, 14rem) clamp(1.5rem, 6vw, 6.5rem); text-align: center; }
  .product-closing h2 { max-width: 66rem; margin: 1.6rem auto 0; font-size: clamp(3.1rem, 7vw, 8rem); font-weight: 720; letter-spacing: -0.085em; line-height: 0.98; }
  .product-closing > p:not(.eyebrow) { margin: 2rem auto 0; color: var(--muted); }
  .closing-actions { display: flex; justify-content: center; gap: 0.8rem; margin-top: 2.5rem; }
  .closing-actions a { display: inline-flex; min-height: 52px; align-items: center; justify-content: space-between; gap: 2.4rem; padding: 0 1.2rem; border: 1px solid var(--line); font-size: 0.78rem; font-weight: 650; }
  .closing-actions a:first-child { border-color: var(--product-ink); background: var(--product-ink); color: #fff; }
  .closing-actions a:hover, .closing-actions a:focus-visible { border-color: var(--accent); background: var(--accent); color: #fff; }

  .other-products { padding: 0 clamp(1.5rem, 6vw, 6.5rem) clamp(7rem, 10vw, 10rem); }
  .other-products > .eyebrow { padding-bottom: 1.2rem; border-bottom: 1px solid var(--line); }
  .other-products nav { display: grid; grid-template-columns: repeat(4, 1fr); }
  .other-products a { display: grid; grid-template-columns: auto 1fr auto; gap: 0.9rem; min-height: 6.6rem; align-items: center; padding: 0 1.2rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); transition: background 180ms ease, color 180ms ease; }
  .other-products a:first-child { border-left: 1px solid var(--line); }
  .other-products a[aria-current='page'] { background: var(--item-accent); color: #fff; }
  .other-products a:hover, .other-products a:focus-visible { background: color-mix(in srgb, var(--item-accent) 12%, transparent); }
  .other-products a[aria-current='page']:hover, .other-products a[aria-current='page']:focus-visible { background: var(--item-accent); }
  .other-index { color: var(--item-accent); font-size: 0.65rem; font-weight: 720; letter-spacing: 0.08em; }
  .other-copy { display: flex; min-width: 0; flex-direction: column; gap: 0.35rem; }
  .other-copy strong { font-size: 0.94rem; font-weight: 690; }
  .other-copy small { overflow: hidden; color: var(--muted); font-size: 0.64rem; font-weight: 520; text-overflow: ellipsis; white-space: nowrap; }
  .other-products a[aria-current='page'] .other-index,
  .other-products a[aria-current='page'] .other-copy small { color: rgba(255,255,255,.72); }

