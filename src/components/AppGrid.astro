---
import { strings, type Locale } from '../i18n/strings';
import { apps } from '../data/apps';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings[locale];
---

<section class="max-w-5xl mx-auto w-full px-6 py-16 border-t border-[--color-border]">
  <h2 class="text-xs uppercase tracking-[0.18em] text-[--color-muted] font-medium mb-10">
    {t.apps.heading}
  </h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-[--color-border]">
    {apps.map((app) => {
      const copy = app.copy[locale];
      const webHref = app.links?.web
        ? (locale === 'en' && app.links.web.startsWith('/') ? '/en' + app.links.web : app.links.web)
        : null;
      const inner = (
        <>
          <div class="flex items-baseline justify-between mb-6">
            <h3 class="text-2xl font-bold tracking-tight" style={`color: ${app.accent}`}>
              {copy.name}
            </h3>
            <span class="text-[10px] uppercase tracking-wider text-[--color-muted] font-medium">
              {app.status[locale]}
            </span>
          </div>
          <p class="text-sm font-medium mb-3">
            {copy.tagline}
          </p>
          <p class="text-sm text-[--color-muted] leading-relaxed mb-4">
            {copy.description}
          </p>
          {webHref && (
            <span class="text-xs font-semibold tracking-tight inline-flex items-center gap-1" style={`color: ${app.accent}`}>
              {t.apps.cta} →
            </span>
          )}
        </>
      );
      return webHref ? (
        <a href={webHref} class="bg-[--color-bg] p-8 group hover:bg-white transition-colors block">
          {inner}
        </a>
      ) : (
        <article class="bg-[--color-bg] p-8 group hover:bg-white transition-colors">
          {inner}
        </article>
      );
    })}
  </div>
</section>
