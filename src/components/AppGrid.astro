---
import { strings, type Locale } from '../i18n/strings';
import { apps } from '../data/apps';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings[locale];
---

<section class="max-w-5xl mx-auto w-full px-6 py-16 border-t border-[--color-border]">
  <h2 class="text-xs uppercase tracking-[0.18em] text-[--color-muted] font-medium mb-10">
    {t.apps.heading}
  </h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-[--color-border]">
    {apps.map((app) => {
      const copy = app.copy[locale];
      return (
        <article class="bg-[--color-bg] p-8 group hover:bg-white transition-colors">
          <div class="flex items-baseline justify-between mb-6">
            <h3 class="text-2xl font-bold tracking-tight" style={`color: ${app.accent}`}>
              {copy.name}
            </h3>
            <span class="text-[10px] uppercase tracking-wider text-[--color-muted] font-medium">
              {app.status[locale]}
            </span>
          </div>
          <p class="text-sm font-medium mb-3">
            {copy.tagline}
          </p>
          <p class="text-sm text-[--color-muted] leading-relaxed">
            {copy.description}
          </p>
        </article>
      );
    })}
  </div>
</section>
