---
import { strings, type Locale } from '../i18n/strings';
import { apps } from '../data/apps';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings[locale];
---

<section class="relative max-w-6xl mx-auto w-full px-6 py-24 md:py-32 border-t border-[--color-border]">
  <h2 class="text-xs uppercase tracking-[0.22em] text-[--color-muted] font-medium mb-12 reveal-on-scroll">
    {t.apps.heading}
  </h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-[--color-border] border border-[--color-border] reveal-on-scroll">
    {apps.map((app, idx) => {
      const copy = app.copy[locale];
      const webHref = app.links?.web
        ? (locale === 'en' && app.links.web.startsWith('/') ? '/en' + app.links.web : app.links.web)
        : null;

      const inner = (
        <>
          <div class="card-inner relative z-10 flex flex-col h-full min-h-[220px]">
            <div class="flex items-baseline justify-between mb-6 gap-4">
              <h3 class="card-name text-3xl md:text-4xl font-bold tracking-tight">
                {copy.name}
              </h3>
              <span class="card-status text-[10px] uppercase tracking-wider font-medium tabular-nums shrink-0">
                {String(idx + 1).padStart(2, '0')} · {app.status[locale]}
              </span>
            </div>
            <p class="card-tagline text-base md:text-lg font-medium mb-3">
              {copy.tagline}
            </p>
            <p class="card-desc text-sm leading-relaxed">
              {copy.description}
            </p>
            {webHref && (
              <span class="card-cta mt-6 text-xs font-semibold tracking-tight inline-flex items-center gap-2">
                {t.apps.cta} <span class="card-cta-arrow">→</span>
              </span>
            )}
          </div>
          <div class="card-bg" aria-hidden="true"></div>
        </>
      );

      const baseClass = `app-card relative bg-[--color-bg] p-8 md:p-10 overflow-hidden group tilt-card`;
      const style = `--accent: ${app.accent};`;

      return webHref ? (
        <a href={webHref} class={`${baseClass} block`} style={style} data-index={idx}>
          {inner}
        </a>
      ) : (
        <article class={baseClass} style={style} data-index={idx}>
          {inner}
        </article>
      );
    })}
  </div>
</section>

<style>
  .app-card {
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
    min-height: 300px;
    transform-style: preserve-3d;
    perspective: 1000px;
  }
  .card-inner {
    transition: transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card-bg {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 0;
  }
  .app-card:hover .card-bg { transform: scaleY(1); }

  .card-name,
  .card-tagline,
  .card-cta {
    color: #18181b;
    transition: color 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card-status,
  .card-desc {
    color: var(--color-muted, #71717a);
    transition: color 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .app-card:hover .card-name,
  .app-card:hover .card-tagline,
  .app-card:hover .card-cta,
  .app-card:hover .card-status,
  .app-card:hover .card-desc {
    color: #ffffff;
  }
  .app-card:hover .card-status,
  .app-card:hover .card-desc {
    color: rgba(255, 255, 255, 0.82);
  }

  .card-cta-arrow {
    display: inline-block;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .app-card:hover .card-cta-arrow { transform: translateX(8px); }

  /* Reveal on scroll */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(28px);
  }
  @supports (animation-timeline: view()) {
    .reveal-on-scroll {
      animation: reveal both;
      animation-timeline: view();
      animation-range: entry 0% entry 60%;
    }
  }
  @keyframes reveal {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-on-scroll { opacity: 1; transform: none; animation: none; }
    .card-bg { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    // Reveal fallback
    if (!CSS.supports('animation-timeline: view()')) {
      const els = document.querySelectorAll('.reveal-on-scroll');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.style.opacity = '1';
            entry.target.style.transform = 'translateY(0)';
            entry.target.style.transition = 'opacity 800ms cubic-bezier(0.16, 1, 0.3, 1), transform 800ms cubic-bezier(0.16, 1, 0.3, 1)';
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      els.forEach((el) => io.observe(el));
    }

    // 3D tilt on mousemove (desktop only, respects reduced motion)
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(hover: none), (pointer: coarse)').matches) return;

    const cards = document.querySelectorAll('.tilt-card');
    cards.forEach((card) => {
      const inner = card.querySelector('.card-inner');
      if (!inner) return;
      let raf = 0;
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          card.style.transform = `perspective(1000px) rotateX(${-y * 4}deg) rotateY(${x * 4}deg) translateY(-4px)`;
          inner.style.transform = `translate3d(${x * 8}px, ${y * 8}px, 30px)`;
        });
      });
      card.addEventListener('mouseleave', () => {
        cancelAnimationFrame(raf);
        card.style.transform = '';
        inner.style.transform = '';
      });
    });
  })();
</script>
