---
import { strings, type Locale } from '../i18n/strings';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const isKo = locale === 'ko';
const t = strings[locale];
const home = isKo ? '/' : '/en/';

const copy = isKo ? {
  nav: { products: '제품', method: '만드는 방식', team: '팀', contact: '문의' },
  hero: { title: ['일상을', '움직이는', '작은 신호.'], body: '직접 만들고, 출시하고, 운영합니다.', cta: '제품 탐색' },
  indexLabel: '지금 운영하는 제품',
  method: {
    eyebrow: '만드는 방식',
    title: ['직접 만들고,', '출시하고,', '오래 운영합니다.'],
    items: [
      ['01', '작은 문제에서 시작', '우리의 일상에서 마주한 불편에서 시작합니다.'],
      ['02', '실제 제품으로 출시', '빠르게 만들고, 검증된 흐름을 실제 사용자에게 제공합니다.'],
      ['03', '다음 날까지 운영', '사용자의 반응을 보며 다음 버전까지 계속 개선합니다.'],
    ],
  },
  team: {
    eyebrow: 'TEAM EAST NOISE', title: '작은 팀, 선명한 역할.',
    body: '기획, 디자인, 개발, 마케팅을 한 흐름으로 연결합니다.',
    members: [['조수근', '공동 창업자 · 제품'], ['이유석', '공동 창업자 · 개발'], ['김윤서', '마케팅']],
  },
  contact: {
    eyebrow: 'CONTACT',
    title: ['같은 취향, 같은 리듬으로.', '우리의 작은 신호가', '당신의 일상을 움직이길.'],
    cta: '문의하기',
  },
  backTop: '위로', language: 'EN', openProduct: '제품 페이지 열기',
} : {
  nav: { products: 'Products', method: 'How we build', team: 'Team', contact: 'Contact' },
  hero: { title: ['Small signals', 'that move', 'everyday life.'], body: 'We build, launch, and operate our own products.', cta: 'Explore products' },
  indexLabel: 'Products in operation',
  method: {
    eyebrow: 'HOW WE BUILD',
    title: ['Built here,', 'launched for real,', 'operated for the long run.'],
    items: [
      ['01', 'Start with a small problem', 'We begin with friction we meet in everyday life.'],
      ['02', 'Launch a real product', 'We move quickly, validate the flow, and put it in people’s hands.'],
      ['03', 'Stay for the next day', 'Real response shapes the next release and the one after it.'],
    ],
  },
  team: {
    eyebrow: 'TEAM EAST NOISE', title: 'A small team with clear roles.',
    body: 'Product, design, engineering, and marketing stay in one loop.',
    members: [['Sugeun Jo', 'Co-founder · Product'], ['Yuseok Lee', 'Co-founder · Engineering'], ['Yunseo Kim', 'Marketing']],
  },
  contact: {
    eyebrow: 'CONTACT',
    title: ['The same taste. The same rhythm.', 'We hope our small signal', 'moves something in your day.'],
    cta: 'Contact us',
  },
  backTop: 'Back to top', language: 'KO', openProduct: 'Open product page',
};

const products = [
  {
    id: 'luvit', number: '01', name: 'Luvit', accent: '#ff8d99',
    image: '/visuals/company/luvit-signal-scene.webp', href: isKo ? '/luvit' : '/en/luvit',
    title: isKo ? '둘만의 미션' : 'A mission for two',
    body: isKo ? '함께 정하고, 함께 해내는\n작은 약속의 즐거움.' : 'Small promises, chosen together\nand completed together.',
    status: ['APP STORE', 'v1.0.5'], side: 'right',
  },
  {
    id: 'seed', number: '02', name: 'Seed', accent: '#62de83',
    image: '/visuals/company/seed-signal-scene.webp', href: isKo ? '/seed' : '/en/seed',
    title: isKo ? '해낸 순간의 기록' : 'A record of showing up',
    body: isKo ? '하루의 성장을 영상으로 남기는\n나만의 데일리 스토리.' : 'Turn the growth inside a day\ninto your own daily story.',
    status: ['APP STORE · GOOGLE PLAY', 'v1.0.13'], side: 'left',
  },
  {
    id: 'alpha', number: '03', name: 'ALPHA', accent: '#ff3434',
    image: '/visuals/company/alpha-signal-scene.webp', href: isKo ? '/alpha' : '/en/alpha',
    title: isKo ? '90일의 기준' : 'A 90-day standard',
    body: isKo ? '집중할 목표를 세우고,\n매일 1% 더 나아갑니다.' : 'Set one standard to focus on,\nthen move one percent each day.',
    status: ['APP STORE v1.0.3', 'GOOGLE PLAY v1.0.4'], side: 'left',
  },
  {
    id: 'scene', number: '04', name: 'SCENE', accent: '#57d8ff',
    image: '/visuals/company/scene-signal-scene.webp', href: isKo ? '/scene' : '/en/scene',
    title: isKo ? '지금에 반응하는 사운드' : 'Sound that reacts to now',
    body: isKo ? '상황을 고르면, 주변 소리와 음악이\n한 장면으로 흐릅니다.' : 'Choose the situation. Nearby sound and music\nflow into one continuous scene.',
    status: [isKo ? 'iPHONE · 출시 준비 중' : 'iPHONE · PREPARING TO LAUNCH', 'v1.0.0'], side: 'left',
  },
];
---

<div class="signal-home" data-signal-home>
  <a class="skip-link" href="#main-content">{isKo ? '본문으로 이동' : 'Skip to content'}</a>

  <header class="site-header">
    <a class="brand" href={home} aria-label={isKo ? '동방의 소음 홈' : 'East Noise home'}>
      <img src="/visuals/company/east-noise-mark-white.png" alt="" width="64" height="38" />
      <span>동방의 소음</span>
    </a>
    <nav class="primary-nav" aria-label={isKo ? '주요 메뉴' : 'Primary navigation'}>
      <a href="#products">{copy.nav.products}</a>
      <a href="#method">{copy.nav.method}</a>
      <a href="#team">{copy.nav.team}</a>
      <a href="#contact">{copy.nav.contact}</a>
    </nav>
    <a class="language-link" href={isKo ? '/en/' : '/'} lang={isKo ? 'en' : 'ko'}>{copy.language}</a>
  </header>

  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <img class="hero-image" src="/visuals/company/east-noise-signal-hero.webp" width="1672" height="941" alt="" loading="eager" fetchpriority="high" />
      <div class="hero-copy reveal is-visible">
        <h1 id="hero-title">{copy.hero.title.map((line) => <span>{line}</span>)}</h1>
        <p>{copy.hero.body}</p>
        <a class="hero-cta" href="#products">{copy.hero.cta}</a>
      </div>
      <p class="hero-signal" aria-hidden="true">SIGNAL / 001</p>
    </section>

    <section class="products" id="products" aria-labelledby="products-title">
      <aside class="product-index">
        <h2 id="products-title" class="sr-only">{copy.indexLabel}</h2>
        <ol>
          {products.map((product) => (
            <li style={`--product-accent:${product.accent}`}>
              <a href={`#${product.id}`} data-product-link={product.id}>
                <span class="index-number">{product.number}</span>
                <strong>{product.name}</strong>
                <small>{product.title}</small>
              </a>
            </li>
          ))}
        </ol>
      </aside>

      <div class="product-panels">
        {products.map((product) => (
          <article class:list={['product-panel', `product-panel--${product.id}`, `copy-${product.side}`]} id={product.id} data-product-panel={product.id} style={`--product-accent:${product.accent}`}>
            <img src={product.image} alt="" width="1672" height="941" loading={product.id === 'luvit' ? 'eager' : 'lazy'} />
            <div class="product-copy reveal">
              <p class="product-number">{product.number} / 04</p>
              <a href={product.href} aria-label={`${product.name} · ${copy.openProduct}`}><h3>{product.title}</h3></a>
              <p class="product-body">{product.body.split('\n').map((line) => <span>{line}</span>)}</p>
              <dl class="product-status">
                {product.status.map((item, index) => (
                  <div><dt>{index === 0 ? product.name : ''}</dt><dd>{item}</dd></div>
                ))}
              </dl>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="method" id="method" aria-labelledby="method-title">
      <header class="method-heading reveal">
        <p>{copy.method.eyebrow}</p>
        <h2 id="method-title">{copy.method.title.map((line) => <span>{line}</span>)}</h2>
      </header>
      <ol class="method-list reveal">
        {copy.method.items.map(([number, title, body]) => (
          <li><span>{number}</span><h3>{title}</h3><p>{body}</p></li>
        ))}
      </ol>
    </section>

    <section class="team" id="team" aria-labelledby="team-title">
      <header class="team-heading reveal">
        <p>{copy.team.eyebrow}</p><h2 id="team-title">{copy.team.title}</h2><span>{copy.team.body}</span>
      </header>
      <div class="team-grid reveal">
        {copy.team.members.map(([name, role], index) => (
          <article><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{name}</h3><p>{role}</p></div></article>
        ))}
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <img src="/visuals/company/east-noise-signal-hero.webp" width="1672" height="941" alt="" loading="lazy" />
      <div class="contact-copy reveal">
        <p>{copy.contact.eyebrow}</p>
        <h2 id="contact-title">{copy.contact.title.map((line) => <span>{line}</span>)}</h2>
        <a href={`mailto:${t.contact.email}`}>{copy.contact.cta}</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <a class="footer-brand" href={home}><img src="/visuals/company/east-noise-mark-white.png" alt="" width="48" height="28" /><span>동방의 소음</span></a>
    <div class="footer-meta"><span>{t.contact.copyright}</span><span>{t.contact.bizNo}</span></div>
    <nav aria-label={isKo ? '푸터 메뉴' : 'Footer navigation'}>
      <a href="#products">{copy.nav.products}</a><a href="#method">{copy.nav.method}</a><a href="#team">{copy.nav.team}</a><a href="#contact">{copy.nav.contact}</a><a href="#main-content">{copy.backTop}</a>
    </nav>
  </footer>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-signal-home]');
  if (root) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const reveals = [...root.querySelectorAll<HTMLElement>('.reveal:not(.is-visible)')];
    if (reducedMotion || !('IntersectionObserver' in window)) reveals.forEach((item) => item.classList.add('is-visible'));
    else {
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.16, rootMargin: '0px 0px -8% 0px' });
      reveals.forEach((item) => revealObserver.observe(item));
    }

    const panels = [...root.querySelectorAll<HTMLElement>('[data-product-panel]')];
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-product-link]')];
    const setActive = (id: string) => links.forEach((link) => link.dataset.productLink === id ? link.setAttribute('aria-current', 'step') : link.removeAttribute('aria-current'));
    if ('IntersectionObserver' in window && panels.length) {
      const panelObserver = new IntersectionObserver((entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        const id = visible?.target.getAttribute('data-product-panel');
        if (id) setActive(id);
      }, { threshold: [0.25, 0.45, 0.65], rootMargin: '-18% 0px -34% 0px' });
      panels.forEach((panel) => panelObserver.observe(panel));
    }
    setActive('luvit');
  }
</script>

<style>
  .signal-home{--black:#050505;--white:#f5f4f1;min-width:320px;overflow:clip;background:var(--black);color:var(--white)}
  .skip-link{position:fixed;top:.75rem;left:.75rem;z-index:999;padding:.75rem 1rem;transform:translateY(-150%);background:var(--white);color:var(--black)}
  .skip-link:focus{transform:translateY(0)}
  .site-header{position:absolute;inset:0 0 auto;z-index:40;display:grid;grid-template-columns:1fr auto 3.5rem;align-items:center;width:100%;min-height:84px;padding:0 clamp(1.5rem,4vw,5rem);color:#fff}
  .brand,.footer-brand{display:inline-flex;align-items:center;justify-self:start;min-height:44px;gap:.8rem;font-size:.92rem;font-weight:760;letter-spacing:-.035em}
  .brand img{width:48px;height:30px;object-fit:contain}.primary-nav{display:flex;align-items:center;justify-content:center;gap:clamp(1.5rem,3vw,3.4rem)}
  .primary-nav a,.language-link{display:inline-flex;align-items:center;min-height:44px;color:rgba(255,255,255,.76);font-size:.76rem;font-weight:650;transition:color 160ms ease}
  .primary-nav a:hover,.primary-nav a:focus-visible,.language-link:hover,.language-link:focus-visible{color:#fff}.language-link{justify-self:end}
  .hero{position:relative;display:flex;align-items:center;width:100%;height:100svh;min-height:760px;isolation:isolate;overflow:hidden;background:#020202}
  .hero-image{position:absolute;inset:0;z-index:-1;width:100%;height:100%;object-fit:cover;object-position:center}
  .hero-copy{width:min(38rem,calc(100% - 3rem));margin-left:clamp(1.5rem,7vw,8.5rem);padding-top:4rem}
  .hero h1{margin:0;font-size:clamp(4.1rem,7.2vw,8rem);font-weight:820;letter-spacing:-.078em;line-height:.92;text-wrap:balance}
  .hero h1 span,.method h2 span,.contact h2 span,.product-body span{display:block}
  .hero-copy>p{margin:2.2rem 0 0;color:rgba(255,255,255,.78);font-size:clamp(.96rem,1.2vw,1.1rem);letter-spacing:-.025em}
  .hero-cta{display:inline-flex;align-items:center;justify-content:center;min-width:164px;min-height:54px;margin-top:2.4rem;padding:0 1.5rem;background:#f6f5f2;color:#080808;font-size:.86rem;font-weight:720;transition:transform 180ms ease,background 180ms ease}
  .hero-cta:hover,.hero-cta:focus-visible{background:#fff;transform:translateY(-2px)}.hero-cta:active{transform:scale(.98)}
  .hero-signal{position:absolute;right:clamp(1.5rem,4vw,5rem);bottom:1.8rem;margin:0;color:rgba(255,255,255,.42);font-size:.58rem;letter-spacing:.18em;writing-mode:vertical-rl}
  :global(html){scroll-snap-type:y proximity}
  .products{position:relative;display:grid;grid-template-columns:minmax(0,1fr);border-top:1px solid rgba(255,255,255,.12);background:#080808}
  .product-index,.product-panels{grid-area:1/1}
  .product-index{position:sticky;top:0;z-index:30;align-self:start;width:clamp(176px,16.5vw,254px);height:100svh;padding:clamp(4rem,8vh,7rem) clamp(1.25rem,2.8vw,3rem);border-right:1px solid rgba(255,255,255,.13);background:rgba(9,10,10,.91);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
  .product-index ol{display:grid;grid-template-rows:repeat(4,1fr);height:100%;margin:0;padding:0;list-style:none;border-left:1px solid rgba(255,255,255,.32)}.product-index li{min-height:0}
  .product-index a{position:relative;display:flex;flex-direction:column;justify-content:center;height:100%;min-height:110px;padding-left:clamp(1rem,1.8vw,1.8rem);color:rgba(255,255,255,.5);transition:color 200ms ease}
  .product-index a::before{content:'';position:absolute;top:50%;left:-2px;width:3px;height:0;background:var(--product-accent);transform:translateY(-50%);transition:height 240ms ease,box-shadow 240ms ease}
  .product-index a:hover,.product-index a:focus-visible,.product-index a[aria-current='step']{color:var(--product-accent)}
  .product-index a[aria-current='step']::before{height:72%;box-shadow:0 0 16px var(--product-accent)}
  .index-number{margin-bottom:.8rem;color:rgba(255,255,255,.68);font-size:.64rem;font-weight:700}.product-index strong{font-size:clamp(1.18rem,2vw,1.85rem);letter-spacing:-.05em}
  .product-index small{max-width:11rem;margin-top:.75rem;color:rgba(255,255,255,.58);font-size:.68rem;line-height:1.5}
  .product-panel{position:relative;display:flex;align-items:center;width:100%;height:100svh;min-height:620px;scroll-margin-top:0;scroll-snap-align:start;scroll-snap-stop:always;isolation:isolate;overflow:hidden;border-bottom:1px solid rgba(255,255,255,.12);background:#050505}
  .product-panel>img{position:absolute;inset:0;z-index:-2;width:100%;height:100%;object-fit:cover}
  .product-panel::after{content:'';position:absolute;inset:0;z-index:-1;background:rgba(0,0,0,.08);pointer-events:none}
  .product-copy{width:min(35rem,42%);margin:0 clamp(3rem,8vw,9rem) 0 clamp(15rem,24vw,23rem);text-shadow:0 2px 18px rgba(0,0,0,.72)}.copy-right .product-copy{margin-right:clamp(3rem,8vw,9rem);margin-left:auto}
  .product-number{margin:0 0 2.2rem;color:var(--product-accent);font-size:.68rem;font-weight:760;letter-spacing:.12em}
  .product-copy h3{margin:0;color:#fff;font-size:clamp(2.2rem,4vw,4.7rem);font-weight:760;letter-spacing:-.065em;line-height:1.02}
  .product-copy a{display:inline-block}.product-copy a:hover h3,.product-copy a:focus-visible h3{color:var(--product-accent)}
  .product-body{margin:1.5rem 0 0;color:rgba(255,255,255,.77);font-size:clamp(.9rem,1.25vw,1.08rem);line-height:1.65;letter-spacing:-.025em}
  .product-status{display:grid;gap:.5rem;margin:1.8rem 0 0}.product-status div{display:grid;grid-template-columns:4.5rem 1fr;gap:.8rem;align-items:center}
  .product-status dt,.product-status dd{margin:0;font-size:.6rem;font-weight:680;letter-spacing:.06em}.product-status dt{color:var(--product-accent)}.product-status dd{color:rgba(255,255,255,.78)}
  .method{display:grid;grid-template-columns:minmax(17rem,.85fr) minmax(0,1.45fr);gap:clamp(4rem,9vw,10rem);padding:clamp(7rem,11vw,12rem) max(1.5rem,calc((100vw - 1380px)/2));border-bottom:1px solid rgba(255,255,255,.12);background:#080808}
  .method-heading>p,.team-heading>p,.contact-copy>p{margin:0 0 2rem;color:#8f8e8a;font-size:.65rem;font-weight:720;letter-spacing:.16em}
  .method h2,.team h2,.contact h2{margin:0;font-size:clamp(2.65rem,5vw,5.8rem);font-weight:760;letter-spacing:-.07em;line-height:1.01}
  .method-list{display:grid;grid-template-columns:repeat(3,1fr);margin:0;padding:0;list-style:none;border-top:1px solid rgba(255,255,255,.22);border-bottom:1px solid rgba(255,255,255,.22)}
  .method-list li{min-height:240px;padding:2rem 1.7rem;border-right:1px solid rgba(255,255,255,.18)}.method-list li:last-child{border-right:0}.method-list li>span{color:#777773;font-size:.65rem}
  .method-list h3{margin:3.5rem 0 1rem;font-size:1.2rem;letter-spacing:-.04em}.method-list p{margin:0;color:#9c9b97;font-size:.82rem;line-height:1.65}
  .team{padding:clamp(6rem,10vw,10rem) max(1.5rem,calc((100vw - 1380px)/2));background:#0a0a0a}
  .team-heading{display:grid;grid-template-columns:.8fr 1.3fr 1fr;gap:3rem;align-items:end;margin-bottom:4rem}.team-heading>p{margin:0}.team h2{font-size:clamp(2rem,3.6vw,4rem)}.team-heading>span{color:#9c9b97;line-height:1.7}
  .team-grid{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid rgba(255,255,255,.2)}
  .team-grid article{display:grid;grid-template-columns:2.5rem 1fr;align-items:center;min-height:132px;padding:1.5rem 1.7rem;border-right:1px solid rgba(255,255,255,.17)}.team-grid article:last-child{border-right:0}
  .team-grid article>span{color:#777773;font-size:.62rem}.team-grid h3{margin:0;font-size:1.18rem;letter-spacing:-.04em}.team-grid p{margin:.55rem 0 0;color:#8f8e8a;font-size:.72rem}
  .contact{position:relative;display:flex;align-items:center;min-height:clamp(480px,42vw,700px);isolation:isolate;overflow:hidden;background:#030303}
  .contact>img{position:absolute;inset:0;z-index:-1;width:100%;height:100%;object-fit:cover;object-position:82% center;opacity:.48}
  .contact-copy{margin-left:max(1.5rem,calc((100vw - 1380px)/2))}.contact h2{font-size:clamp(2.35rem,4.8vw,5.35rem)}
  .contact-copy a{display:inline-flex;align-items:center;justify-content:center;min-width:150px;min-height:52px;margin-top:2.4rem;background:#f7f6f3;color:#090909;font-size:.84rem;font-weight:720;transition:transform 180ms ease}
  .contact-copy a:hover,.contact-copy a:focus-visible{transform:translateY(-2px)}
  .site-footer{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:2rem;min-height:104px;padding:0 clamp(1.5rem,4vw,5rem);border-top:1px solid rgba(255,255,255,.14);background:#050505}
  .footer-brand img{width:36px;height:24px;object-fit:contain}.footer-brand{font-size:.72rem}.footer-meta{display:flex;gap:1rem;color:#777773;font-size:.6rem}.site-footer nav{display:flex;justify-content:flex-end;gap:1.5rem}
  .site-footer nav a{display:inline-flex;align-items:center;min-height:44px;color:#8f8e8a;font-size:.66rem}
  .reveal{opacity:0;transform:translateY(22px);transition:opacity 680ms cubic-bezier(.16,1,.3,1),transform 680ms cubic-bezier(.16,1,.3,1)}.reveal.is-visible{opacity:1;transform:translateY(0)}

