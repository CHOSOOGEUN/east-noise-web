---
import { strings, type Locale } from '../i18n/strings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings[locale];
const isKo = locale === 'ko';
const home = isKo ? '/' : '/en/';

const copy = isKo
  ? {
      nav: { products: '제품', story: '만드는 방식', team: '팀', contact: '문의' },
      heroEyebrow: 'EAST NOISE · INDEPENDENT PRODUCT STUDIO',
      heroTitle: '작은 문제를\n실제 제품으로 만듭니다.',
      heroBody: '커플의 하루, 루틴의 기록, 90일의 기준, 작은 가게의 첫 웹사이트.\n직접 만들고, 출시하고, 오래 운영합니다.',
      heroCta: '지금 만든 것들',
      liveLabel: 'NOW OPERATING',
      liveSummary: '모바일 앱 3개 · 웹 스튜디오 1개',
      collectionEyebrow: 'EAST NOISE / FOUR PRODUCTS',
      collectionTitle: '지금 운영하는 네 가지',
      collectionBody: '앱 3개와 웹 스튜디오 1개. 기능과 분위기는 달라도, 오늘 더 쉽게 행동하게 한다는 기준은 같습니다.',
      showreelLabel: 'SCROLL SHOWREEL',
      showreelHint: '스크롤해 제품 넘기기',
      storyEyebrow: 'HOW WE WORK',
      storyTitle: '출시에서 끝내지 않고,\n운영까지 붙잡습니다.',
      storyBody:
        '동방의 소음은 앱과 웹을 직접 만들고 공개한 뒤, 실제 사용과 문의를 보며 계속 바꿉니다. 러빗의 관계 루틴, Seed의 영상 기록, ALPHA의 자기통제 과정, HEUM의 로컬 웹 제작을 한 팀이 운영합니다.',
      methodLabel: '우리가 만드는 방식',
      methods: [
        ['01', '작게 시작해도 공개합니다', '완벽해질 때까지 숨기기보다, 실제로 쓸 수 있는 첫 버전을 내고 배웁니다.'],
        ['02', '설명보다 실제 화면을 만듭니다', '기획, 디자인, 개발을 한 흐름으로 묶어 아이디어를 손에 잡히는 제품으로 바꿉니다.'],
        ['03', '출시 뒤의 운영으로 고칩니다', '스토어 반응, 사용 흐름, 문의를 보며 제품과 카피를 함께 다듬습니다.'],
      ],
      teamEyebrow: 'TEAM EAST NOISE',
      teamTitle: '작지만, 끝까지 만드는 팀',
      teamBody: '기획부터 디자인, 개발, 운영까지. 아이디어를 실제로 쓰이는 제품으로 완성합니다.',
      roles: [
        ['조수근', 'Co-founder · Product'],
        ['이유석', 'Co-founder · Engineering'],
        ['김윤서', 'Marketing'],
      ],
      contactEyebrow: 'CONTACT',
      contactTitle: '제품과 웹, 함께 만들까요?',
      contactBody: '앱 협업, 제품 제휴, 로컬 비즈니스 웹 제작에 관한 이야기를 들려주세요.',
      mailCta: '메일 보내기',
      viewProduct: '제품 보기',
      viewStudio: '스튜디오 보기',
      visitInstagram: '인스타그램',
      visitWebsite: 'heum.cloud',
      language: 'EN',
    }
  : {
      nav: { products: 'Products', story: 'How we work', team: 'Team', contact: 'Contact' },
      heroEyebrow: 'EAST NOISE · INDEPENDENT PRODUCT STUDIO',
      heroTitle: 'Small problems,\nmade into real products.',
      heroBody: 'A couple’s day, a video routine, a 90-day standard, and a local shop’s first website.\nWe build, launch, and stay for the operation.',
      heroCta: 'See what is live',
      liveLabel: 'NOW OPERATING',
      liveSummary: 'Three mobile apps · one web studio',
      collectionEyebrow: 'EAST NOISE / FOUR PRODUCTS',
      collectionTitle: 'Four things we operate now',
      collectionBody: 'Three apps and one web studio. Each has its own voice, but every one helps a person make the next move today.',
      showreelLabel: 'SCROLL SHOWREEL',
      showreelHint: 'Scroll to advance',
      storyEyebrow: 'HOW WE WORK',
      storyTitle: 'We do not stop at launch.\nWe stay for the operation.',
      storyBody:
        'East Noise builds and publishes apps and websites, then keeps changing them through real use and real inquiries. One team operates Luvit, Seed, ALPHA, and the HEUM local web studio.',
      methodLabel: 'How we build',
      methods: [
        ['01', 'Ship a useful first version', 'We learn from something people can actually use instead of hiding until it feels perfect.'],
        ['02', 'Make the screen, not the promise', 'Product, design, and engineering stay in one loop until the idea becomes tangible.'],
        ['03', 'Improve through operation', 'Store response, product behavior, and inquiries shape the next release and the next sentence.'],
      ],
      teamEyebrow: 'TEAM EAST NOISE',
      teamTitle: 'A small team that finishes',
      teamBody: 'From product and design to engineering and operations, we turn ideas into products people can use.',
      roles: [
        ['Sugeun Jo', 'Co-founder · Product'],
        ['Yuseok Lee', 'Co-founder · Engineering'],
        ['Yunseo Kim', 'Marketing'],
      ],
      contactEyebrow: 'CONTACT',
      contactTitle: 'Build a product or website together?',
      contactBody: 'Tell us about an app collaboration, product partnership, or local business website.',
      mailCta: 'Send an email',
      viewProduct: 'View product',
      viewStudio: 'View studio',
      visitInstagram: 'Instagram',
      visitWebsite: 'heum.cloud',
      language: 'KO',
    };

const products = [
  {
    id: 'luvit',
    number: '01',
    name: 'Luvit',
    icon: '/visuals/company/luvit-app-icon.webp',
    status: 'APP STORE · v1.0.5',
    href: isKo ? '/luvit' : '/en/luvit',
    social: 'https://www.instagram.com/luvit_486/',
    title: isKo ? '하루 한 번,\n둘의 관계를 움직입니다.' : 'One small move,\nfor the relationship each day.',
    body: isKo
      ? '매일 도착한 미션을 함께하고 다음 날 서로 결과를 확인합니다. 공동 포인트로 방을 꾸미고, 지난 미션과 추억을 둘만의 기록으로 남기는 커플 앱입니다.'
      : 'Complete a small mission together, review it with each other the next day, decorate a shared room with points, and keep every mission and memory in one place.',
  },
  {
    id: 'seed',
    number: '02',
    name: 'Seed',
    icon: '/visuals/company/seed-app-icon.webp',
    status: 'APP STORE · GOOGLE PLAY · v1.0.13',
    href: isKo ? '/seed' : '/en/seed',
    social: 'https://www.instagram.com/seed.fl0wer/',
    title: isKo ? '오늘의 실행을,\n나만의 루틴 브이로그로.' : 'Turn today’s effort\ninto a routine vlog.',
    body: isKo
      ? '2~4초 영상으로 루틴을 인증하면 식물이 자랍니다. Seed Plus에서는 하루의 인증을 한 편의 공유용 세로 영상, Daily Story로 완성합니다.'
      : 'Record each routine in a 2–4 second video and watch your plant grow. Seed Plus turns a day of check-ins into a shareable vertical Daily Story.',
  },
  {
    id: 'alpha',
    number: '03',
    name: 'ALPHA',
    icon: '/visuals/company/alpha-app-icon.webp',
    status: 'iOS v1.0.3 · ANDROID v1.0.4',
    href: isKo ? '/alpha' : '/en/alpha',
    title: isKo ? '오늘을 끝내며,\n90일의 기준을 세웁니다.' : 'Close today.\nBuild a 90-day standard.',
    body: isKo
      ? 'BASIC부터 시작해 기준을 충족하면 STANDARD와 HARD로 이어지는 유료 자기통제 앱. 매일 루틴을 끝내고 하루를 마감하며, 완성한 날과 무너진 날을 모두 기록합니다.'
      : 'A paid self-discipline app that starts with BASIC and unlocks STANDARD and HARD as you meet each course standard. Finish your routines, close the day, and keep both wins and misses on record.',
  },
  {
    id: 'heum',
    number: '04',
    name: 'HEUM',
    icon: '/visuals/company/heum-mark.webp',
    status: isKo ? 'WEB STUDIO · 상담 가능' : 'WEB STUDIO · INQUIRIES OPEN',
    href: isKo ? '/heum' : '/en/heum',
    external: 'https://heum.cloud',
    title: isKo ? '가게의 좋은 첫인상,\n웹에서도 이어지게.' : 'Carry a shop’s first impression\nonto the web.',
    body: isKo
      ? '카페·식당·작은 가게의 메뉴, 위치, 예약과 문의를 가게에 맞는 한 화면으로 정리하는 로컬 비즈니스 웹 스튜디오입니다.'
      : 'A local business web studio that turns a cafe, restaurant, or small shop’s menu, location, reservations, and contact into one clear experience.',
  },
];
---

<div class="east-home" data-east-home>
  <a class="skip-link" href="#main-content">{isKo ? '본문으로 이동' : 'Skip to content'}</a>

  <header class="site-header">
    <a class="wordmark" href={home} aria-label={isKo ? '동방의 소음 홈' : 'East Noise home'}>동방의 소음</a>
    <nav class="primary-nav" aria-label={isKo ? '주요 메뉴' : 'Primary navigation'}>
      <a href="#products" data-home-section-link="products">{copy.nav.products}</a>
      <a href="#story" data-home-section-link="story">{copy.nav.story}</a>
      <a href="#team" data-home-section-link="team">{copy.nav.team}</a>
    </nav>
    <div class="header-actions">
      <a href="#contact">{copy.nav.contact}</a>
      <span aria-hidden="true"></span>
      <a href={isKo ? '/en/' : '/'} lang={isKo ? 'en' : 'ko'}>{copy.language}</a>
    </div>
  </header>

  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-top">
        <div class="hero-copy reveal is-visible">
          <p class="hero-eyebrow">{copy.heroEyebrow}</p>
          <h1 id="hero-title">{copy.heroTitle.split('\n').map((line) => <span>{line}</span>)}</h1>
          <p>{copy.heroBody.split('\n').map((line) => <span>{line}</span>)}</p>
          <a class="primary-cta" href="#products">
            {copy.heroCta}
            <span aria-hidden="true">↘</span>
          </a>
        </div>

        <aside class="hero-live reveal is-visible" aria-label={copy.liveLabel}>
          <div class="hero-live__head">
            <span aria-hidden="true"></span>
            <p>{copy.liveLabel}</p>
          </div>
          <strong>{copy.liveSummary}</strong>
          <ul>
            {products.map((product) => (
              <li>
                <img src={product.icon} alt="" width="28" height="28" />
                <span>{product.name}</span>
                <small>{product.status}</small>
              </li>
            ))}
          </ul>
        </aside>
      </div>

      <div class="world-viewport" aria-hidden="true">
        <img
          src="/visuals/company/product-world-hero-studio-v1.webp"
          width="1825"
          height="862"
          alt=""
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <nav class="product-rail" aria-label={isKo ? '제품 바로가기' : 'Product shortcuts'}>
        {products.map((product) => (
          <a href={`#${product.id}`} data-reel-link={product.id}>
            <img class="rail-icon" src={product.icon} alt="" width="34" height="34" />
            <span>{product.name}</span>
            <span class="rail-arrow" aria-hidden="true">↘</span>
          </a>
        ))}
      </nav>
    </section>

    <section class="collection" id="products" aria-labelledby="collection-title" data-home-section="products">
      <div class="section-heading reveal">
        <p class="eyebrow">{copy.collectionEyebrow}</p>
        <h2 id="collection-title">{copy.collectionTitle}</h2>
        <p>{copy.collectionBody}</p>
      </div>

      <div class="showreel-bar" aria-hidden="true">
        <span class="showreel-label">{copy.showreelLabel}</span>
        <span class="showreel-hint">{copy.showreelHint}</span>
        <span class="showreel-track"><i data-reel-progress></i></span>
        <span class="showreel-count"><strong data-reel-current>01</strong><span>/</span><span>{String(products.length).padStart(2, '0')}</span></span>
      </div>

      <div class="product-stories">
        {products.map((product) => (
          <article class:list={['product-story', `product-story--${product.id}`]} id={product.id} data-reel-card={product.id}>
            <div class="product-copy reveal">
              <div class="product-kicker">
                <span>{product.number}</span>
                <strong>{product.name}</strong>
                <small>{product.status}</small>
              </div>
              <h3>{product.title.split('\n').map((line) => <span>{line}</span>)}</h3>
              <p>{product.body}</p>
              <div class="product-links">
                <a
                  class="text-link"
                  href={product.href}
                >
                  {product.id === 'heum' ? copy.viewStudio : copy.viewProduct}
                  <span aria-hidden="true">↗</span>
                </a>
                {product.social && (
                  <a class="quiet-link" href={product.social} target="_blank" rel="noreferrer">
                    {copy.visitInstagram}<span class="sr-only"> ({isKo ? '새 창' : 'opens in a new tab'})</span>
                  </a>
                )}
                {product.external && (
                  <a class="quiet-link" href={product.external} target="_blank" rel="noreferrer">
                    {copy.visitWebsite}<span class="sr-only"> ({isKo ? '새 창' : 'opens in a new tab'})</span>
                  </a>
                )}
              </div>
            </div>

            <div class="product-visual reveal" aria-hidden="true">
              {product.id === 'luvit' && (
                <>
                  <img class="brand-poster" src="/visuals/company/luvit-current-mission.webp" width="900" height="1956" alt="" loading="lazy" />
                  <img class="detail-card" src="/visuals/company/luvit-current-home.webp" width="900" height="1956" alt="" loading="lazy" />
                </>
              )}
              {product.id === 'seed' && (
                <>
                  <img class="brand-poster" src="/visuals/company/seed-current-story.webp" width="900" height="1951" alt="" loading="lazy" />
                  <img class="detail-card" src="/visuals/company/seed-current-today.webp" width="900" height="1951" alt="" loading="lazy" />
                </>
              )}
              {product.id === 'alpha' && (
                <>
                  <img class="brand-poster" src="/visuals/company/alpha-store-course-2026-08.webp" width="1320" height="2868" alt="" loading="lazy" />
                  <img class="detail-card" src="/visuals/company/alpha-store-today-2026-08.webp" width="1320" height="2868" alt="" loading="lazy" />
                </>
              )}
              {product.id === 'heum' && (
                <div class="heum-stage">
                  <img class="heum-studio-screen" src="/visuals/company/heum-studio-work.webp" width="1440" height="1024" alt="" loading="lazy" />
                  <div class="heum-mobile-card">
                    <img src="/visuals/company/heum-studio-mobile.webp" width="390" height="844" alt="" loading="lazy" />
                  </div>
                  <p>{isKo ? '카페·식당·작은 가게를 위한 웹 제작' : 'Websites for cafes, restaurants, and small shops'}</p>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="story" id="story" aria-labelledby="story-title" data-home-section="story">
      <div class="story-copy reveal">
        <p class="eyebrow">{copy.storyEyebrow}</p>
        <h2 id="story-title">{copy.storyTitle.split('\n').map((line) => <span>{line}</span>)}</h2>
        <p>{copy.storyBody}</p>
      </div>
      <div class="methods reveal">
        <p class="method-label">{copy.methodLabel}</p>
        {copy.methods.map(([number, title, body]) => (
          <div class="method-row">
            <span>{number}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="team" id="team" aria-labelledby="team-title" data-home-section="team">
      <div class="team-intro reveal">
        <p class="eyebrow">{copy.teamEyebrow}</p>
        <h2 id="team-title">{copy.teamTitle}</h2>
        <p>{copy.teamBody}</p>
      </div>
      <div class="team-list reveal">
        {copy.roles.map(([name, role], index) => (
          <div class="team-member">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{name}</strong>
            <p>{role}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <p class="eyebrow">{copy.contactEyebrow}</p>
      <h2 id="contact-title">{copy.contactTitle}</h2>
      <p>{copy.contactBody}</p>
      <a class="contact-link" href={`mailto:${t.contact.email}`}>
        <span>{copy.mailCta}</span>
        <strong>{t.contact.email}</strong>
        <span aria-hidden="true">↗</span>
      </a>
    </section>
  </main>

  <footer class="site-footer">
    <a class="wordmark wordmark--footer" href={home}>동방의 소음</a>
    <div>
      <span>{t.contact.copyright}</span>
      <span>{t.contact.bizNo}</span>
    </div>
    <a href="#main-content">{isKo ? '위로' : 'Back to top'} ↑</a>
  </footer>
</div>

<script>
  import { initHomeMotion } from '../scripts/productMotion';

  const motionRoot = document.querySelector<HTMLElement>('[data-east-home]');
  const cleanupMotion = motionRoot ? initHomeMotion(motionRoot) : undefined;
  if (cleanupMotion) addEventListener('pagehide', cleanupMotion, { once: true });

  const sectionLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-home-section-link]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-home-section]')];
  const setCurrentSection = (sectionId: string) => {
    sectionLinks.forEach((link) => {
      if (link.dataset.homeSectionLink === sectionId) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };

  if ('IntersectionObserver' in window && sectionLinks.length) {
    const sectionObserver = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (visible?.target.id) setCurrentSection(visible.target.id);
    }, { threshold: [0.12, 0.28, 0.5], rootMargin: '-18% 0px -58% 0px' });
    sections.forEach((section) => sectionObserver.observe(section));
  }

  const reelCards = [...document.querySelectorAll<HTMLElement>('[data-reel-card]')];
  const reelLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-reel-link]')];
  const reelCurrent = document.querySelector<HTMLElement>('[data-reel-current]');
  const reelProgress = document.querySelector<HTMLElement>('[data-reel-progress]');
  let reelFrame = 0;

  const setCurrentReel = (activeIndex: number) => {
    const activeCard = reelCards[activeIndex];
    if (!activeCard) return;

    reelCards.forEach((card, index) => {
      if (index === activeIndex) card.setAttribute('data-reel-active', 'true');
      else card.removeAttribute('data-reel-active');
    });
    reelLinks.forEach((link) => {
      if (link.dataset.reelLink === activeCard.dataset.reelCard) link.setAttribute('aria-current', 'step');
      else link.removeAttribute('aria-current');
    });
    if (reelCurrent) reelCurrent.textContent = String(activeIndex + 1).padStart(2, '0');
    if (reelProgress) reelProgress.style.transform = `scaleX(${(activeIndex + 1) / reelCards.length})`;
  };

  const syncReel = () => {
    reelFrame = 0;
    const activationLine = Math.min(innerHeight * 0.58, 520);
    let activeIndex = 0;
    reelCards.forEach((card, index) => {
      if (card.getBoundingClientRect().top <= activationLine) activeIndex = index;
    });
    setCurrentReel(activeIndex);
  };

  const requestReelSync = () => {
    if (reelFrame) return;
    reelFrame = requestAnimationFrame(syncReel);
  };

  if (reelCards.length) {
    syncReel();
    addEventListener('scroll', requestReelSync, { passive: true });
    addEventListener('resize', requestReelSync, { passive: true });
    addEventListener('pagehide', () => {
      removeEventListener('scroll', requestReelSync);
      removeEventListener('resize', requestReelSync);
      if (reelFrame) cancelAnimationFrame(reelFrame);
    }, { once: true });
  }
</script>

<style>
  .east-home {
    --ink: #111111;
    --muted: #6f7176;
    --line: rgba(17, 17, 17, 0.13);
    --paper: #fbfaf8;
    overflow: clip;
    background: var(--paper);
    color: var(--ink);
  }

  .east-home[data-motion-active='true'] .reveal {
    transition: none;
  }

  :global(html.motion-booting) .east-home .hero-copy,
  :global(html.motion-booting) .east-home .hero-live,
  :global(html.motion-booting) .east-home .world-viewport img,
  :global(html.motion-booting) .east-home .product-rail a {
    opacity: 0;
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 999;
    padding: 0.75rem 1rem;
    transform: translateY(-160%);
    background: #111111;
    color: #ffffff;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 72px;
    padding: 0 clamp(1.25rem, 3.3vw, 3.5rem);
    border-bottom: 1px solid rgba(17, 17, 17, 0.06);
    background: rgba(251, 250, 248, 0.92);
    backdrop-filter: blur(18px);
  }

  .wordmark {
    justify-self: start;
    font-size: 1.18rem;
    font-weight: 780;
    letter-spacing: -0.045em;
  }

  .primary-nav,
  .header-actions {
    display: flex;
    align-items: center;
  }

  .primary-nav {
    gap: clamp(1.75rem, 4vw, 4.25rem);
  }

  .header-actions {
    justify-self: end;
    gap: 1rem;
  }

  .header-actions > span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #c8cbd1;
  }

  .primary-nav a,
  .header-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.88rem;
    font-weight: 590;
  }

  .primary-nav a {
    border-bottom: 1px solid transparent;
    transition: border-color 180ms ease, color 180ms ease;
  }

  .primary-nav a:hover,
  .primary-nav a:focus-visible,
  .primary-nav a[aria-current='location'] {
    border-bottom-color: currentColor;
    color: #111111;
  }

  .hero {
    position: relative;
    padding-top: clamp(4.75rem, 6.4vw, 6.5rem);
    background:
      linear-gradient(rgba(7, 21, 37, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(7, 21, 37, 0.035) 1px, transparent 1px),
      radial-gradient(circle at 78% 18%, rgba(113, 153, 255, 0.2), transparent 28%),
      radial-gradient(circle at 15% 38%, rgba(151, 229, 218, 0.18), transparent 26%),
      #f7f8fa;
    background-size: 80px 80px, 80px 80px, auto, auto, auto;
  }

  .hero-top {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.65fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
    width: min(calc(100% - 6rem), 1320px);
    margin: 0 auto;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .hero-eyebrow {
    margin: 0 0 1.5rem !important;
    color: #586377 !important;
    font-size: 0.72rem !important;
    font-weight: 720;
    letter-spacing: 0.14em !important;
  }

  .hero h1 {
    margin: 0;
    max-width: 13ch;
    font-size: clamp(3.7rem, 6.3vw, 6.6rem);
    font-weight: 790;
    letter-spacing: -0.075em;
    line-height: 0.98;
  }

  .hero h1 span,
  .hero p span,
  .product-story h3 span,
  .story h2 span {
    display: block;
  }

  .hero-copy > p {
    max-width: 42rem;
    margin: 1.6rem 0 0;
    color: var(--muted);
    font-size: clamp(0.98rem, 1.05vw, 1.05rem);
    line-height: 1.72;
    letter-spacing: -0.025em;
  }

  .primary-cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    min-width: 196px;
    min-height: 56px;
    margin-top: 1.7rem;
    padding: 0 1.35rem 0 1.55rem;
    border-radius: 13px;
    background: #071525;
    color: #ffffff;
    font-weight: 650;
    box-shadow: 0 12px 28px rgba(7, 21, 37, 0.16);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .primary-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 34px rgba(7, 21, 37, 0.22);
  }

  .primary-cta:active,
  .product-rail a:active,
  .text-link:active,
  .contact-link:active {
    transform: scale(0.975);
  }

  .hero-live {
    padding: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.88);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.6);
    box-shadow: 0 22px 70px rgba(27, 47, 79, 0.12);
    backdrop-filter: blur(22px);
  }

  .hero-live__head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .hero-live__head > span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22a06b;
    box-shadow: 0 0 0 6px rgba(34, 160, 107, 0.11);
  }

  .hero-live__head p {
    margin: 0;
    color: #6b7485;
    font-size: 0.66rem;
    font-weight: 720;
    letter-spacing: 0.13em;
  }

  .hero-live > strong {
    display: block;
    margin: 1rem 0 1.15rem;
    font-size: clamp(1.2rem, 1.8vw, 1.55rem);
    letter-spacing: -0.045em;
  }

  .hero-live ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(17, 17, 17, 0.09);
  }

  .hero-live li {
    display: grid;
    grid-template-columns: 28px 0.55fr 1fr;
    align-items: center;
    gap: 0.75rem;
    min-height: 50px;
    border-bottom: 1px solid rgba(17, 17, 17, 0.09);
  }

  .hero-live li img {
    display: block;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    object-fit: cover;
  }

  .hero-live li span {
    font-size: 0.82rem;
    font-weight: 720;
  }

  .hero-live li small {
    color: #727b8b;
    font-size: 0.58rem;
    line-height: 1.35;
    text-align: right;
  }

  .world-viewport {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: clamp(-7rem, -6vw, -4rem);
    overflow: hidden;
  }

  .world-viewport img {
    display: block;
    width: min(100%, 1825px);
    height: auto;
  }

  .product-rail {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    width: min(calc(100% - 3rem), 1240px);
    margin: clamp(-1.4rem, -1vw, -0.65rem) auto 0;
    border: 1px solid rgba(17, 17, 17, 0.08);
    border-radius: 22px 22px 0 0;
    background: rgba(255, 255, 255, 0.91);
    box-shadow: 0 -20px 70px rgba(65, 53, 40, 0.06);
    backdrop-filter: blur(16px);
  }

  .product-rail a {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.8rem;
    min-height: 108px;
    padding: 0 1.7rem;
    border-right: 1px solid var(--line);
    transition: background 180ms ease;
  }

  .product-rail a:first-child {
    border-radius: 22px 0 0;
  }

  .product-rail a:last-child {
    border-right: 0;
    border-radius: 0 22px 0 0;
  }

  .product-rail a:hover {
    background: rgba(17, 17, 17, 0.035);
  }

  .rail-icon {
    display: block;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    object-fit: cover;
  }

  .product-rail a > span:nth-child(2) {
    font-weight: 700;
  }

  .rail-arrow {
    color: #8a8d92;
  }

  .collection {
    background: #ffffff;
  }

  .section-heading {
    display: grid;
    grid-template-columns: 0.7fr 1.25fr 1fr;
    align-items: end;
    gap: clamp(2rem, 5vw, 7rem);
    width: min(calc(100% - 3rem), 1240px);
    margin: 0 auto;
    padding: clamp(7rem, 12vw, 11rem) 0 clamp(4.5rem, 8vw, 7rem);
  }

  .eyebrow {
    margin: 0;
    color: #81838a;
    font-size: 0.71rem;
    font-weight: 720;
    letter-spacing: 0.14em;
  }

  .section-heading h2,
  .story h2,
  .team h2,
  .contact h2 {
    margin: 0;
    font-size: clamp(2.15rem, 4vw, 4.25rem);
    letter-spacing: -0.065em;
    line-height: 1.08;
  }

  .section-heading > p:last-child,
  .story-copy > p:last-child,
  .team-intro > p:last-child,
  .contact > p:nth-of-type(2) {
    margin: 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .product-stories {
    border-top: 1px solid var(--line);
  }

  .product-story {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    min-height: min(820px, 88svh);
    scroll-margin-top: 72px;
  }

  .product-story:nth-child(even) {
    grid-template-columns: minmax(0, 1.22fr) minmax(0, 0.78fr);
  }

  .product-story:nth-child(even) .product-copy {
    order: 2;
  }

  .product-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(3rem, 7vw, 7rem);
  }

  .product-kicker {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 5vw, 5rem);
  }

  .product-kicker span {
    color: #8a8d92;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
  }

  .product-kicker strong {
    font-size: 0.86rem;
    letter-spacing: 0.04em;
  }

  .product-kicker small {
    margin-left: auto;
    padding: 0.45rem 0.65rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.58rem;
    font-weight: 680;
    letter-spacing: 0.05em;
    opacity: 0.52;
  }

  .product-story h3 {
    margin: 0;
    font-size: clamp(2.35rem, 4.35vw, 4.8rem);
    letter-spacing: -0.07em;
    line-height: 1.06;
  }

  .product-copy > p {
    max-width: 34rem;
    margin: 1.7rem 0 0;
    color: currentColor;
    font-size: clamp(1rem, 1.2vw, 1.16rem);
    line-height: 1.75;
    opacity: 0.66;
  }

  .product-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    min-width: 152px;
    min-height: 48px;
    padding: 0 1.1rem 0 1.2rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 680;
    transition: background 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .quiet-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    border-bottom: 1px solid currentColor;
    font-size: 0.86rem;
    opacity: 0.66;
    transition: opacity 180ms ease;
  }

  .text-link:hover,
  .text-link:focus-visible {
    transform: translateY(-2px);
  }

  .product-story--luvit .text-link:hover,
  .product-story--luvit .text-link:focus-visible { background: #322528; color: #ffffff; }
  .product-story--seed .text-link:hover,
  .product-story--seed .text-link:focus-visible { background: #153e2a; color: #ffffff; }
  .product-story--heum .text-link:hover,
  .product-story--heum .text-link:focus-visible { background: #102c45; color: #ffffff; }
  .product-story--alpha .text-link:hover,
  .product-story--alpha .text-link:focus-visible { background: #f6f3ee; color: #0f1011; }

  .quiet-link:hover,
  .quiet-link:focus-visible { opacity: 1; }

  .product-visual {
    position: relative;
    min-width: 0;
    min-height: 620px;
    overflow: hidden;
  }

  .brand-poster {
    position: absolute;
    bottom: -4%;
    left: 7%;
    z-index: 1;
    width: auto;
    height: 88%;
    max-width: 58%;
    object-fit: contain;
    border-radius: 24px;
    transform: rotate(-1.8deg);
    box-shadow: 0 32px 90px rgba(35, 23, 20, 0.22);
  }

  .detail-card {
    position: absolute;
    right: 6%;
    bottom: -8%;
    z-index: 2;
    width: auto;
    height: 82%;
    max-width: 54%;
    object-fit: contain;
    border-radius: 22px;
    transform: rotate(2.2deg);
    box-shadow: 0 32px 90px rgba(35, 23, 20, 0.3);
  }

  .product-story--luvit {
    background: #f7e7eb;
    color: #322528;
  }

  .product-story--luvit .product-visual {
    background:
      radial-gradient(circle at 68% 22%, rgba(255, 255, 255, 0.88), transparent 34%),
      linear-gradient(135deg, #f4d9df, #fcf6ef);
  }

  .product-story--seed {
    background: #e9f2e5;
    color: #153e2a;
  }

  .product-story--seed .product-visual {
    background:
      radial-gradient(circle at 32% 18%, rgba(255, 255, 255, 0.96), transparent 36%),
      linear-gradient(145deg, #dff0e6, #f8faf6);
  }

  .product-story--seed .brand-poster {
    right: 7%;
    left: auto;
    transform: rotate(1.5deg);
  }

  .product-story--seed .detail-card {
    right: auto;
    left: 6%;
    transform: rotate(-2deg);
  }

  .product-story--alpha {
    background: #0f1011;
    color: #f6f3ee;
  }

  .product-story--alpha .product-visual {
    background:
      radial-gradient(circle at 70% 70%, rgba(199, 28, 24, 0.24), transparent 38%),
      #090a0b;
  }

  .product-story--alpha .brand-poster,
  .product-story--alpha .detail-card {
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .product-story--heum {
    background: #edf4ff;
    color: #152033;
  }

  .heum-stage {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background:
      linear-gradient(rgba(63, 102, 245, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(63, 102, 245, 0.055) 1px, transparent 1px),
      radial-gradient(circle at 78% 16%, rgba(97, 137, 255, 0.42), transparent 34%),
      radial-gradient(circle at 12% 78%, rgba(155, 238, 224, 0.4), transparent 30%),
      #edf4ff;
    background-size: 80px 80px, 80px 80px, auto, auto, auto;
  }

  .heum-studio-screen {
    position: absolute;
    top: 11%;
    left: 7%;
    width: 76%;
    border: 10px solid rgba(255, 255, 255, 0.72);
    border-radius: 24px;
    box-shadow: 0 36px 90px rgba(35, 69, 131, 0.23);
    transform: rotate(-1.2deg);
  }

  .heum-mobile-card {
    position: absolute;
    right: 4%;
    bottom: -9%;
    z-index: 2;
    width: min(31%, 250px);
    padding: 8px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.68);
    box-shadow: 0 28px 80px rgba(35, 69, 131, 0.26);
    transform: rotate(2.2deg);
    backdrop-filter: blur(16px);
  }

  .heum-mobile-card img {
    display: block;
    width: 100%;
    border-radius: 17px;
  }

  .heum-stage > p {
    position: absolute;
    right: 5%;
    top: 5%;
    z-index: 3;
    margin: 0;
    padding: 0.65rem 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.82);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.62);
    color: #3f66f5;
    font-size: 0.64rem;
    font-weight: 720;
    backdrop-filter: blur(16px);
  }

  .story {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: clamp(4rem, 10vw, 11rem);
    padding: clamp(7rem, 13vw, 12rem) max(1.5rem, calc((100vw - 1240px) / 2));
    --muted: #aeb9c9;
    --line: rgba(255, 255, 255, 0.16);
    background:
      radial-gradient(circle at 90% 8%, rgba(63, 102, 245, 0.28), transparent 30%),
      #071525;
    color: #f6f8fc;
  }

  .story-copy .eyebrow,
  .team-intro .eyebrow {
    margin-bottom: 2.5rem;
  }

  .story .eyebrow,
  .story .method-label {
    color: #8290a5;
  }

  .story-copy > p:last-child {
    max-width: 34rem;
    margin-top: 2rem;
  }

  .method-label {
    margin: 0 0 1rem;
    color: #81838a;
    font-size: 0.75rem;
    font-weight: 680;
  }

  .method-row {
    display: grid;
    grid-template-columns: 2.8rem 1fr;
    column-gap: 1.25rem;
    padding: 1.55rem 0;
    border-top: 1px solid var(--line);
  }

  .method-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .method-row > span {
    grid-row: span 2;
    color: #9a9ca0;
    font-size: 0.7rem;
  }

  .method-row h3,
  .method-row p {
    margin: 0;
  }

  .method-row h3 {
    font-size: clamp(1.05rem, 1.8vw, 1.4rem);
    letter-spacing: -0.035em;
  }

  .method-row p {
    margin-top: 0.55rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .team {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(4rem, 10vw, 11rem);
    padding: clamp(7rem, 12vw, 11rem) max(1.5rem, calc((100vw - 1240px) / 2));
    background: #ffffff;
  }

  .team-intro > p:last-child {
    max-width: 30rem;
    margin-top: 1.7rem;
  }

  .team-list {
    border-top: 1px solid var(--line);
  }

  .team-member {
    display: grid;
    grid-template-columns: 3rem 1fr 1fr;
    align-items: center;
    min-height: 94px;
    border-bottom: 1px solid var(--line);
  }

  .team-member > span {
    color: #9a9ca0;
    font-size: 0.68rem;
  }

  .team-member strong {
    font-size: 1.05rem;
  }

  .team-member p {
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(7rem, 13vw, 12rem) 1.5rem;
    background: #111111;
    color: #ffffff;
    text-align: center;
  }

  .contact .eyebrow {
    margin-bottom: 2.5rem;
    color: #8f9299;
  }

  .contact > p:nth-of-type(2) {
    margin-top: 1.6rem;
    color: #a9abb0;
  }

  .contact-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
    width: min(100%, 710px);
    min-height: 92px;
    margin-top: 3.5rem;
    padding: 0 1.5rem 0 2rem;
    border: 1px solid #424448;
    border-radius: 10px;
    text-align: left;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .contact-link:hover,
  .contact-link:focus-visible {
    border-color: #777a80;
    background: #18191b;
    transform: translateY(-2px);
  }

  .contact-link span:first-child {
    color: #a9abb0;
    font-size: 0.78rem;
  }

  .contact-link strong {
    font-size: clamp(1rem, 2vw, 1.4rem);
  }

  .site-footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 134px;
    padding: 0 clamp(1.25rem, 3.3vw, 3.5rem);
    background: #111111;
    color: #ffffff;
    border-top: 1px solid #2f3033;
  }

  .wordmark--footer {
    color: #ffffff;
  }

  .site-footer > div {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: #85878c;
    font-size: 0.7rem;
    text-align: center;
  }

  .site-footer > a:last-child {
    justify-self: end;
    font-size: 0.78rem;
  }

  @media (max-width: 900px) {
    .primary-nav {
      display: none;
    }

    .site-header {
      grid-template-columns: 1fr auto;
    }

    .hero {
      padding-top: 4.75rem;
    }

    .hero-top {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      width: min(calc(100% - 3rem), 720px);
    }

    .hero-live {
      width: min(100%, 500px);
      justify-self: end;
    }

    .hero h1 {
      font-size: clamp(2.8rem, 8.7vw, 4.2rem);
    }

    .world-viewport {
      margin-top: -2rem;
    }

    .world-viewport img {
      width: min(1825px, 100%);
      max-width: none;
    }

    .product-rail {
      grid-template-columns: repeat(2, 1fr);
      width: calc(100% - 2rem);
      margin-top: -0.3rem;
    }

    .product-rail a {
      min-height: 82px;
      padding: 0 1.2rem;
      border-bottom: 1px solid var(--line);
    }

    .product-rail a:nth-child(2) {
      border-right: 0;
      border-radius: 0 22px 0 0;
    }

    .product-rail a:nth-child(n + 3) {
      border-bottom: 0;
    }

    .section-heading {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .section-heading h2 {
      max-width: 12em;
    }

    .section-heading > p:last-child {
      max-width: 32rem;
    }

    .product-story,
    .product-story:nth-child(even) {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .product-story:nth-child(even) .product-copy {
      order: 0;
    }

    .product-copy {
      min-height: 560px;
      padding: 4.5rem 2rem;
    }

    .product-visual {
      min-height: min(90vw, 690px);
    }

    .story,
    .team {
      grid-template-columns: 1fr;
      gap: 5rem;
    }

    .site-footer {
      grid-template-columns: 1fr auto;
    }

    .site-footer > div {
      display: none;
    }
  }

  @media (max-width: 620px) {
    .site-header {
      min-height: 64px;
    }

    .header-actions a:first-child,
    .header-actions > span {
      display: none;
    }

    .wordmark {
      font-size: 1.02rem;
    }

    .hero {
      padding-top: 4rem;
    }

    .hero-top {
      gap: 1.5rem;
      width: calc(100% - 2.5rem);
    }

    .hero h1 {
      font-size: clamp(2.25rem, 10.5vw, 2.75rem);
      letter-spacing: -0.08em;
    }

    .hero-copy > p {
      font-size: 0.96rem;
