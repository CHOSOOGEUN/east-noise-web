---
import { strings, type Locale } from '../i18n/strings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings[locale];
const isKo = locale === 'ko';
const home = isKo ? '/' : '/en/';

const copy = isKo
  ? {
      nav: { products: '제품', story: '이야기', team: '팀', contact: '문의' },
      heroTitle: '마음을 움직이는\n제품을 만듭니다.',
      heroBody: '사랑, 습관, 절제, 미스터리.\n일상의 감정을 오래 남는 경험으로 바꿉니다.',
      heroCta: '제품 둘러보기',
      collectionEyebrow: 'EAST NOISE / FOUR PRODUCTS',
      collectionTitle: '서로 다른 감정, 하나의 방향',
      collectionBody: '사람의 마음이 움직이는 순간을 발견하고, 매일 다시 찾게 되는 제품으로 만듭니다.',
      storyEyebrow: 'OUR STORY',
      storyTitle: '소리는 사라져도,\n경험은 남습니다.',
      storyBody:
        '동방의 소음은 사랑하는 사람과의 하루, 작은 습관이 자라는 시간, 스스로와의 약속, 화면 너머의 미스터리를 만듭니다. 서로 다른 네 제품은 모두 오래 기억되는 감정에서 출발합니다.',
      methodLabel: '우리가 만드는 방식',
      methods: [
        ['01', '작은 감정에서 시작합니다', '기능보다 먼저, 사용자가 어떤 순간을 기억하게 될지 묻습니다.'],
        ['02', '매일 돌아올 이유를 만듭니다', '거창한 변화보다 오늘 한 번 더 움직이게 하는 경험을 설계합니다.'],
        ['03', '제품마다 다른 세계를 지킵니다', '하나의 유행을 반복하지 않고, 각 제품에 맞는 말투와 질감을 만듭니다.'],
      ],
      teamEyebrow: 'TEAM EAST NOISE',
      teamTitle: '작지만, 끝까지 만드는 팀',
      teamBody: '기획부터 디자인, 개발, 운영까지. 아이디어를 실제로 쓰이는 제품으로 완성합니다.',
      roles: [
        ['조수근', 'Co-founder · Product'],
        ['이유석', 'Co-founder · Engineering'],
        ['김윤서', 'Marketing'],
      ],
      contactEyebrow: 'CONTACT',
      contactTitle: '함께 만들 이야기가 있나요?',
      contactBody: '제품, 협업, 제휴에 관한 이야기를 들려주세요.',
      mailCta: '메일 보내기',
      viewProduct: '제품 보기',
      visitInstagram: '인스타그램',
      openRecord: '조사 시작',
      language: 'EN',
    }
  : {
      nav: { products: 'Products', story: 'Story', team: 'Team', contact: 'Contact' },
      heroTitle: 'We make products\nthat move people.',
      heroBody: 'Love, habit, discipline, mystery.\nWe turn everyday emotions into experiences that last.',
      heroCta: 'Explore products',
      collectionEyebrow: 'EAST NOISE / FOUR PRODUCTS',
      collectionTitle: 'Different feelings, one direction',
      collectionBody: 'We find the moments that move people and turn them into products worth returning to.',
      storyEyebrow: 'OUR STORY',
      storyTitle: 'Sound fades.\nExperience remains.',
      storyBody:
        'East Noise makes days shared with someone you love, the time it takes for a habit to grow, a promise kept to yourself, and mysteries beyond the screen. Every product begins with an emotion worth remembering.',
      methodLabel: 'How we build',
      methods: [
        ['01', 'Begin with a small emotion', 'Before features, we ask what moment a person will remember.'],
        ['02', 'Create a reason to return', 'We design for one meaningful move today, not an abstract transformation.'],
        ['03', 'Protect each product world', 'Each product gets its own voice and texture instead of following one house style.'],
      ],
      teamEyebrow: 'TEAM EAST NOISE',
      teamTitle: 'A small team that finishes',
      teamBody: 'From product and design to engineering and operations, we turn ideas into products people can use.',
      roles: [
        ['Sugeun Jo', 'Co-founder · Product'],
        ['Yuseok Lee', 'Co-founder · Engineering'],
        ['Yunseo Kim', 'Marketing'],
      ],
      contactEyebrow: 'CONTACT',
      contactTitle: 'Have a story to build together?',
      contactBody: 'Tell us about a product, partnership, or collaboration.',
      mailCta: 'Send an email',
      viewProduct: 'View product',
      visitInstagram: 'Instagram',
      openRecord: 'Begin investigation',
      language: 'KO',
    };

const products = [
  {
    id: 'luvit',
    number: '01',
    name: 'Luvit',
    mark: '♥',
    href: isKo ? '/luvit' : '/en/luvit',
    social: 'https://www.instagram.com/luvit_486/',
    title: isKo ? '매일 하나씩,\n둘만의 미션을 쌓아갑니다.' : 'One small mission,\nevery day together.',
    body: isKo
      ? '매일 도착한 미션을 함께하고 다음 날 서로 결과를 확인합니다. 공동 포인트로 방을 꾸미고, 지난 미션과 추억을 둘만의 기록으로 남기는 커플 앱입니다.'
      : 'Complete a small mission together, review it with each other the next day, decorate a shared room with points, and keep every mission and memory in one place.',
  },
  {
    id: 'seed',
    number: '02',
    name: 'Seed',
    mark: '●',
    href: isKo ? '/seed' : '/en/seed',
    social: 'https://www.instagram.com/seed.fl0wer/',
    title: isKo ? '오늘의 인증이,\n한 편의 이야기로.' : 'Today’s check-ins,\ncut into one story.',
    body: isKo
      ? '2~4초 영상으로 루틴을 인증하면 식물이 자랍니다. Seed Plus에서는 하루의 인증을 한 편의 공유용 세로 영상, Daily Story로 완성합니다.'
      : 'Record each routine in a 2–4 second video and watch your plant grow. Seed Plus turns a day of check-ins into a shareable vertical Daily Story.',
  },
  {
    id: 'alpha',
    number: '03',
    name: 'ALPHA',
    mark: '▲',
    href: isKo ? '/alpha' : '/en/alpha',
    title: isKo ? '30일씩, 세 번.\n90일의 기준을 세웁니다.' : 'Three 30-day courses.\nOne 90-day standard.',
    body: isKo
      ? 'BASIC부터 시작해 기준을 충족하면 STANDARD와 HARD로 이어지는 유료 자기통제 앱. 매일 루틴을 끝내고 하루를 마감하며, 완성한 날과 무너진 날을 모두 기록합니다.'
      : 'A paid self-discipline app that starts with BASIC and unlocks STANDARD and HARD as you meet each course standard. Finish your routines, close the day, and keep both wins and misses on record.',
  },
  {
    id: 'heum',
    number: '04',
    name: 'HEUM',
    mark: 'H',
    href: isKo ? '/heum' : '/en/heum',
    title: isKo ? '아직 보내지지 않은 소포가\n먼저 도착했습니다.' : 'A parcel arrived\nbefore it was sent.',
    body: isKo
      ? '평범한 배송조회에서 시작하는 연속형 브라우저 ARG. 서로 다른 웹사이트의 시간·물건·사람을 대조하고, 제안한 해결이 도시의 다음 상태를 실제로 바꿉니다.'
      : 'A serialized browser ARG that begins on an ordinary parcel-tracking site. Compare times, objects, and people across a web ecosystem, then watch your proposed solution change what happens next.',
  },
];
---

<div class="east-home">
  <a class="skip-link" href="#main-content">{isKo ? '본문으로 이동' : 'Skip to content'}</a>

  <header class="site-header">
    <a class="wordmark" href={home} aria-label={isKo ? '동방의 소음 홈' : 'East Noise home'}>동방의 소음</a>
    <nav class="primary-nav" aria-label={isKo ? '주요 메뉴' : 'Primary navigation'}>
      <a href="#products" data-home-section-link="products">{copy.nav.products}</a>
      <a href="#story" data-home-section-link="story">{copy.nav.story}</a>
      <a href="#team" data-home-section-link="team">{copy.nav.team}</a>
    </nav>
    <div class="header-actions">
      <a href="#contact">{copy.nav.contact}</a>
      <span aria-hidden="true"></span>
      <a href={isKo ? '/en/' : '/'} lang={isKo ? 'en' : 'ko'}>{copy.language}</a>
    </div>
  </header>

  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy reveal is-visible">
        <h1 id="hero-title">{copy.heroTitle.split('\n').map((line) => <span>{line}</span>)}</h1>
        <p>{copy.heroBody.split('\n').map((line) => <span>{line}</span>)}</p>
        <a class="primary-cta" href="#products">
          {copy.heroCta}
          <span aria-hidden="true">↘</span>
        </a>
      </div>

      <div class="world-viewport" aria-hidden="true">
        <img
          src="/visuals/company/product-world-hero.webp"
          width="1829"
          height="860"
          alt=""
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <nav class="product-rail" aria-label={isKo ? '제품 바로가기' : 'Product shortcuts'}>
        {products.map((product) => (
          <a href={`#${product.id}`}>
            <span class={`rail-mark rail-mark--${product.id}`} aria-hidden="true">{product.mark}</span>
            <span>{product.name}</span>
            <span class="rail-arrow" aria-hidden="true">↘</span>
          </a>
        ))}
      </nav>
    </section>

    <section class="collection" id="products" aria-labelledby="collection-title" data-home-section="products">
      <div class="section-heading reveal">
        <p class="eyebrow">{copy.collectionEyebrow}</p>
        <h2 id="collection-title">{copy.collectionTitle}</h2>
        <p>{copy.collectionBody}</p>
      </div>

      <div class="product-stories">
        {products.map((product) => (
          <article class:list={['product-story', `product-story--${product.id}`]} id={product.id}>
            <div class="product-copy reveal">
              <div class="product-kicker">
                <span>{product.number}</span>
                <strong>{product.name}</strong>
              </div>
              <h3>{product.title.split('\n').map((line) => <span>{line}</span>)}</h3>
              <p>{product.body}</p>
              <div class="product-links">
                <a
                  class="text-link"
                  href={product.href}
                >
                  {product.id === 'heum' ? copy.openRecord : copy.viewProduct}
                  <span aria-hidden="true">↗</span>
                </a>
                {product.social && (
                  <a class="quiet-link" href={product.social} target="_blank" rel="noreferrer">
                    {copy.visitInstagram}<span class="sr-only"> ({isKo ? '새 창' : 'opens in a new tab'})</span>
                  </a>
                )}
              </div>
            </div>

            <div class="product-visual reveal" aria-hidden="true">
              {product.id === 'luvit' && (
                <>
                  <img class="brand-poster" src="/visuals/company/luvit-current-mission.webp" width="900" height="1956" alt="" loading="lazy" />
                  <img class="detail-card" src="/visuals/company/luvit-current-home.webp" width="900" height="1956" alt="" loading="lazy" />
                </>
              )}
              {product.id === 'seed' && (
                <>
                  <img class="brand-poster" src="/visuals/company/seed-current-story.webp" width="900" height="1951" alt="" loading="lazy" />
                  <img class="detail-card" src="/visuals/company/seed-current-today.webp" width="900" height="1951" alt="" loading="lazy" />
                </>
              )}
              {product.id === 'alpha' && (
                <>
                  <img class="brand-poster" src="/visuals/company/alpha-current-90days.webp" width="900" height="1956" alt="" loading="lazy" />
                  <img class="detail-card" src="/visuals/company/alpha-current-today.webp" width="900" height="1956" alt="" loading="lazy" />
                </>
              )}
              {product.id === 'heum' && (
                <div class="heum-stage">
                  <img class="heum-blueprint" src="/visuals/company/heum-current-linework.webp" width="1683" height="935" alt="" loading="lazy" />
                  <strong class="heum-title">HEUM</strong>
                  <div class="heum-record-card">
                    <img src="/visuals/company/heum-current-parcel.webp" width="1448" height="1086" alt="" loading="lazy" />
                    <span>{isKo ? '반송 예정 · P0 미인도 화물' : 'RETURN PENDING · P0 UNCLAIMED'}</span>
                  </div>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="story" id="story" aria-labelledby="story-title" data-home-section="story">
      <div class="story-copy reveal">
        <p class="eyebrow">{copy.storyEyebrow}</p>
        <h2 id="story-title">{copy.storyTitle.split('\n').map((line) => <span>{line}</span>)}</h2>
        <p>{copy.storyBody}</p>
      </div>
      <div class="methods reveal">
        <p class="method-label">{copy.methodLabel}</p>
        {copy.methods.map(([number, title, body]) => (
          <div class="method-row">
            <span>{number}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="team" id="team" aria-labelledby="team-title" data-home-section="team">
      <div class="team-intro reveal">
        <p class="eyebrow">{copy.teamEyebrow}</p>
        <h2 id="team-title">{copy.teamTitle}</h2>
        <p>{copy.teamBody}</p>
      </div>
      <div class="team-list reveal">
        {copy.roles.map(([name, role], index) => (
          <div class="team-member">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{name}</strong>
            <p>{role}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <p class="eyebrow">{copy.contactEyebrow}</p>
      <h2 id="contact-title">{copy.contactTitle}</h2>
      <p>{copy.contactBody}</p>
      <a class="contact-link" href={`mailto:${t.contact.email}`}>
        <span>{copy.mailCta}</span>
        <strong>{t.contact.email}</strong>
        <span aria-hidden="true">↗</span>
      </a>
    </section>
  </main>

  <footer class="site-footer">
    <a class="wordmark wordmark--footer" href={home}>동방의 소음</a>
    <div>
      <span>{t.contact.copyright}</span>
      <span>{t.contact.bizNo}</span>
    </div>
    <a href="#main-content">{isKo ? '위로' : 'Back to top'} ↑</a>
  </footer>
</div>

<script>
  const reveals = document.querySelectorAll<HTMLElement>('.reveal:not(.is-visible)');

  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -7% 0px' },
    );
    reveals.forEach((element) => observer.observe(element));
  } else {
    reveals.forEach((element) => element.classList.add('is-visible'));
  }

  const sectionLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-home-section-link]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-home-section]')];
  const setCurrentSection = (sectionId: string) => {
    sectionLinks.forEach((link) => {
      if (link.dataset.homeSectionLink === sectionId) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };

  if ('IntersectionObserver' in window && sectionLinks.length) {
    const sectionObserver = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (visible?.target.id) setCurrentSection(visible.target.id);
    }, { threshold: [0.12, 0.28, 0.5], rootMargin: '-18% 0px -58% 0px' });
    sections.forEach((section) => sectionObserver.observe(section));
  }
</script>

<style>
  .east-home {
    --ink: #111111;
    --muted: #6f7176;
    --line: rgba(17, 17, 17, 0.13);
    --paper: #fbfaf8;
    overflow: clip;
    background: var(--paper);
    color: var(--ink);
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 999;
    padding: 0.75rem 1rem;
    transform: translateY(-160%);
    background: #111111;
    color: #ffffff;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 72px;
    padding: 0 clamp(1.25rem, 3.3vw, 3.5rem);
    border-bottom: 1px solid rgba(17, 17, 17, 0.06);
    background: rgba(251, 250, 248, 0.92);
    backdrop-filter: blur(18px);
  }

  .wordmark {
    justify-self: start;
    font-size: 1.18rem;
    font-weight: 780;
    letter-spacing: -0.045em;
  }

  .primary-nav,
  .header-actions {
    display: flex;
    align-items: center;
  }

  .primary-nav {
    gap: clamp(1.75rem, 4vw, 4.25rem);
  }

  .header-actions {
    justify-self: end;
    gap: 1rem;
  }

  .header-actions > span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #c8cbd1;
  }

  .primary-nav a,
  .header-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.88rem;
    font-weight: 590;
  }

  .primary-nav a {
    border-bottom: 1px solid transparent;
    transition: border-color 180ms ease, color 180ms ease;
  }

  .primary-nav a:hover,
  .primary-nav a:focus-visible,
  .primary-nav a[aria-current='location'] {
    border-bottom-color: currentColor;
    color: #111111;
  }

  .hero {
    padding-top: clamp(5.75rem, 6.4vw, 6.1rem);
    background:
      radial-gradient(circle at 50% 18%, rgba(255, 255, 255, 0.96), transparent 44%),
      #f8f7f5;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 1.25rem;
    text-align: center;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(3.35rem, 4.05vw, 3.75rem);
    font-weight: 790;
    letter-spacing: -0.075em;
    line-height: 1.04;
  }

  .hero h1 span,
  .hero p span,
  .product-story h3 span,
  .story h2 span {
    display: block;
  }

  .hero-copy > p {
    margin: 1.2rem 0 0;
    color: var(--muted);
    font-size: clamp(0.98rem, 1.05vw, 1.05rem);
    line-height: 1.62;
    letter-spacing: -0.025em;
  }

  .primary-cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    min-width: 196px;
    min-height: 56px;
    margin-top: 1.7rem;
    padding: 0 1.35rem 0 1.55rem;
    border-radius: 13px;
    background: #071525;
    color: #ffffff;
    font-weight: 650;
    box-shadow: 0 12px 28px rgba(7, 21, 37, 0.16);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .primary-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 34px rgba(7, 21, 37, 0.22);
  }

  .world-viewport {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: clamp(-12rem, -13vw, -10.5rem);
    overflow: hidden;
  }

  .world-viewport img {
    display: block;
    width: min(100%, 1825px);
    height: auto;
  }

  .product-rail {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    width: min(calc(100% - 3rem), 1240px);
    margin: clamp(-1.4rem, -1vw, -0.65rem) auto 0;
    border: 1px solid rgba(17, 17, 17, 0.08);
    border-radius: 22px 22px 0 0;
    background: rgba(255, 255, 255, 0.91);
    box-shadow: 0 -20px 70px rgba(65, 53, 40, 0.06);
    backdrop-filter: blur(16px);
  }

  .product-rail a {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.8rem;
    min-height: 108px;
    padding: 0 1.7rem;
    border-right: 1px solid var(--line);
    transition: background 180ms ease;
  }

  .product-rail a:first-child {
    border-radius: 22px 0 0;
  }

  .product-rail a:last-child {
    border-right: 0;
    border-radius: 0 22px 0 0;
  }

  .product-rail a:hover {
    background: rgba(17, 17, 17, 0.035);
  }

  .rail-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.35rem;
    font-weight: 700;
  }

  .rail-mark--luvit { color: #e58ca6; }
  .rail-mark--seed { color: #239260; }
  .rail-mark--alpha { color: #d9272e; }
  .rail-mark--heum { color: #167c7a; }

  .product-rail a > span:nth-child(2) {
    font-weight: 700;
  }

  .rail-arrow {
    color: #8a8d92;
  }

  .collection {
    background: #ffffff;
  }

