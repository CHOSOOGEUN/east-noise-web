---
---

<canvas id="noise-field" aria-hidden="true"></canvas>

<script is:inline>
  (function () {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canvas = document.getElementById('noise-field');
    if (!canvas) return;
    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    let w = 0, h = 0;
    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    let amplitude = 0.5;
    let targetAmp = 0.5;
    let lastScroll = window.scrollY || 0;
    let t = 0;
    let mouseX = 0.5;
    let mouseY = 0.5;
    let targetMx = 0.5;
    let targetMy = 0.5;

    function resize() {
      const rect = canvas.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      canvas.width = Math.floor(w * dpr);
      canvas.height = Math.floor(h * dpr);
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.scale(dpr, dpr);
    }
    resize();

    let resizeRaf = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(resizeRaf);
      resizeRaf = requestAnimationFrame(resize);
    });

    window.addEventListener('scroll', () => {
      const s = window.scrollY;
      const vel = Math.abs(s - lastScroll);
      lastScroll = s;
      targetAmp = Math.min(3.2, 0.5 + vel * 0.05);
    }, { passive: true });

    if (!window.matchMedia('(hover: none)').matches) {
      window.addEventListener('mousemove', (e) => {
        targetMx = e.clientX / window.innerWidth;
        targetMy = e.clientY / window.innerHeight;
      }, { passive: true });
    }

    const isMobile = window.innerWidth < 768;
    const baseLines = isMobile ? 5 : 9;
    const baseOpacity = isMobile ? 0.05 : 0.07;

    function draw() {
      ctx.clearRect(0, 0, w, h);
      amplitude += (targetAmp - amplitude) * 0.08;
      targetAmp += (0.5 - targetAmp) * 0.025;
      mouseX += (targetMx - mouseX) * 0.05;
      mouseY += (targetMy - mouseY) * 0.05;
      t += 0.006;

      const baseY = h * (0.45 + mouseY * 0.1);
      const stretch = 1 + mouseX * 0.4;

      for (let i = 0; i < baseLines; i++) {
        const offset = (i - baseLines / 2) * (isMobile ? 16 : 22);
        const fade = 1 - Math.abs(i - baseLines / 2) / (baseLines / 2);
        const opacity = baseOpacity * (0.4 + fade * 0.6);
        ctx.beginPath();
        ctx.strokeStyle = `rgba(24, 24, 27, ${opacity})`;
        ctx.lineWidth = 1;
        const step = isMobile ? 6 : 4;
        for (let x = 0; x <= w; x += step) {
          const phase = (x / w) * Math.PI * 4 * stretch + t + i * 0.55;
          const amp1 = Math.sin(phase) * 24 * amplitude;
          const amp2 = Math.sin(phase * 1.9 + i * 0.3) * 8 * amplitude;
          const y = baseY + offset + amp1 + amp2;
          if (x === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();
      }
      if (!reduceMotion) requestAnimationFrame(draw);
    }

    if (reduceMotion) {
      // single static frame
      amplitude = 0.4;
      draw();
    } else {
      draw();
    }
  })();
</script>

<style>
  #noise-field {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    width: 100%;
    height: 100%;
  }
</style>
