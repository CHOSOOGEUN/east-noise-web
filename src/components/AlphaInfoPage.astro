---
type PageType = 'support' | 'privacy' | 'terms';

interface Props {
  page: PageType;
}

const { page } = Astro.props;

const pageCopy = {
  support: {
    kicker: 'ALPHA · SUPPORT',
    titleKey: 'supportTitle',
    leadKey: 'supportLead',
    items: [
      ['faq1', 'faq1a'],
      ['faq2', 'faq2a'],
      ['faq3', 'faq3a'],
      ['faq4', 'faq4a'],
    ],
    showUpdated: false,
  },
  privacy: {
    kicker: 'ALPHA · LEGAL',
    titleKey: 'privacyTitle',
    leadKey: 'privacyLead',
    items: [
      ['p1', 'p1a'],
      ['p2', 'p2a'],
      ['p3', 'p3a'],
      ['p4', 'p4a'],
      ['p5', 'p5a'],
      ['p6', 'p6a'],
      ['p7', 'p7a'],
      ['p8', 'p8a'],
    ],
    showUpdated: true,
  },
  terms: {
    kicker: 'ALPHA · LEGAL',
    titleKey: 'termsTitle',
    leadKey: 'termsLead',
    items: [
      ['t1', 't1a'],
      ['t2', 't2a'],
      ['t3', 't3a'],
      ['t4', 't4a'],
      ['t5', 't5a'],
    ],
    showUpdated: true,
  },
}[page];

const titleFallback = {
  support: 'ALPHA 지원',
  privacy: '개인정보 처리방침',
  terms: '이용약관',
}[page];

const leadFallback = {
  support: '앱 사용 중 문제가 생겼다면 아래 내용을 확인하거나 문의해 주세요.',
  privacy: 'ALPHA는 개인정보를 수집하거나 외부 서버로 전송하지 않습니다.',
  terms: 'ALPHA를 내려받거나 사용하면 아래 조건에 동의한 것으로 봅니다.',
}[page];

const fallbacks: Record<string, string> = {
  faq1: '기록은 어디에 저장되나요?',
  faq1a: '루틴, 진행률, 하루 마감, 회고와 선택한 카드 이미지는 사용자의 기기에 저장됩니다.',
  faq2: '앱을 삭제하면 기록이 남나요?',
  faq2a: '앱을 삭제하면 기기에 저장된 앱 데이터도 삭제될 수 있습니다. ALPHA는 별도 계정이나 클라우드 백업을 제공하지 않습니다.',
  faq3: '카드 이미지는 서버로 전송되나요?',
  faq3a: '아니요. 사용자가 선택하고 편집한 이미지는 기기 안에서만 처리됩니다.',
  faq4: '알림이 오지 않아요.',
  faq4a: '기기 설정에서 ALPHA의 알림 권한이 켜져 있는지 확인해 주세요. 알림은 기기에서 로컬로 예약됩니다.',
  p1: '수집하는 데이터',
  p1a: 'ALPHA는 이름, 이메일, 위치, 연락처, 광고 식별자, 사용 분석 정보 또는 결제 정보를 수집하지 않습니다.',
  p2: '기기 내 데이터',
  p2a: '루틴, 기록, 회고, 설정과 사용자가 선택한 카드 이미지는 앱 기능 제공을 위해 기기에 저장됩니다. 개발자는 이 데이터에 접근할 수 없습니다.',
  p3: '사진 접근',
  p3a: '카드 이미지를 바꿀 때에만 사용자가 직접 선택한 사진에 접근합니다. 사진은 기기 안에서 편집되며 외부로 전송되지 않습니다.',
  p4: '알림',
  p4a: '사용자가 허용하면 하루 마감 알림을 기기에서 로컬로 예약합니다. 원격 푸시 서버나 사용자 추적에는 사용하지 않습니다.',
  p5: '결제',
  p5a: '앱 구매와 결제는 Apple App Store 또는 Google Play가 처리합니다. ALPHA 개발자는 결제 정보를 수집하지 않습니다.',
  p6: '백업과 삭제',
  p6a: '운영체제 설정에 따라 앱 데이터가 기기 백업에 포함될 수 있습니다. 루틴과 기록은 데이터 초기화로, 선택한 카드 이미지는 기본 이미지 복원으로 삭제할 수 있습니다. 모든 로컬 앱 데이터는 앱을 삭제해 제거합니다.',
  p7: '아동 개인정보',
  p7a: 'ALPHA는 누구의 개인정보도 의도적으로 수집하지 않습니다.',
  p8: '변경 및 문의',
  p8a: '방침이 변경되면 이 페이지의 시행일을 갱신합니다. 문의는 아래 이메일로 보내 주세요.',
  t1: '서비스',
  t1a: 'ALPHA는 자기관리와 기록을 돕는 도구이며 의료, 심리, 운동 처방을 제공하지 않습니다.',
  t2: '사용자 책임',
  t2a: '사용자는 자신의 건강 상태와 한계를 고려해 루틴을 선택하고 수행해야 합니다.',
  t3: '데이터',
  t3a: '데이터는 기기에 저장됩니다. 삭제, 기기 손상 또는 운영체제 문제로 인한 데이터 손실을 막기 위해 사용자가 기기를 관리해야 합니다.',
  t4: '지식재산권',
  t4a: '앱의 코드, 디자인, 문구와 기본 시각 자산에 대한 권리는 East Noise에 있습니다. 개인이 선택한 사진의 권리는 해당 사용자에게 있습니다.',
  t5: '변경',
  t5a: '법률 또는 서비스 변경에 따라 약관을 갱신할 수 있습니다.',
};
---

<div class="alpha-info" data-alpha-page data-page-title-key={pageCopy.titleKey}>
  <header class="info-nav">
    <a class="brand" href="/alpha">ALPHA</a>
    <select id="locale" aria-label="언어">
      <option value="ko">한국어</option>
      <option value="en">English</option>
      <option value="ja">日本語</option>
      <option value="es">Español</option>
      <option value="de">Deutsch</option>
      <option value="fr">Français</option>
      <option value="zh">简体中文</option>
    </select>
  </header>

  <main>
    <header class="info-hero">
      <p>{pageCopy.kicker}</p>
      <h1 data-copy={pageCopy.titleKey}>{titleFallback}</h1>
      <span data-copy={pageCopy.leadKey}>{leadFallback}</span>
      {pageCopy.showUpdated && <em data-copy="updated">2026년 8월 6일 시행</em>}
    </header>

    <div class="info-list">
      {pageCopy.items.map(([titleKey, bodyKey], index) => (
        <section>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h2 data-copy={titleKey}>{fallbacks[titleKey]}</h2>
            <p data-copy={bodyKey}>{fallbacks[bodyKey]}</p>
          </div>
        </section>
      ))}
    </div>

    <section class="contact">
      <p data-copy="contact">문의</p>
      {page === 'support' && (
        <span data-copy="contactLead">문의할 때 기기 모델, OS 버전, 앱 버전과 문제 상황을 함께 보내 주세요.</span>
      )}
      <a href="mailto:eastnoise26@gmail.com">eastnoise26@gmail.com</a>
    </section>
  </main>

  <footer>
    <span>© 2026 East Noise</span>
    <nav aria-label="ALPHA documents">
      <a href="/alpha/support" data-copy="support">지원</a>
      <a href="/legal/alpha/privacy" data-copy="privacy">개인정보 처리방침</a>
      <a href="/legal/alpha/terms" data-copy="terms">이용약관</a>
    </nav>
  </footer>
</div>

<script is:inline src="/alpha-site.js"></script>

<style>
  .alpha-info {
    --red: #ff1b1f;
    --ink: #080808;
    --paper: #f2f2f2;
    --muted: #8d8d8d;
    min-height: 100vh;
    background: var(--ink);
    color: var(--paper);
  }

  .info-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
    padding: 0 6.7vw;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .brand {
    font-size: 0.9rem;
    font-weight: 650;
  }

  select {
    min-width: 8rem;
    min-height: 44px;
    padding: 0 2.25rem 0 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 0;
    background: #080808;
    color: var(--paper);
  }

  .info-hero {
    min-height: 31rem;
    padding: 8rem 6.7vw 5rem;
    background: var(--red);
    color: #080808;
  }

  .info-hero > p,
  .info-hero > em {
    margin: 0;
    font-size: 0.75rem;
    font-style: normal;
    font-weight: 650;
    text-transform: uppercase;
  }

  .info-hero h1 {
    max-width: 64rem;
    margin: 3.5rem 0 2rem;
    font-size: clamp(3.2rem, 7vw, 6rem);
    font-weight: 620;
    line-height: 1.05;
  }

  .info-hero > span {
    display: block;
    max-width: 46rem;
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .info-hero > em {
    display: block;
    margin-top: 2rem;
    color: rgba(8, 8, 8, 0.6);
  }

  .info-list {
    padding: 7rem 6.7vw 8rem;
  }

  .info-list section {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 2rem;
    max-width: 68rem;
    padding: 0 0 3.5rem;
    margin-bottom: 3.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }

  .info-list section > span {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .info-list h2 {
    margin: 0 0 1.25rem;
    font-size: 1.8rem;
    font-weight: 580;
  }

  .info-list p {
    margin: 0;
    color: #b6b6b6;
    font-size: 0.98rem;
    line-height: 1.85;
  }

  .contact {
    display: grid;
    gap: 1.5rem;
    padding: 6rem 6.7vw;
    background: #141414;
  }

  .contact p,
  .contact span {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .contact a {
    width: fit-content;
    max-width: 100%;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid currentColor;
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 6rem;
    padding: 0 6.7vw;
    color: var(--muted);
    font-size: 0.75rem;
  }

  footer nav {
    display: flex;
    gap: 2rem;
  }

  footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  @media (max-width: 650px) {
    .info-nav {
      min-height: 64px;
      padding: 0 1.25rem;
    }

    .info-hero {
      min-height: 27rem;
      padding: 6rem 1.25rem 4rem;
    }

    .info-list {
      padding: 4.5rem 1.25rem 5rem;
    }

    .info-list section {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: 1rem;
      padding-bottom: 2.75rem;
      margin-bottom: 2.75rem;
    }

    .info-list h2 {
      font-size: 1.45rem;
    }

    .contact {
      padding: 4.5rem 1.25rem;
    }

    footer {
      display: grid;
      gap: 1rem;
      padding: 2rem 1.25rem;
    }

    footer nav {
      flex-wrap: wrap;
      gap: 0 1.2rem;
    }
  }
</style>
