---
import '../styles/global.css';
import { strings, type Locale } from '../i18n/strings';
import CursorBlob from '../components/CursorBlob.astro';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  path?: string;
}

const { locale, title, description, path = locale === 'ko' ? '/' : '/en/' } = Astro.props;
const t = strings[locale];
const otherLocale = locale === 'ko' ? 'en' : 'ko';
const otherUrl = otherLocale === 'ko' ? '/' : '/en/';
const pageTitle = title ?? `${t.siteTitle} — ${t.siteDescription}`;
const pageDesc = description ?? t.siteDescription;
---

<!doctype html>
<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`https://east-noise-web.vercel.app${path}`} />
  <meta property="og:image" content="https://east-noise-web.vercel.app/og.svg" />
  <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content="https://east-noise-web.vercel.app/og.svg" />
  <link rel="alternate" hreflang="ko" href={`https://east-noise-web.vercel.app${(path.replace(/^\/en/, '') || '/')}`} />
  <link rel="alternate" hreflang="en" href={`https://east-noise-web.vercel.app${path.startsWith('/en') ? path : '/en' + (path === '/' ? '/' : path)}`} />
  <link rel="alternate" hreflang="x-default" href={`https://east-noise-web.vercel.app${(path.replace(/^\/en/, '') || '/')}`} />
  <link rel="canonical" href={`https://east-noise-web.vercel.app${path}`} />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css" />
</head>
<body class="min-h-screen flex flex-col">
  <header class="px-6 py-3 flex items-center justify-between max-w-6xl mx-auto w-full">
    <a href={locale === 'ko' ? '/' : '/en/'} class="text-sm font-semibold tracking-tight inline-flex items-center min-h-[44px] py-2 -my-2">
      East Noise
    </a>
    <a href={otherUrl} class="text-xs font-medium text-[--color-muted] hover:text-[--color-fg] transition-colors uppercase tracking-wider inline-flex items-center justify-center min-h-[44px] min-w-[44px] py-2 px-3 -my-2 -mr-3">
      {t.nav.langSwitch}
    </a>
  </header>
  <main class="flex-1">
    <slot />
  </main>
  <CursorBlob />
  <footer class="border-t border-[--color-border] mt-24">
    <div class="max-w-6xl mx-auto w-full px-6 py-8 flex flex-col md:flex-row md:items-center md:justify-between gap-3 text-xs text-[--color-muted]">
      <div class="flex flex-col sm:flex-row sm:items-center sm:gap-3">
        <span>{t.contact.copyright}</span>
        <span class="hidden sm:inline opacity-40">·</span>
        <span class="tabular-nums">{t.contact.bizNo}</span>
      </div>
      <a href={`mailto:${t.contact.email}`} class="hover:text-[--color-fg] transition-colors">
        {t.contact.email}
      </a>
    </div>
  </footer>
</body>
</html>
