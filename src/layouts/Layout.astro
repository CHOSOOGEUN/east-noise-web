---
import '../styles/global.css';
import { strings, type Locale } from '../i18n/strings';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  path?: string;
  chrome?: 'default' | 'none';
  themeColor?: string;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  locale,
  title,
  description,
  path = locale === 'ko' ? '/' : '/en/',
  chrome = 'default',
  themeColor = '#ffffff',
  ogImage = '/og.svg',
  ogImageAlt,
} = Astro.props;
const t = strings[locale];
const homeUrl = locale === 'ko' ? '/' : '/en/';
const otherUrl = locale === 'ko'
  ? `/en${path === '/' ? '/' : path}`
  : (path.replace(/^\/en/, '') || '/');
const otherLabel = locale === 'ko' ? 'EN' : 'KO';
const pageTitle = title ?? `${t.siteTitle} — ${t.siteDescription}`;
const pageDesc = description ?? t.siteDescription;
const canonicalPath = path || '/';
const siteRoot = 'https://east-noise-web.vercel.app';
const ogImageUrl = new URL(ogImage, siteRoot).toString();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="theme-color" content={themeColor} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://east-noise-web.vercel.app${canonicalPath}`} />
    <meta property="og:image" content={ogImageUrl} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImageUrl} />
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <link rel="alternate" hreflang="ko" href={`https://east-noise-web.vercel.app${(canonicalPath.replace(/^\/en/, '') || '/')}`} />
    <link rel="alternate" hreflang="en" href={`https://east-noise-web.vercel.app${canonicalPath.startsWith('/en') ? canonicalPath : '/en' + (canonicalPath === '/' ? '/' : canonicalPath)}`} />
    <link rel="alternate" hreflang="x-default" href={`https://east-noise-web.vercel.app${(canonicalPath.replace(/^\/en/, '') || '/')}`} />
    <link rel="canonical" href={`https://east-noise-web.vercel.app${canonicalPath}`} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="stylesheet" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css" />
  </head>
  <body class:list={[{ 'chromeless-page': chrome === 'none', 'standard-page': chrome !== 'none' }]}>
    {chrome !== 'none' && (
      <header class="layout-nav" aria-label="East Noise">
        <a href={homeUrl} class="layout-brand">동방의 소음</a>
        <nav aria-label="Primary">
          <a href={`${homeUrl}#products`}>Products</a>
          <a href={`${homeUrl}#contact`}>Contact</a>
          <a href={otherUrl}>{otherLabel}</a>
        </nav>
      </header>
    )}

    <main>
      <slot />
    </main>

    {chrome !== 'none' && (
      <footer class="layout-footer" id="contact">
        <span>{t.contact.copyright}</span>
        <a href={`mailto:${t.contact.email}`}>{t.contact.email}</a>
        <span>{t.contact.bizNo}</span>
      </footer>
    )}
  </body>
</html>
